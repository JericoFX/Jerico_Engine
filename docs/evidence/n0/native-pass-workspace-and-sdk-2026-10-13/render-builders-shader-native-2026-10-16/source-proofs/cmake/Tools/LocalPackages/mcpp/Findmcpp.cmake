# Same INTERFACE target, import library and runtime registration as the O3DE recipe.

include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_MCPP_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_MCPP_LOCAL_ROOT)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local mcpp package requires Windows x64")
endif()
set(mcpp_INCLUDE_DIR "${JE_MCPP_LOCAL_ROOT}/mcpp/include")
set(mcpp_LIBS_DIR "${JE_MCPP_LOCAL_ROOT}/mcpp/lib")
set(mcpp_BINARY_DIR "${mcpp_LIBS_DIR}")
set(mcpp_LIBRARY "${mcpp_LIBS_DIR}/mcpp0.lib")
set(mcpp_RUNTIME_DEPENDENCIES "${mcpp_LIBS_DIR}/mcpp0.dll")
set(mcpp_EXECUTABLE "${mcpp_LIBS_DIR}/mcpp.exe")
set(mcpp_VERSION "2.7.2")
set(mcpp_VARIANT "2.7.2_az.2")
foreach(JE_VARIABLE IN ITEMS mcpp_INCLUDE_DIR mcpp_LIBRARY mcpp_RUNTIME_DEPENDENCIES mcpp_EXECUTABLE)
    JE_python_require_local_path(${JE_VARIABLE})
    if(NOT EXISTS "${${JE_VARIABLE}}")
        set(${JE_VARIABLE} "${JE_VARIABLE}-NOTFOUND")
    endif()
endforeach()
foreach(JE_HEADER IN ITEMS mcpp_lib.h mcpp_out.h)
    set(JE_HEADER_PATH "${JE_MCPP_LOCAL_ROOT}/mcpp/include/${JE_HEADER}")
    JE_python_require_local_path(JE_HEADER_PATH)
    if(NOT EXISTS "${JE_HEADER_PATH}")
        set(mcpp_INCLUDE_DIR mcpp_INCLUDE_DIR-NOTFOUND)
    endif()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(mcpp REQUIRED_VARS mcpp_INCLUDE_DIR mcpp_LIBRARY
    mcpp_RUNTIME_DEPENDENCIES mcpp_EXECUTABLE VERSION_VAR mcpp_VERSION)
if(NOT mcpp_FOUND)
    return()
endif()
set(mcpp_INCLUDE_DIRS "${mcpp_INCLUDE_DIR}")
set(mcpp_LIBRARIES "${mcpp_LIBRARY}")
if(TARGET 3rdParty::mcpp)
    get_target_property(JE_EXISTING_LIBRARY 3rdParty::mcpp INTERFACE_LINK_LIBRARIES)
    if(NOT JE_EXISTING_LIBRARY STREQUAL mcpp_LIBRARY)
        message(FATAL_ERROR "JE local mcpp refuses to replace an existing provider")
    endif()
    return()
endif()
add_library(3rdParty::mcpp INTERFACE IMPORTED GLOBAL)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::mcpp INTERFACE "${mcpp_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::mcpp SYSTEM INTERFACE "${mcpp_INCLUDE_DIR}")
endif()
target_link_libraries(3rdParty::mcpp INTERFACE "${mcpp_LIBRARY}")
if(COMMAND ly_add_target_files)
    ly_add_target_files(TARGETS 3rdParty::mcpp FILES "${mcpp_RUNTIME_DEPENDENCIES}")
endif()
