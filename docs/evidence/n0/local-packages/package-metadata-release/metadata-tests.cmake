cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED JE_TEST_OUTPUT OR EXISTS "${JE_TEST_OUTPUT}")
    message(FATAL_ERROR "Metadata tests require a fresh explicit output")
endif()
set(JE_TEST_HELPER "F:/JericoEngine/JericoEngine/cmake/Tools/LocalPackages/JECreateLocalPackage.cmake")
set(JE_TEST_STAGE "${JE_TEST_OUTPUT}/stage")
file(MAKE_DIRECTORY "${JE_TEST_STAGE}")
file(WRITE "${JE_TEST_STAGE}/payload.txt" "JE metadata test witness\n")
set(JE_ARGS "-DJE_PACKAGE_STAGE:PATH=${JE_TEST_STAGE}" "-DJE_PACKAGE_NAME:STRING=JEMetadataWitness"
    "-DJE_PACKAGE_VERSION:STRING=2.7.2" "-DJE_PACKAGE_LICENSE:STRING=BSD-2-Clause"
    "-DJE_PACKAGE_SOURCE_URL:STRING=https://sourceforge.net/projects/mcpp/files/mcpp/V.2.7.2/mcpp-2.7.2.tar.gz/download"
    "-DJE_PACKAGE_SOURCE_SHA256:STRING=3b9b4421888519876c4fc68ade324a3bbd81ceeb7092ecdbbc2055099fcb8864")
foreach(JE_CASE IN ITEMS release commit both neither invalid-release invalid-commit invalid-hash)
    set(JE_CASE_ARGS ${JE_ARGS} "-DJE_PACKAGE_OUTPUT:PATH=${JE_TEST_OUTPUT}/${JE_CASE}")
    set(JE_EXPECTED "")
    if(JE_CASE STREQUAL "release")
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_RELEASE:STRING=mcpp-2.7.2")
    elseif(JE_CASE STREQUAL "commit")
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_COMMIT:STRING=ce8be74060cf231c11d464edb0862234dea7782d")
    elseif(JE_CASE STREQUAL "both")
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_RELEASE:STRING=mcpp-2.7.2" "-DJE_PACKAGE_SOURCE_COMMIT:STRING=ce8be74060cf231c11d464edb0862234dea7782d")
        set(JE_EXPECTED "provide exactly one source commit or release")
    elseif(JE_CASE STREQUAL "neither")
        set(JE_EXPECTED "source commit or release is required")
    elseif(JE_CASE STREQUAL "invalid-release")
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_RELEASE:STRING=mcpp/2.7.2")
        set(JE_EXPECTED "invalid source release identifier")
    elseif(JE_CASE STREQUAL "invalid-commit")
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_COMMIT:STRING=ce8be740")
        set(JE_EXPECTED "source commit must be an explicit full hash")
    else()
        list(APPEND JE_CASE_ARGS "-DJE_PACKAGE_SOURCE_RELEASE:STRING=mcpp-2.7.2" "-DJE_PACKAGE_SOURCE_SHA256:STRING=3b9b44")
        set(JE_EXPECTED "source archive SHA256 must be an explicit full hash")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" ${JE_CASE_ARGS} -P "${JE_TEST_HELPER}"
        RESULT_VARIABLE JE_EXIT OUTPUT_VARIABLE JE_OUT ERROR_VARIABLE JE_ERR)
    file(WRITE "${JE_TEST_OUTPUT}/${JE_CASE}.log" "exit=${JE_EXIT}\n${JE_OUT}\n${JE_ERR}")
    if(JE_EXPECTED STREQUAL "")
        if(NOT JE_EXIT EQUAL 0)
            message(FATAL_ERROR "Metadata ${JE_CASE} failed; see retained log")
        endif()
        file(READ "${JE_TEST_OUTPUT}/${JE_CASE}/JEMetadataWitness.contents/PackageInfo.json" JE_JSON)
        string(JSON JE_SCHEMA GET "${JE_JSON}" schemaVersion)
        string(JSON JE_SHA GET "${JE_JSON}" source sha256)
        if(NOT JE_SHA STREQUAL "3b9b4421888519876c4fc68ade324a3bbd81ceeb7092ecdbbc2055099fcb8864")
            message(FATAL_ERROR "Metadata archive identity changed")
        endif()
        if(JE_CASE STREQUAL "release")
            string(JSON JE_REF GET "${JE_JSON}" source release)
            string(JSON JE_ABSENT ERROR_VARIABLE JE_REF_ERROR GET "${JE_JSON}" source commit)
            if(NOT JE_SCHEMA EQUAL 2 OR NOT JE_REF STREQUAL "mcpp-2.7.2" OR JE_REF_ERROR STREQUAL "NOTFOUND")
                message(FATAL_ERROR "Release metadata contains an invented commit")
            endif()
        else()
            string(JSON JE_REF GET "${JE_JSON}" source commit)
            string(JSON JE_ABSENT ERROR_VARIABLE JE_REF_ERROR GET "${JE_JSON}" source release)
            if(NOT JE_SCHEMA EQUAL 1 OR NOT JE_REF STREQUAL "ce8be74060cf231c11d464edb0862234dea7782d" OR JE_REF_ERROR STREQUAL "NOTFOUND")
                message(FATAL_ERROR "Existing commit metadata format changed")
            endif()
        endif()
    elseif(JE_EXIT EQUAL 0 OR NOT "${JE_OUT}\n${JE_ERR}" MATCHES "${JE_EXPECTED}" OR EXISTS "${JE_TEST_OUTPUT}/${JE_CASE}")
        message(FATAL_ERROR "Metadata ${JE_CASE} failed its exact diagnostic/no-output guard")
    endif()
    message(STATUS "Metadata ${JE_CASE}: PASS")
endforeach()
