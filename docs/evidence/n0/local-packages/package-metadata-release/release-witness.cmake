cmake_minimum_required(VERSION 3.24)
if(NOT DEFINED JE_TEST_OUTPUT OR EXISTS "${JE_TEST_OUTPUT}")
    message(FATAL_ERROR "Metadata witness requires a fresh explicit output")
endif()
set(JE_PACKAGE_STAGE "${JE_TEST_OUTPUT}/stage")
file(MAKE_DIRECTORY "${JE_PACKAGE_STAGE}")
file(WRITE "${JE_PACKAGE_STAGE}/payload.txt" "JE metadata release witness\n")
set(JE_PACKAGE_NAME "JEReleaseMetadataWitness")
set(JE_PACKAGE_OUTPUT "${JE_TEST_OUTPUT}/packages")
set(JE_PACKAGE_VERSION "2.7.2")
set(JE_PACKAGE_LICENSE "BSD-2-Clause")
set(JE_PACKAGE_SOURCE_RELEASE "mcpp-2.7.2")
set(JE_PACKAGE_SOURCE_SHA256 "3b9b4421888519876c4fc68ade324a3bbd81ceeb7092ecdbbc2055099fcb8864")
set(JE_PACKAGE_SOURCE_URL "https://sourceforge.net/projects/mcpp/files/mcpp/V.2.7.2/mcpp-2.7.2.tar.gz/download")
unset(JE_PACKAGE_SOURCE_COMMIT)
include("F:/JericoEngine/JericoEngine/cmake/Tools/LocalPackages/JECreateLocalPackage.cmake")
file(READ "${JE_PACKAGE_OUTPUT}/${JE_PACKAGE_NAME}.contents/PackageInfo.json" JE_JSON)
string(JSON JE_RELEASE GET "${JE_JSON}" source release)
string(JSON JE_SCHEMA GET "${JE_JSON}" schemaVersion)
string(JSON JE_COMMIT ERROR_VARIABLE JE_COMMIT_ERROR GET "${JE_JSON}" source commit)
if(NOT JE_RELEASE STREQUAL JE_PACKAGE_SOURCE_RELEASE OR NOT JE_SCHEMA EQUAL 2 OR JE_COMMIT_ERROR STREQUAL "NOTFOUND")
    message(FATAL_ERROR "Expected honest release provenance without an upstream Git commit")
endif()
message(STATUS "Release identity recorded without an invented Git commit")
