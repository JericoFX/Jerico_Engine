+        Csg::SurfaceKey EncodeSurfaceId(const AZ::Uuid& id)
+        {
+            uint64_t words[2]{};
+            for (size_t word = 0; word < 2; ++word)
+            {
+                for (size_t byte = 0; byte < 8; ++byte)
+                {
+                    words[word] = (words[word] << 8) | static_cast<uint64_t>(id.begin()[word * 8 + byte]);
+                }
+            }
+            return {words[0], words[1]};
+        }
