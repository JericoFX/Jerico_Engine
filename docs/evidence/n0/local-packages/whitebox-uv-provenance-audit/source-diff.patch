+        AZ::Uuid LegacySurfaceId(const AZ::Uuid& contentSeed, uint64_t ordinal)
+        {
+            // Explicit bytes keep the derivation independent of host integer endianness.
+            AZStd::array<AZStd::byte, 32> data{};
+            constexpr char domain[] = "JEWBv1";
+            for (size_t i = 0; i < sizeof(domain) - 1; ++i)
