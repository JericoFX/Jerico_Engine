+        // Preflight the two identity chunks: OMReader warns/skips a bad custom block
+        // without failing the read. Geometry and polygon decoding remain OpenMesh's.
+        bool ValidateSurfaceChunks(const std::string& bytes, const char* highName, const char* lowName)
+        {
+            namespace IO = OpenMesh::IO;
+            namespace Format = OpenMesh::IO::OMFormat;
+            using Chunk = Format::Chunk;
+            std::stringstream input(bytes);
+            input >> std::noskipws;
+            const bool swap = OpenMesh::Endian::local() == OpenMesh::Endian::MSB;
+            const auto available = [&]() -> size_t
+            {
+                const auto position = input.tellg();
+                return position < 0 ? 0 : bytes.size() - static_cast<size_t>(position);
+            };
+            const auto skip = [&](size_t count)
+            {
+                if (count > available()) { return false; }
+                input.seekg(static_cast<std::streamoff>(count), std::ios_base::cur);
+                return input.good();
+            };
+            const auto readName = [&](Chunk::PropertyName& name)
+            {
+                if (available() == 0) { return false; }
+                const auto length = static_cast<size_t>(static_cast<unsigned char>(input.peek()));
+                if (length + 1 > available()) { return false; }
+                return IO::restore(input, name, swap) == length + 1 && input.good() && name.size() == length;
+            };
+            Format::Header header{};
+            if (available() < Format::header_size() || !IO::restore(input, header, swap) || !input.good() ||
+                header.magic_[0] != 'O' || header.magic_[1] != 'M' ||
+                (header.mesh_ != 'T' && header.mesh_ != 'Q' && header.mesh_ != 'P') ||
+                header.version_ > Format::mk_version(2, 2)) { return false; }
+            bool highSeen = false;
+            bool lowSeen = false;
+            while (available() != 0)
+            {
+                Chunk::Header chunk{};
+                if (available() < Format::chunk_header_size() || !IO::restore(input, chunk, swap) || !input.good()) { return false; }
+                if (chunk.entity_ == Chunk::Entity_Sentinel) { return !chunk.name_ && available() == 0 && highSeen == lowSeen; }
+                uint64_t count = 0;
+                switch (chunk.entity_)
+                {
+                case Chunk::Entity_Vertex: count = header.n_vertices_; break;
+                case Chunk::Entity_Face: count = header.n_faces_; break;
+                case Chunk::Entity_Edge: count = header.n_edges_; break;
+                case Chunk::Entity_Halfedge: count = static_cast<uint64_t>(header.n_edges_) * 2; break;
+                case Chunk::Entity_Mesh: count = 1; break;
+                default: return false;
+                }
+                Chunk::PropertyName name;
+                if (chunk.name_ && !readName(name)) { return false; }
+                const bool isHigh = name == highName;
+                const bool isLow = name == lowName;
+                if ((isHigh || isLow) && (chunk.entity_ != Chunk::Entity_Face || chunk.type_ != Chunk::Type_Custom)) { return false; }
+                if (chunk.type_ == Chunk::Type_Custom)
+                {
+                    Chunk::PropertyName type;
+                    if (header.version_ > Format::mk_version(2, 1) && !readName(type)) { return false; }
+                    Chunk::esize_t blockSize = 0;
+                    if (available() < IO::size_of<Chunk::esize_t>() || !IO::restore(input, blockSize, swap) || !input.good()) { return false; }
+                    if (isHigh || isLow)
+                    {
+                        bool& seen = isHigh ? highSeen : lowSeen;
+                        if (seen || type != IO::binary<uint64_t>::type_identifier() ||
+                            static_cast<uint64_t>(blockSize) != static_cast<uint64_t>(header.n_faces_) * IO::size_of<uint64_t>()) { return false; }
+                        seen = true;
+                    }
+                    if (!skip(blockSize)) { return false; }
+                    continue;
+                }
+                // OMFormat::scalar_size has integer/float widths reversed in OpenMesh 11.
+                // Use the original enum meanings and IO sizes, matching OMReader/OMWriter.
+                size_t scalarSize = 0;
+                if (chunk.float_)
+                {
+                    switch (chunk.bits_)
+                    {
+                    case Chunk::Float_32: scalarSize = IO::size_of<float>(); break;
+                    case Chunk::Float_64: scalarSize = IO::size_of<double>(); break;
+                    default: return false; // OMReader position/normal paths do not support Float_128.
+                    }
+                }
+                else
+                {
+                    switch (chunk.bits_)
+                    {
+                    case Chunk::Integer_8: scalarSize = IO::size_of<uint8_t>(); break;
+                    case Chunk::Integer_16: scalarSize = IO::size_of<uint16_t>(); break;
+                    case Chunk::Integer_32: scalarSize = IO::size_of<uint32_t>(); break;
+                    case Chunk::Integer_64: scalarSize = IO::size_of<uint64_t>(); break;
+                    }
+                }
+                if (scalarSize == 0) { return false; }
+                if (chunk.entity_ == Chunk::Entity_Face && chunk.type_ == Chunk::Type_Topology && header.version_ < Format::mk_version(2, 0))
+                {
+                    // Match OMReader's old indexed-face topology, including variable polygons.
+                    for (uint64_t face = 0; face < count; ++face)
+                    {
+                        size_t vertices = header.mesh_ == 'T' ? 3 : 4;
+                        if (header.mesh_ == 'P' && (available() < IO::size_of<uint16_t>() ||
+                            !IO::restore(input, vertices, Chunk::Integer_16, swap) || !input.good())) { return false; }
+                        if (vertices > available() / scalarSize || !skip(vertices * scalarSize)) { return false; }
+                    }
+                    continue;
+                }
+                const size_t vectorSize = Format::dimensions(chunk) * scalarSize;
+                if (count > available() / vectorSize || !skip(static_cast<size_t>(count) * vectorSize)) { return false; }
+            }
+            // Preserve upstream complete-chunk EOF behavior for older .om versions.
+            return header.version_ <= Format::mk_version(2, 1) && highSeen == lowSeen;
+        }
+    }
