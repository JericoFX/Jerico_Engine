+    bool EditorWhiteBoxComponent::HasManualUVs() const
+    {
+        if (m_manualUVs) { return true; }
+        // A mesh-only import has no scene guard flag, but its authored corner UVs must still be protected.
+        const auto* mesh = m_editorMeshAsset ? const_cast<EditorWhiteBoxComponent*>(this)->GetWhiteBoxMesh() : m_whiteBox.get();
+        if (!mesh) { return false; }
+        for (const auto face : Api::MeshFaceHandles(*mesh))
+        {
+            const auto normal = Api::FaceNormal(*mesh, face);
+            for (const auto corner : Api::FaceHalfedgeHandles(*mesh, face))
+            {
+                const auto position = Api::VertexPosition(*mesh, Api::HalfedgeVertexHandleAtTip(*mesh, corner));
+                if (Api::HalfedgeUV(*mesh, corner) != CreatePlanarUVFromVertex(normal, position)) { return true; }
+            }
+        }
+        return false;
+    }
+
+    bool EditorWhiteBoxComponent::AssignPolygonMaterialSlots(const Api::PolygonHandles& polygons, uint32_t slot)
+    {
+        auto* mesh = GetWhiteBoxMesh();
+        auto candidate = m_surfaceMaterialBindings;
+        if (!mesh || !JE::BSP::AssignPolygonMaterial(*mesh, polygons, slot, candidate)) { return false; }
+        AzToolsFramework::ScopedUndoBatch undo("Assign White Box Face Material");
+        m_surfaceMaterialBindings = AZStd::move(candidate);
+        RecordWhiteBoxAction(*mesh, {GetEntityId(), GetId()}, "Assign White Box Face Material", UVCommitMode::Preserve);
+        return true;
+    }
+
+    bool EditorWhiteBoxComponent::ApplyPolygonUVTransform(const Api::PolygonHandles& polygons, const AZ::Vector2& scale,
+        const AZ::Vector2& offset, float rotationDegrees)
+    {
+        auto* mesh = GetWhiteBoxMesh();
+        if (!mesh) { return false; }
+        auto candidate = Api::CloneMesh(*mesh);
+        if (!candidate || !JE::BSP::TransformPolygonUVs(*candidate, polygons, scale, offset, rotationDegrees)) { return false; }
+        AzToolsFramework::ScopedUndoBatch undo("Edit White Box Face UVs");
+        Api::ReplaceMesh(*mesh, AZStd::move(candidate));
+        m_manualUVs = true;
+        RecordWhiteBoxAction(*mesh, {GetEntityId(), GetId()}, "Edit White Box Face UVs", UVCommitMode::Preserve);
+        return true;
+    }
+
+    void EditorWhiteBoxComponent::AssignSelectedMaterialSlot()
+    {
+        Api::PolygonHandles polygons;
+        EditorWhiteBoxDefaultModeRequestBus::EventResult(polygons, AZ::EntityComponentIdPair(GetEntityId(), GetId()),
+            &EditorWhiteBoxDefaultModeRequests::SelectedPolygonHandles);
+        if (!AssignPolygonMaterialSlots(polygons, m_selectedMaterialSlot))
+        {
+            QMessageBox::warning(AzToolsFramework::GetActiveWindow(), "White Box Faces", "Select a polygon in Default component mode and choose a valid material slot.");
+        }
+    }
+
+    void EditorWhiteBoxComponent::ApplySelectedUVTransform()
+    {
+        Api::PolygonHandles polygons;
+        EditorWhiteBoxDefaultModeRequestBus::EventResult(polygons, AZ::EntityComponentIdPair(GetEntityId(), GetId()),
+            &EditorWhiteBoxDefaultModeRequests::SelectedPolygonHandles);
+        if (!ApplyPolygonUVTransform(polygons, m_uvScale, m_uvOffset, m_uvRotation))
+        {
+            QMessageBox::warning(AzToolsFramework::GetActiveWindow(), "White Box UVs", "Select a polygon in Default component mode and enter finite UV values.");
+        }
+    }
+
+    void EditorWhiteBoxComponent::ResetPlanarUVs()
+    {
+        auto* mesh = GetWhiteBoxMesh();
+        if (!mesh) { return; }
+        AzToolsFramework::ScopedUndoBatch undo("Reset White Box UVs to Planar");
+        m_manualUVs = false;
+        RecordWhiteBoxAction(*mesh, {GetEntityId(), GetId()}, "Reset White Box UVs to Planar", UVCommitMode::Reproject);
+    }
