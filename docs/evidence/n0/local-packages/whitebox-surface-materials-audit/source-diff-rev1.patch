+#include <AtomLyIntegration/CommonFeatures/Material/MaterialAssignment.h>
+
+namespace JE::BSP
+{
+    struct SurfaceMaterialMerge
+    {
+        SurfaceMaterialBindings m_bindings;
+        AZ::Render::MaterialAssignmentMap m_materials;
+    };
+
+    //! Validate/merge scene associations before CSG. Failure leaves every output unchanged.
+    //! Native MaterialComponent remains the owner of the returned references and overrides.
+    bool MergeSurfaceMaterials(
+        const WhiteBox::WhiteBoxMesh& target, const SurfaceMaterialBindings& targetBindings,
+        const AZ::Render::MaterialAssignmentMap& targetMaterials, const WhiteBox::WhiteBoxMaterial& targetLegacy,
+        const WhiteBox::WhiteBoxMesh& source, const SurfaceMaterialBindings& sourceBindings,
+        const AZ::Render::MaterialAssignmentMap& sourceMaterials, const WhiteBox::WhiteBoxMaterial& sourceLegacy,
+        bool targetHasMaterialOwner, SurfaceMaterialMerge& output, AZStd::string& error);
+
+    bool MaterialAssignmentsEquivalent(const AZ::Render::MaterialAssignmentMap& lhs,
+        const AZ::Render::MaterialAssignmentMap& rhs);
+
+    //! Bind the complete inherited surface, not a truncated identifier or triangulation face index.
+    bool AssignPolygonMaterial(const WhiteBox::WhiteBoxMesh& mesh, const WhiteBox::Api::PolygonHandles& polygons,
+        uint32_t slot, SurfaceMaterialBindings& bindings);
+    //! Apply one validated affine transform to selected corners, preserving all other UVs and keys.
+    bool TransformPolygonUVs(WhiteBox::WhiteBoxMesh& mesh, const WhiteBox::Api::PolygonHandles& polygons,
+        const AZ::Vector2& scale, const AZ::Vector2& offset, float rotationDegrees);
+}
