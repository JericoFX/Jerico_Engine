com/web-flow","followers_url":"https://api.github.com/users/web-flow/followers","following_url":"https://api.github.com/users/web-flow/following{/other_user}","gists_url":"https://api.github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"694932d2779c8d927e2678ba7c158c37d7055dfb","url":"https://api.github.com/repos/o3de/3p-package-source/commits/694932d2779c8d927e2678ba7c158c37d7055dfb","html_url":"https://github.com/o3de/3p-package-source/commit/694932d2779c8d927e2678ba7c158c37d7055dfb"}]},{"sha":"9bb9a108b606b1157df1541ac733fbba01a3a621","node_id":"C_kwDOFbd6J9oAKDliYjlhMTA4YjYwNmIxMTU3ZGYxNTQxYWM3MzNmYmJhMDFhM2E2MjE","commit":{"author":{"name":"Steve Pham","email":"82231385+spham-amzn@users.noreply.github.com","date":"2026-01-27T16:54:06Z"},"committer":{"name":"GitHub","email":"noreply@github.com","date":"2026-01-27T16:54:06Z"},"message":"Mac ARM64 3P support: Add definitions for astc-encoder, ISPCTexComp, mcpp, OpenSSL, and squish-ccr. (#336)\n\n* Add definition for mcpp-2.7.2_az.2-rev1-mac-arm64\n  * Updated get_and_build_mcpp.py to support mac-arm64\n  * Added `mcpp-2.7.2_az.2-rev1-mac-arm64` into package_build_list_host_darwin-arm64.json`\n\n* Add definition for OpenSSL-1.1.1w-rev1-mac-arm64\n  * Replaced vcpackage flow for Mac in favor of build_and_pull_from_git.py\n  * Added section for Darwin/Mac and Darwin/Mac-arm64 to package-system/OpenSSL/build_config.json\n  * Created build-mac.sh for OpenSSL on Mac\n  * Added `OpenSSL-1.1.1w-rev1-mac-arm64` into package_build_list_host_darwin-arm64.json`\n\n* Add definition for squish-ccr-deb557d-rev1-mac-arm64\n  * Created build-mac-arm64.sh script to build on mac-arm64 platform, including the required sse2neon header from github\n  * Added section for Darwin/Mac-arm64 to package-system/squish-ccr/build_config.json to call the new script\n  * Added `squish-ccr-deb557d-rev1-mac-arm64` into package_build_list_host_darwin-arm64.json`\n\n* Add definition for astc-encoder-3.2-rev5-mac-arm64\n  * Created build_mac_arm64.sh script to build on mac-arm64 platform and configured it to use NEON instead of SSE\n  * Created install_mac_arm64.sh script for the mac-arm64 platform\n  * Updated patch to fix unused warning as error issue\n  * Added section for Darwin/Mac-arm64 to package-system/astc-encoder/build_config.json to call the new scripts\n  * Added `astc-encoder-3.2-rev5-mac-arm64` into package_build_list_host_darwin-arm64.json`\n\n* Add definition for ISPCTexComp-36b80aa-rev1-mac-arm64\n  * Added mac-arm64 specific patch for ISPCTexComp to explicitly set the arch to aarch64 and target tp neon-i32x4\n  * Updated ISPCTexComp/build_package_image.py to detect and support mac-arm64\n  * Added `ISPCTexComp-36b80aa-rev1-mac-arm64` into package_build_list_host_darwin-arm64.json`\n\nSigned-off-by: Steve Pham <82231385+spham-amzn@users.noreply.github.com>","tree":{"sha":"768e73028afb34df8f2108ca1b936104bace51f4","url":"https://api.github.com/repos/o3de/3p-package-source/git/trees/768e73028afb34df8f2108ca1b936104bace51f4"},"url":"https://api.github.com/repos/o3de/3p-package-source/git/commits/9bb9a108b606b1157df1541ac733fbba01a3a621","comment_count":0,"verification":{"verified":true,"reason":"valid","signature":"-----BEGIN PGP SIGNATURE-----\n\nwsFcBAABCAAQBQJpeO2uCRC1aQ7uu5UhlAAAXdUQAI9+YCnd790vxu+uNQBjZxYz\nXKiISnAD8yOWLUAYBIpQL2oCjhtuZYKBGEHZx7ggEy7UUy/dK9nm+c5c0FYaTfP5\n5ooggEneSmiomTCXVn0slz+LeUwEYa+JFEA3p8GH/SEpTkgKdXNRkfKNGJjK9mCu\nhFoLQzupxbCQKlbWqnBJykhuJEB4uZGZa/iaqA6NC6WFOIjx7nREHy6ZtVuTzDbZ\nehEEWYS7Yo