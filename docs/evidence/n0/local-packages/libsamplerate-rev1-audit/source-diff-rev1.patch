+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(libsamplerate REQUIRED_VARS LIBSAMPLERATE_INCLUDE_DIR LIBSAMPLERATE_LIBRARY
+    VERSION_VAR LIBSAMPLERATE_VERSION)
+if(libsamplerate_FOUND AND NOT TARGET 3rdParty::libsamplerate)
+    add_library(3rdParty::libsamplerate INTERFACE IMPORTED GLOBAL)
