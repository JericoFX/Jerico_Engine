math(EXPR _last "${CMAKE_ARGC} - 1")
set(_args)
set(_i 3)
while(_i LESS_EQUAL _last)
  list(APPEND _args "${CMAKE_ARGV${_i}}")
  math(EXPR _i "${_i} + 1")
endwhile()
string(JOIN "|" _line ${_args})
file(APPEND "$ENV{JE_FAKE_GIT_LOG}" "${_line}\n")
if("${_line}" MATCHES "^describe\\|")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "v3.2.1" RESULT_VARIABLE _echo_result)
  if(NOT _echo_result EQUAL 0)
    message(FATAL_ERROR "fake echo failed: ${_echo_result}")
  endif()
endif()
