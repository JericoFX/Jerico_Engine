diff --git a/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/ApplyPrivateProvenance.cmake b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/ApplyPrivateProvenance.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/ApplyPrivateProvenance.cmake
@@ -0,0 +1,74 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+cmake_minimum_required(VERSION 3.24)
+include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
+foreach(JE_PATH IN ITEMS JE_WORK_dxc JE_WORK_spirv-tools JE_DXC_PROOF_OUTPUT)
+    JE_python_require_local_path(${JE_PATH})
+endforeach()
+get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
+set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
+foreach(JE_PATH IN ITEMS JE_WORK_dxc JE_WORK_spirv-tools JE_DXC_PROOF_OUTPUT)
+    cmake_path(IS_PREFIX JE_BUILD_ROOT "${${JE_PATH}}" NORMALIZE JE_PRIVATE)
+    if(NOT JE_PRIVATE OR "${${JE_PATH}}" STREQUAL JE_BUILD_ROOT)
+        message(FATAL_ERROR "JE DXC provenance requires private checkout/build paths")
+    endif()
+endforeach()
+if(EXISTS "${JE_DXC_PROOF_OUTPUT}")
+    message(FATAL_ERROR "JE DXC private proof exists")
+endif()
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json"
+    "4a8716eb03a11408bb65cb3a15550193be6685eb0d7e8ee140f4e3aa50943266" "approved three private overlays")
+file(READ "${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" JE_SPEC)
+string(JSON JE_COUNT LENGTH "${JE_SPEC}" overlays)
+if(NOT JE_COUNT EQUAL 3)
+    message(FATAL_ERROR "JE DXC requires exactly three approved overlays")
+endif()
+file(MAKE_DIRECTORY "${JE_DXC_PROOF_OUTPUT}")
+foreach(JE_INDEX RANGE 0 2)
+    foreach(JE_FIELD IN ITEMS id source path beforeSHA256 afterSHA256)
+        string(JSON JE_${JE_FIELD} GET "${JE_SPEC}" overlays ${JE_INDEX} ${JE_FIELD})
+    endforeach()
+    set(JE_FILE "${JE_WORK_${JE_source}}/${JE_path}")
+    JE_python_verify_file("${JE_FILE}" "${JE_beforeSHA256}" "${JE_id} pristine private source")
+    configure_file("${JE_FILE}" "${JE_DXC_PROOF_OUTPUT}/${JE_id}.before" COPYONLY)
+    file(READ "${JE_FILE}" JE_ORIGINAL)
+    set(JE_CHANGED "${JE_ORIGINAL}")
+    string(JSON JE_HUNKS LENGTH "${JE_SPEC}" overlays ${JE_INDEX} replacements)
+    math(EXPR JE_LAST "${JE_HUNKS}-1")
+    foreach(JE_HUNK RANGE 0 ${JE_LAST})
+        string(JSON JE_BEFORE GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} before)
+        string(JSON JE_AFTER GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} after)
+        string(FIND "${JE_CHANGED}" "${JE_BEFORE}" JE_FIRST)
+        if(JE_FIRST LESS 0)
+            message(FATAL_ERROR "JE DXC private overlay context missing")
+        endif()
+        string(LENGTH "${JE_BEFORE}" JE_LENGTH)
+        math(EXPR JE_REST_START "${JE_FIRST}+${JE_LENGTH}")
+        string(SUBSTRING "${JE_CHANGED}" ${JE_REST_START} -1 JE_REST)
+        string(FIND "${JE_REST}" "${JE_BEFORE}" JE_SECOND)
+        if(NOT JE_SECOND LESS 0)
+            message(FATAL_ERROR "JE DXC overlay context not unique")
+        endif()
+        string(REPLACE "${JE_BEFORE}" "${JE_AFTER}" JE_CHANGED "${JE_CHANGED}")
+    endforeach()
+    set(JE_INVERSE "${JE_CHANGED}")
+    foreach(JE_HUNK RANGE ${JE_LAST} 0 -1)
+        string(JSON JE_BEFORE GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} before)
+        string(JSON JE_AFTER GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} after)
+        if(JE_AFTER STREQUAL "" AND JE_BEFORE STREQUAL "import subprocess\n")
+            # Exact deletion in the pinned GetCommitInfo.py; restore its original import position.
+            string(REPLACE "import os\n" "import os\n${JE_BEFORE}" JE_INVERSE "${JE_INVERSE}")
+        else()
+            string(REPLACE "${JE_AFTER}" "${JE_BEFORE}" JE_INVERSE "${JE_INVERSE}")
+        endif()
+    endforeach()
+    if(NOT JE_INVERSE STREQUAL JE_ORIGINAL)
+        message(FATAL_ERROR "JE DXC private overlay inverse differs")
+    endif()
+    file(CONFIGURE OUTPUT "${JE_DXC_PROOF_OUTPUT}/${JE_id}.inverse" CONTENT "${JE_INVERSE}" @ONLY NEWLINE_STYLE UNIX)
+    JE_python_verify_file("${JE_DXC_PROOF_OUTPUT}/${JE_id}.inverse" "${JE_beforeSHA256}" "${JE_id} byteexact inverse")
+    file(CONFIGURE OUTPUT "${JE_FILE}" CONTENT "${JE_CHANGED}" @ONLY NEWLINE_STYLE UNIX)
+    JE_python_verify_file("${JE_FILE}" "${JE_afterSHA256}" "${JE_id} raw patched SHA")
+    configure_file("${JE_FILE}" "${JE_DXC_PROOF_OUTPUT}/${JE_id}.after" COPYONLY)
+endforeach()
+configure_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" "${JE_DXC_PROOF_OUTPUT}/overlays.json" COPYONLY)
diff --git a/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/BuildDirectXShaderCompilerDxcPackage.cmake b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/BuildDirectXShaderCompilerDxcPackage.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/BuildDirectXShaderCompilerDxcPackage.cmake
@@ -0,0 +1,136 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+cmake_minimum_required(VERSION 3.24)
+include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
+foreach(JE_ARGUMENT IN ITEMS ARCHIVES_ROOT PYTHON PYTHON_SHA256 NINJA NINJA_SHA256 CL CL_SHA256 OUTPUT)
+    if(NOT DEFINED JE_DXC_${JE_ARGUMENT} OR "${JE_DXC_${JE_ARGUMENT}}" STREQUAL "")
+        message(FATAL_ERROR "JE DXC: JE_DXC_${JE_ARGUMENT} is required")
+    endif()
+endforeach()
+foreach(JE_PATH IN ITEMS JE_DXC_ARCHIVES_ROOT JE_DXC_PYTHON JE_DXC_NINJA JE_DXC_CL JE_DXC_OUTPUT)
+    JE_python_require_local_path(${JE_PATH})
+endforeach()
+get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
+set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
+cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_DXC_OUTPUT}" NORMALIZE JE_LOCAL_OUTPUT)
+if(NOT JE_LOCAL_OUTPUT OR JE_DXC_OUTPUT STREQUAL JE_BUILD_ROOT)
+    message(FATAL_ERROR "JE DXC output must be below checkout/build")
+endif()
+if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" OR NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "x64")
+    message(FATAL_ERROR "JE DXC requires the existing VS2022/v143 x64 development environment; no toolchain installation")
+endif()
+if(EXISTS "${JE_DXC_OUTPUT}")
+    message(FATAL_ERROR "JE DXC output exists; previous attempts are retained")
+endif()
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/SourcePins.json"
+    "a6a4be45d6d99baf555e13ef0661600c47585ad4089f1584e49d69dc36815cdc" "approved exact source pins")
+file(READ "${CMAKE_CURRENT_LIST_DIR}/SourcePins.json" JE_PINS)
+string(JSON JE_COUNT LENGTH "${JE_PINS}" sources)
+if(NOT JE_COUNT EQUAL 3)
+    message(FATAL_ERROR "JE DXC selected Windows closure requires exactly three sources")
+endif()
+foreach(JE_INDEX RANGE 0 2)
+    foreach(JE_FIELD IN ITEMS id url sha256 archiveRelativePath archiveRoot cmakeSHA256)
+        string(JSON JE_${JE_FIELD} GET "${JE_PINS}" sources ${JE_INDEX} ${JE_FIELD})
+    endforeach()
+    if(NOT JE_url MATCHES "^https://codeload[.]github[.]com/(o3de/DirectXShaderCompiler|KhronosGroup/SPIRV-Headers|KhronosGroup/SPIRV-Tools)/tar[.]gz/[0-9a-f]+$")
+        message(FATAL_ERROR "JE DXC source provenance URL differs from approved primary endpoints")
+    endif()
+    set(JE_ARCHIVE_${JE_id} "${JE_DXC_ARCHIVES_ROOT}/${JE_archiveRelativePath}")
+    JE_python_verify_file("${JE_ARCHIVE_${JE_id}}" "${JE_sha256}" "${JE_id} exact local archive")
+    set(JE_ARCHIVE_ROOT_${JE_id} "${JE_archiveRoot}")
+    set(JE_CMAKE_SHA_${JE_id} "${JE_cmakeSHA256}")
+endforeach()
+foreach(JE_TOOL IN ITEMS PYTHON NINJA CL)
+    JE_python_verify_file("${JE_DXC_${JE_TOOL}}" "${JE_DXC_${JE_TOOL}_SHA256}" "audited existing external ${JE_TOOL}")
+endforeach()
+string(JSON JE_NOTICE_SHA GET "${JE_PINS}" sourceNoticeSHA256)
+string(JSON JE_OVERLAY_SHA GET "${JE_PINS}" privateProvenanceSHA256)
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/SourceNotices.txt" "${JE_NOTICE_SHA}" "full source notices")
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" "${JE_OVERLAY_SHA}" "three private overlays")
+# Immutable tool trees stay untouched; Python is an external generation tool only.
+set(ENV{PYTHONDONTWRITEBYTECODE} "1")
+file(MAKE_DIRECTORY "${JE_DXC_OUTPUT}/logs" "${JE_DXC_OUTPUT}/source-work")
+function(JE_dxc_native JE_LABEL)
+    set(JE_ARGS "[]")
+    set(JE_INDEX 0)
+    foreach(JE_ARGUMENT IN LISTS ARGN)
+        string(REPLACE "\\" "\\\\" JE_ESCAPED "${JE_ARGUMENT}")
+        string(REPLACE "\"" "\\\"" JE_ESCAPED "${JE_ESCAPED}")
+        string(JSON JE_ARGS SET "${JE_ARGS}" ${JE_INDEX} "\"${JE_ESCAPED}\"")
+        math(EXPR JE_INDEX "${JE_INDEX}+1")
+    endforeach()
+    file(WRITE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.argv.json" "${JE_ARGS}\n")
+    string(TIMESTAMP JE_START "%s" UTC)
+    execute_process(COMMAND ${ARGN} RESULT_VARIABLE JE_RESULT
+        OUTPUT_FILE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.stdout.txt"
+        ERROR_FILE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.stderr.txt")
+    string(TIMESTAMP JE_END "%s" UTC)
+    math(EXPR JE_SECONDS "${JE_END}-${JE_START}")
+    file(WRITE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.result.json"
+        "{\"exitResult\":\"${JE_RESULT}\",\"elapsedWholeSeconds\":${JE_SECONDS}}\n")
+    if(NOT JE_RESULT STREQUAL "0")
+        message(FATAL_ERROR "JE DXC ${JE_LABEL} failed (${JE_RESULT}); outputs retained; no package ready")
+    endif()
+endfunction()
+JE_dxc_native(python-generation-version "${JE_DXC_PYTHON}" -I -c
+    "print(__import__('sys').version) or __import__('sys').exit(0 if __import__('sys').version_info[:3] == (3, 10, 13) else 1)")
+foreach(JE_ID IN ITEMS dxc spirv-headers spirv-tools)
+    # Archives were fully tar/Gitblob audited before provisioning; no source VCS is needed.
+    file(ARCHIVE_EXTRACT INPUT "${JE_ARCHIVE_${JE_ID}}" DESTINATION "${JE_DXC_OUTPUT}/source-work/${JE_ID}")
+    set(JE_WORK_${JE_ID} "${JE_DXC_OUTPUT}/source-work/${JE_ID}/${JE_ARCHIVE_ROOT_${JE_ID}}")
+    JE_python_verify_file("${JE_WORK_${JE_ID}}/CMakeLists.txt" "${JE_CMAKE_SHA_${JE_ID}}" "${JE_ID} pristine private CMake")
+endforeach()
+set(JE_DXC_PROOF_OUTPUT "${JE_DXC_OUTPUT}/private-provenance-proof")
+include("${CMAKE_CURRENT_LIST_DIR}/ApplyPrivateProvenance.cmake")
+set(JE_BINARY "${JE_DXC_OUTPUT}/build-Release")
+JE_dxc_native(configure-Release "${CMAKE_COMMAND}" -S "${JE_WORK_dxc}" -B "${JE_BINARY}" -G Ninja
+    "-C${JE_WORK_dxc}/cmake/caches/PredefinedParams.cmake"
+    "-DCMAKE_MAKE_PROGRAM=${JE_DXC_NINJA}" "-DCMAKE_C_COMPILER=${JE_DXC_CL}" "-DCMAKE_CXX_COMPILER=${JE_DXC_CL}"
+    -DCMAKE_BUILD_TYPE=Release -DLLVM_INCLUDE_TESTS:BOOL=OFF -DCLANG_INCLUDE_TESTS:BOOL=OFF
+    -DHLSL_INCLUDE_TESTS:BOOL=OFF -DSPIRV_BUILD_TESTS:BOOL=OFF -DLLVM_INCLUDE_TOOLS=ON
+    "-DPython3_EXECUTABLE=${JE_DXC_PYTHON}" "-DDXC_SPIRV_HEADERS_DIR=${JE_WORK_spirv-headers}"
+    "-DDXC_SPIRV_TOOLS_DIR=${JE_WORK_spirv-tools}" -DHLSL_ENABLE_FIXED_VER=ON -DHLSL_FIXED_VERSION_LOCATION:PATH=
+    -DHLSL_AUTOCRLF=OFF -DSPIRV_TOOLS_BUILD_STATIC=ON -DFETCHCONTENT_FULLY_DISCONNECTED=ON)
+# Record optional ambient discoveries; never obtain a new library or suppress an existing feature.
+file(STRINGS "${JE_BINARY}/CMakeCache.txt" JE_OPTIONAL_FIND_LINES
+    REGEX "^(DIASDK|MSVC_DIA_SDK_DIR|LIBXML2|LLVM_ENABLE_ZLIB|HAVE_ZLIB_H|HAVE_LIBZ|METAL_IRCONVERTER|ENABLE_METAL_CODEGEN|Python3|LLVM_USE_CRT_RELEASE|HLSL_|ENABLE_SPIRV_CODEGEN|CMAKE_CXX_COMPILER|CMAKE_C_COMPILER)[^=]*=")
+string(REPLACE ";" "\n" JE_OPTIONAL_FIND_TEXT "${JE_OPTIONAL_FIND_LINES}")
+file(WRITE "${JE_DXC_OUTPUT}/logs/selected-cache-finds.txt" "${JE_OPTIONAL_FIND_TEXT}\n")
+JE_dxc_native(build-Release "${CMAKE_COMMAND}" --build "${JE_BINARY}" --target all llvm-as llvm-dis --parallel)
+foreach(JE_FILE IN ITEMS dxc.exe dxsc.exe dxil.dll dxcompiler.dll)
+    if(NOT EXISTS "${JE_BINARY}/bin/${JE_FILE}")
+        message(FATAL_ERROR "JE DXC required original output missing: ${JE_FILE}")
+    endif()
+endforeach()
+# No stage/package is produced until the original real native target set succeeds.
+set(JE_STAGE "${JE_DXC_OUTPUT}/stage")
+file(MAKE_DIRECTORY "${JE_STAGE}/DirectXShaderCompilerDxc/bin" "${JE_STAGE}/LICENSES/O3DE")
+foreach(JE_FILE IN ITEMS dxc.exe dxsc.exe dxil.dll dxcompiler.dll)
+    file(COPY "${JE_BINARY}/bin/${JE_FILE}" DESTINATION "${JE_STAGE}/DirectXShaderCompilerDxc/bin")
+endforeach()
+file(COPY "${CMAKE_CURRENT_LIST_DIR}/FindDirectXShaderCompilerDxc.cmake" "${CMAKE_CURRENT_LIST_DIR}/NOTICE.txt"
+    "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION "${JE_STAGE}")
+configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
+file(COPY "${CMAKE_CURRENT_LIST_DIR}/SourceNotices.txt" DESTINATION "${JE_STAGE}/LICENSES")
+file(COPY "${JE_ENGINE_ROOT}/LICENSE.txt" "${JE_ENGINE_ROOT}/LICENSE_APACHE2.TXT" "${JE_ENGINE_ROOT}/LICENSE_MIT.TXT"
+    DESTINATION "${JE_STAGE}/LICENSES/O3DE")
+string(JSON JE_RECIPE SET "${JE_PINS}" sourceNumericVersion "\"1.8.2505.0\"")
+string(JSON JE_RECIPE SET "${JE_RECIPE}" sourceShortHash "\"1cc0ab76\"")
+string(JSON JE_RECIPE SET "${JE_RECIPE}" historyCount 4954)
+string(JSON JE_RECIPE SET "${JE_RECIPE}" historyCountMethod "\"Pinned GitHub REST unfiltered history cardinality; not local git rev-list\"")
+string(JSON JE_RECIPE SET "${JE_RECIPE}" externalPythonToolSHA256 "\"${JE_DXC_PYTHON_SHA256}\"")
+string(JSON JE_RECIPE SET "${JE_RECIPE}" pythonDistributed false)
+string(JSON JE_RECIPE SET "${JE_RECIPE}" generator "\"Ninja\"")
+string(JSON JE_RECIPE SET "${JE_RECIPE}" toolset "\"v143\"")
+file(WRITE "${JE_STAGE}/DirectXShaderCompilerDxc/JERecipe.json" "${JE_RECIPE}\n")
+set(JE_PACKAGE_STAGE "${JE_STAGE}")
+set(JE_PACKAGE_NAME "DirectXShaderCompilerDxc-1.8.2505.1-o3de-je-rev1-windows")
+set(JE_PACKAGE_OUTPUT "${JE_DXC_OUTPUT}/packages")
+set(JE_PACKAGE_VERSION "1.8.2505.1")
+set(JE_PACKAGE_SOURCE_COMMIT "1cc0ab76dafe08a4144e419e619a8951a3d219db")
+set(JE_PACKAGE_SOURCE_SHA256 "1b36fde66ebad5806563373cb722b3c57e8b1d580880e898b3b9d6a5e4529e42")
+set(JE_PACKAGE_SOURCE_URL "https://codeload.github.com/o3de/DirectXShaderCompiler/tar.gz/${JE_PACKAGE_SOURCE_COMMIT}")
+set(JE_PACKAGE_LICENSE "NCSA; Apache-2.0; Khronos permissive; scoped MIT/Unlicense, regex, Unicode/MD5 notices in LICENSES")
+include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
+file(WRITE "${JE_DXC_OUTPUT}/package-ready.json" "{\"status\":\"PRODUCED; NATIVE CONSUMER/ROOT/EDITOR ACCEPTANCE PENDING\"}\n")
diff --git a/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/FindDirectXShaderCompilerDxc.cmake b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/FindDirectXShaderCompilerDxc.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/FindDirectXShaderCompilerDxc.cmake
@@ -0,0 +1,27 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+if(TARGET 3rdParty::DirectXShaderCompilerDxc)
+    return()
+endif()
+include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
+set(DirectXShaderCompilerDxc_BINARY_DIR "${CMAKE_CURRENT_LIST_DIR}/DirectXShaderCompilerDxc/bin")
+JE_python_require_local_path(DirectXShaderCompilerDxc_BINARY_DIR)
+file(READ "${CMAKE_CURRENT_LIST_DIR}/PackageInfo.json" JE_PACKAGE_INFO)
+string(JSON DirectXShaderCompilerDxc_VERSION GET "${JE_PACKAGE_INFO}" version)
+set(DirectXShaderCompilerDxc_RUNTIME_DEPENDENCIES)
+foreach(JE_FILE IN ITEMS dxc.exe dxsc.exe dxil.dll dxcompiler.dll)
+    set(JE_PATH "${DirectXShaderCompilerDxc_BINARY_DIR}/${JE_FILE}")
+    JE_python_require_local_path(JE_PATH)
+    if(NOT EXISTS "${JE_PATH}" OR IS_DIRECTORY "${JE_PATH}")
+        message(FATAL_ERROR "JE DXC local package is incomplete: ${JE_PATH}")
+    endif()
+    list(APPEND DirectXShaderCompilerDxc_RUNTIME_DEPENDENCIES "${JE_PATH}")
+endforeach()
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(DirectXShaderCompilerDxc REQUIRED_VARS
+    DirectXShaderCompilerDxc_BINARY_DIR VERSION_VAR DirectXShaderCompilerDxc_VERSION)
+add_library(3rdParty::DirectXShaderCompilerDxc INTERFACE IMPORTED GLOBAL)
+if(COMMAND ly_add_target_files)
+    ly_add_target_files(TARGETS 3rdParty::DirectXShaderCompilerDxc
+        OUTPUT_SUBDIRECTORY Builders/DirectXShaderCompiler FILES ${DirectXShaderCompilerDxc_RUNTIME_DEPENDENCIES})
+endif()
diff --git a/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/NOTICE.txt b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/NOTICE.txt
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/NOTICE.txt
@@ -0,0 +1,41 @@
+Copyright (c) Contributors to the Open 3D Engine Project.
+JE package glue: Apache-2.0 OR MIT; full texts in LICENSES/O3DE.
+
+This is a newly built local package, not the historical binary package and
+not a Microsoft-signed binary release. Its real archive SHA must be measured.
+The original O3DE Windows recipe distributes four Release tools:
+DirectXShaderCompilerDxc/bin/dxc.exe, dxsc.exe, dxil.dll, dxcompiler.dll.
+The engine target/deploy path remain 3rdParty::DirectXShaderCompilerDxc and
+Builders/DirectXShaderCompiler. dxsc is the original DX12 specialization
+patcher and remains present. No Python interpreter is distributed.
+
+DXC source authority: o3de/DirectXShaderCompiler branch
+release-1.8.2505.1-o3de, pinned commit
+1cc0ab76dafe08a4144e419e619a8951a3d219db, not an invented upstream tag.
+The source numeric version is1.8.2505.0; package branch identity .1 does not
+alter those original numeric fields. Full source pin is in ProductVersion.
+Original IDxcVersionInfo2 allocations require the short8 hash1cc0ab76.
+Count4954 is the reviewed unfiltered pinned GitHub REST history cardinality,
+not a local git rev-list measurement. API queries and ownership remain intact.
+
+The three documented private overlays affect only version.inc,
+GetCommitInfo.py, and SPIRV-Tools update_build_version.py. Original immutable
+archives/snapshots remain unchanged. All before/after SHA256 and exact byte
+inverses are recorded. Source generators, feature defaults, EH/RTTI,
+SPIR-V code generation and original Windows tests-off recipe are preserved.
+SPIRV-Headers aa6cef192b8e693916eb713e7a9ccadf06062ceb and SPIRV-Tools
+a62abcb402009b9ca5975e6167c09f237f630e0e are the exact selected gitlinks.
+
+Full source licensing/notices are retained in LICENSES/SourceNotices.txt:
+NCSA and ThirdPartyNotices; Apache-2.0 SPIRV-Tools; Khronos SPIRV-Headers;
+LLVM regex COPYRIGHT; actual DxilCompression LICENSE.TXT and source notices
+for miniz, ConvertUTF and MD5. Source build/test Autoconf notices in the full
+authority license are scoped historical text, not an attribution of every
+distributed DLL to GPL or a certification of complete redistribution rights.
+
+The pinned 2025 source includes the open retail DXIL validator hash algorithm.
+DXIL hashing is distinct from Windows DLL Authenticode signing. Source-built
+dxil.dll still ships as the original recipe requires. No validation bypass,
+developer-mode enablement or external signed-validator replacement is used.
+Native compilation, shader validation and real DX12/Vulkan product behavior
+are separate acceptance gates; this notice does not claim those gates passed.
diff --git a/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/PrivateProvenance.json b/cmake/Tools/LocalPackages/DirectXShaderCompilerDxc/PrivateProvenance.json
