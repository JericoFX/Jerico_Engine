+{
+  "schemaVersion": 1,
+  "overlays": [
+    {
+      "id": "commit-info",
+      "source": "dxc",
+      "path": "utils/GetCommitInfo.py",
+      "replacements": [
+        {
+          "after": "",
+          "before": "import subprocess\n"
+        },
+        {
+          "after": "def git_get_commit_hash():\n    # Audited archive1cc0ab76; original runtime allocations require8 characters.\n    return \"1cc0ab76\"\n\n\ndef git_get_commit_count():\n    # Pinned GitHub REST unfiltered history cardinality; not local git rev-list.\n    return 4954",
