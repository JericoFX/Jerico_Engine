JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" "${JE_OVERLAY_SHA}" "three private overlays")
# Immutable tool trees stay untouched; Python is an external generation tool only.
set(ENV{PYTHONDONTWRITEBYTECODE} "1")
file(MAKE_DIRECTORY "${JE_DXC_OUTPUT}/logs" "${JE_DXC_OUTPUT}/source-work")
function(JE_dxc_native JE_LABEL)
    set(JE_ARGS "[]")
    set(JE_INDEX 0)
    foreach(JE_ARGUMENT IN LISTS ARGN)
        string(REPLACE "\\" "\\\\" JE_ESCAPED "${JE_ARGUMENT}")
        string(REPLACE "\"" "\\\"" JE_ESCAPED "${JE_ESCAPED}")
        string(JSON JE_ARGS SET "${JE_ARGS}" ${JE_INDEX} "\"${JE_ESCAPED}\"")
        math(EXPR JE_INDEX "${JE_INDEX}+1")
    endforeach()
    file(WRITE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.argv.json" "${JE_ARGS}\n")
    string(TIMESTAMP JE_START "%s" UTC)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE JE_RESULT
        OUTPUT_FILE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.stdout.txt"
        ERROR_FILE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.stderr.txt")
    string(TIMESTAMP JE_END "%s" UTC)
    math(EXPR JE_SECONDS "${JE_END}-${JE_START}")
    file(WRITE "${JE_DXC_OUTPUT}/logs/${JE_LABEL}.result.json"
        "{\"exitResult\":\"${JE_RESULT}\",\"elapsedWholeSeconds\":${JE_SECONDS}}\n")
    if(NOT JE_RESULT STREQUAL "0")
        message(FATAL_ERROR "JE DXC ${JE_LABEL} failed (${JE_RESULT}); outputs retained; no package ready")
    endif()
endfunction()
JE_dxc_native(python-generation-version "${JE_DXC_PYTHON}" -I -c
    "print(__import__('sys').version) or __import__('sys').exit(0 if __import__('sys').version_info[:3] == (3, 10, 13) else 1)")
