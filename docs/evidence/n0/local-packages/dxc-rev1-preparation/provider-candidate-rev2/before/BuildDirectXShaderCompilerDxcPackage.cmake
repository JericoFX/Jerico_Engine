    file(ARCHIVE_EXTRACT INPUT "${JE_ARCHIVE_${JE_ID}}" DESTINATION "${JE_DXC_OUTPUT}/source-work/${JE_ID}")
    set(JE_WORK_${JE_ID} "${JE_DXC_OUTPUT}/source-work/${JE_ID}/${JE_ARCHIVE_ROOT_${JE_ID}}")
    JE_python_verify_file("${JE_WORK_${JE_ID}}/CMakeLists.txt" "${JE_CMAKE_SHA_${JE_ID}}" "${JE_ID} pristine private CMake")
endforeach()
