string(JSON JE_COUNT LENGTH "${JE_PINS}" sources)
if(NOT JE_COUNT EQUAL 3)
    message(FATAL_ERROR "JE DXC selected Windows closure requires exactly three sources")
endif()
foreach(JE_INDEX RANGE 0 2)
    foreach(JE_FIELD IN ITEMS id url sha256 archiveRelativePath archiveRoot cmakeSHA256)
        string(JSON JE_${JE_FIELD} GET "${JE_PINS}" sources ${JE_INDEX} ${JE_FIELD})
    endforeach()
    if(NOT JE_url MATCHES "^https://codeload[.]github[.]com/(o3de/DirectXShaderCompiler|KhronosGroup/SPIRV-Headers|KhronosGroup/SPIRV-Tools)/tar[.]gz/[0-9a-f]+$")
        message(FATAL_ERROR "JE DXC source provenance URL differs from approved primary endpoints")
    endif()
    set(JE_ARCHIVE_${JE_id} "${JE_DXC_ARCHIVES_ROOT}/${JE_archiveRelativePath}")
    JE_python_verify_file("${JE_ARCHIVE_${JE_id}}" "${JE_sha256}" "${JE_id} exact local archive")
    set(JE_ARCHIVE_ROOT_${JE_id} "${JE_archiveRoot}")
    set(JE_CMAKE_SHA_${JE_id} "${JE_cmakeSHA256}")
endforeach()
