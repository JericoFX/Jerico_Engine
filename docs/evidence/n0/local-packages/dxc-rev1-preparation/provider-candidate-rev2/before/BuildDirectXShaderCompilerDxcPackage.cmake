    "-DCMAKE_MAKE_PROGRAM=${JE_DXC_NINJA}" "-DCMAKE_C_COMPILER=${JE_DXC_CL}" "-DCMAKE_CXX_COMPILER=${JE_DXC_CL}"
    -DCMAKE_BUILD_TYPE=Release -DLLVM_INCLUDE_TESTS:BOOL=OFF -DCLANG_INCLUDE_TESTS:BOOL=OFF
