    "-DDXC_SPIRV_TOOLS_DIR=${JE_WORK_spirv-tools}" -DHLSL_ENABLE_FIXED_VER=ON -DHLSL_FIXED_VERSION_LOCATION:PATH=
    -DHLSL_AUTOCRLF=OFF -DSPIRV_TOOLS_BUILD_STATIC=ON -DFETCHCONTENT_FULLY_DISCONNECTED=ON)
