if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows" OR NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "x64")
    message(FATAL_ERROR "JE DXC requires the existing VS2022/v143 x64 development environment; no toolchain installation")
