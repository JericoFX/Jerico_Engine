cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
foreach(JE_PATH IN ITEMS JE_WORK_dxc JE_WORK_spirv-tools JE_DXC_PROOF_OUTPUT)
    JE_python_require_local_path(${JE_PATH})
endforeach()
get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
foreach(JE_PATH IN ITEMS JE_WORK_dxc JE_WORK_spirv-tools JE_DXC_PROOF_OUTPUT)
    cmake_path(IS_PREFIX JE_BUILD_ROOT "${${JE_PATH}}" NORMALIZE JE_PRIVATE)
    if(NOT JE_PRIVATE OR "${${JE_PATH}}" STREQUAL JE_BUILD_ROOT)
        message(FATAL_ERROR "JE DXC provenance requires private checkout/build paths")
    endif()
endforeach()
if(EXISTS "${JE_DXC_PROOF_OUTPUT}")
    message(FATAL_ERROR "JE DXC private proof exists")
endif()
JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json"
    "4a8716eb03a11408bb65cb3a15550193be6685eb0d7e8ee140f4e3aa50943266" "approved three private overlays")
file(READ "${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" JE_SPEC)
string(JSON JE_COUNT LENGTH "${JE_SPEC}" overlays)
if(NOT JE_COUNT EQUAL 3)
    message(FATAL_ERROR "JE DXC requires exactly three approved overlays")
endif()
file(MAKE_DIRECTORY "${JE_DXC_PROOF_OUTPUT}")
foreach(JE_INDEX RANGE 0 2)
    foreach(JE_FIELD IN ITEMS id source path beforeSHA256 afterSHA256)
        string(JSON JE_${JE_FIELD} GET "${JE_SPEC}" overlays ${JE_INDEX} ${JE_FIELD})
    endforeach()
    set(JE_FILE "${JE_WORK_${JE_source}}/${JE_path}")
    JE_python_verify_file("${JE_FILE}" "${JE_beforeSHA256}" "${JE_id} pristine private source")
    configure_file("${JE_FILE}" "${JE_DXC_PROOF_OUTPUT}/${JE_id}.before" COPYONLY)
    file(READ "${JE_FILE}" JE_ORIGINAL)
    set(JE_CHANGED "${JE_ORIGINAL}")
    string(JSON JE_HUNKS LENGTH "${JE_SPEC}" overlays ${JE_INDEX} replacements)
    math(EXPR JE_LAST "${JE_HUNKS}-1")
    foreach(JE_HUNK RANGE 0 ${JE_LAST})
        string(JSON JE_BEFORE GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} before)
        string(JSON JE_AFTER GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} after)
        string(FIND "${JE_CHANGED}" "${JE_BEFORE}" JE_FIRST)
        if(JE_FIRST LESS 0)
            message(FATAL_ERROR "JE DXC private overlay context missing")
        endif()
        string(LENGTH "${JE_BEFORE}" JE_LENGTH)
        math(EXPR JE_REST_START "${JE_FIRST}+${JE_LENGTH}")
        string(SUBSTRING "${JE_CHANGED}" ${JE_REST_START} -1 JE_REST)
        string(FIND "${JE_REST}" "${JE_BEFORE}" JE_SECOND)
        if(NOT JE_SECOND LESS 0)
            message(FATAL_ERROR "JE DXC overlay context not unique")
        endif()
        string(REPLACE "${JE_BEFORE}" "${JE_AFTER}" JE_CHANGED "${JE_CHANGED}")
    endforeach()
    set(JE_INVERSE "${JE_CHANGED}")
    foreach(JE_HUNK RANGE ${JE_LAST} 0 -1)
        string(JSON JE_BEFORE GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} before)
        string(JSON JE_AFTER GET "${JE_SPEC}" overlays ${JE_INDEX} replacements ${JE_HUNK} after)
        if(JE_AFTER STREQUAL "" AND JE_BEFORE STREQUAL "import subprocess\n")
            # Exact deletion in the pinned GetCommitInfo.py; restore its original import position.
            string(REPLACE "import os\n" "import os\n${JE_BEFORE}" JE_INVERSE "${JE_INVERSE}")
        else()
            string(REPLACE "${JE_AFTER}" "${JE_BEFORE}" JE_INVERSE "${JE_INVERSE}")
        endif()
    endforeach()
    if(NOT JE_INVERSE STREQUAL JE_ORIGINAL)
        message(FATAL_ERROR "JE DXC private overlay inverse differs")
    endif()
    file(CONFIGURE OUTPUT "${JE_DXC_PROOF_OUTPUT}/${JE_id}.inverse" CONTENT "${JE_INVERSE}" @ONLY NEWLINE_STYLE UNIX)
    JE_python_verify_file("${JE_DXC_PROOF_OUTPUT}/${JE_id}.inverse" "${JE_beforeSHA256}" "${JE_id} byteexact inverse")
    file(CONFIGURE OUTPUT "${JE_FILE}" CONTENT "${JE_CHANGED}" @ONLY NEWLINE_STYLE UNIX)
    JE_python_verify_file("${JE_FILE}" "${JE_afterSHA256}" "${JE_id} raw patched SHA")
    configure_file("${JE_FILE}" "${JE_DXC_PROOF_OUTPUT}/${JE_id}.after" COPYONLY)
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/PrivateProvenance.json" "${JE_DXC_PROOF_OUTPUT}/overlays.json" COPYONLY)
