r linux instead of a static library.\n\nThe other platforms uses the build_config.json common cmake generate arguments which set BUILD_SHARED_LIBS=OFF and they were correctly built as a static library.\n\nSigned-off-by: lumberyard-employee-dm <56135373+lumberyard-employee-dm@users.noreply.github.com>","tree":{"sha":"99b12a4bfeb8e1fc4ed6a6df19258c0c6a35a966","url":"https://api.github.com/repos/o3de/3p-package-source/git/trees/99b12a4bfeb8e1fc4ed6a6df19258c0c6a35a966"},"url":"https://api.github.com/repos/o3de/3p-package-source/git/commits/1521b948040c3088c90ae1dd8a1f1da35385db23","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/o3de/3p-package-source/commits/1521b948040c3088c90ae1dd8a1f1da35385db23","html_url":"https://github.com/o3de/3p-package-source/commit/1521b948040c3088c90ae1dd8a1f1da35385db23","comments_url":"https://api.github.com/repos/o3de/3p-package-source/commits/1521b948040c3088c90ae1dd8a1f1da35385db23/comments","author":{"login":"lemonade-dm","id":56135373,"node_id":"MDQ6VXNlcjU2MTM1Mzcz","avatar_url":"https://avatars.githubusercontent.com/u/56135373?v=4","gravatar_id":"","url":"https://api.github.com/users/lemonade-dm","html_url":"https://github.com/lemonade-dm","followers_url":"https://api.github.com/users/lemonade-dm/followers","following_url":"https://api.github.com/users/lemonade-dm/following{/other_user}","gists_url":"https://api.github.com/users/lemonade-dm/gists{/gist_id}","starred_url":"https://api.github.com/users/lemonade-dm/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/lemonade-dm/subscriptions","organizations_url":"https://api.github.com/users/lemonade-dm/orgs","repos_url":"https://api.github.com/users/lemonade-dm/repos","events_url":"https://api.github.com/users/lemonade-dm/events{/privacy}","received_events_url":"https://api.github.com/users/lemonade-dm/received_events","type":"User","user_view_type":"p