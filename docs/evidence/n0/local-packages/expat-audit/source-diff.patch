+file(MAKE_DIRECTORY "${JE_STAGE}/expat/include" "${JE_STAGE}/expat/lib" "${JE_STAGE}/LICENSES/Expat")
+file(COPY "${JE_WORK}/lib/expat.h" "${JE_WORK}/lib/expat_external.h" "${JE_BUILD}/upstream/expat_config.h"
