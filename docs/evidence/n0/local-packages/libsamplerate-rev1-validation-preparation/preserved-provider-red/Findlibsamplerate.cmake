include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_SAMPLERATE_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_SAMPLERATE_PACKAGE_ROOT)
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE libsamplerate package requires Windows x64")
endif()
set(LIBSAMPLERATE_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}/libsamplerate/include")
set(LIBSAMPLERATE_LIBS_DIR "${CMAKE_CURRENT_LIST_DIR}/libsamplerate/lib")
set(LIBSAMPLERATE_LIBRARY "${LIBSAMPLERATE_LIBS_DIR}/samplerate.lib")
set(LIBSAMPLERATE_VERSION "0.2.1")
set(LIBSAMPLERATE_COMPILE_DEFINITIONS "")
set(LIBSAMPLERATE_LINK_OPTIONS "")
if(NOT EXISTS "${LIBSAMPLERATE_INCLUDE_DIR}/samplerate.h" OR NOT EXISTS "${LIBSAMPLERATE_LIBRARY}")
    message(FATAL_ERROR "JE libsamplerate package: required header/static library is missing")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(libsamplerate REQUIRED_VARS LIBSAMPLERATE_INCLUDE_DIR LIBSAMPLERATE_LIBRARY
    VERSION_VAR LIBSAMPLERATE_VERSION)
if(libsamplerate_FOUND AND NOT TARGET 3rdParty::libsamplerate)
    add_library(3rdParty::libsamplerate INTERFACE IMPORTED GLOBAL)
    if(COMMAND ly_target_include_system_directories)
        ly_target_include_system_directories(TARGET 3rdParty::libsamplerate INTERFACE "${LIBSAMPLERATE_INCLUDE_DIR}")
    else()
        target_include_directories(3rdParty::libsamplerate SYSTEM INTERFACE "${LIBSAMPLERATE_INCLUDE_DIR}")
    endif()
    target_link_libraries(3rdParty::libsamplerate INTERFACE "${LIBSAMPLERATE_LIBRARY}")
endif()
set(LIBSAMPLERATE_FOUND "${libsamplerate_FOUND}")
