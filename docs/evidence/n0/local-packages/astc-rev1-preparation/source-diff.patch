diff --git a/cmake/Tools/LocalPackages/ASTCEncoder/ApplyASTCPatch.cmake b/cmake/Tools/LocalPackages/ASTCEncoder/ApplyASTCPatch.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/ASTCEncoder/ApplyASTCPatch.cmake
@@ -0,0 +1,60 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
+JE_python_require_local_path(JE_ASTC_WORK)
+get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
+set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
+cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_ASTC_WORK}" NORMALIZE JE_WORK_IN_BUILD)
+if(NOT JE_WORK_IN_BUILD OR JE_ASTC_WORK STREQUAL JE_BUILD_ROOT)
+    message(FATAL_ERROR "JE ASTC patch: private work must be beneath this checkout/build")
+endif()
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/astc-encoder-3.2-rev1.patch" "88e0389289a28db8d937842d890a7ec4953d2295c263997236b05be4b3b5bd00" "original ASTC recipe patch")
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json" "1d45acd2e7674fdb62afd8187c5ff7d41c72590cd359f84ce518cad5e3ab2dca" "ASTC patch manifest")
+file(READ "${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json" JE_PATCH)
+# Validate all original bytes, contexts, post-hashes and inverses before either write.
+foreach(JE_INDEX RANGE 0 1)
+    string(JSON JE_PATH GET "${JE_PATCH}" files ${JE_INDEX} path)
+    if(NOT JE_PATH STREQUAL "Source/CMakeLists.txt" AND NOT JE_PATH STREQUAL "Source/cmake_core.cmake")
+        message(FATAL_ERROR "JE ASTC patch: unexpected source path")
+    endif()
+    string(JSON JE_BEFORE_SHA GET "${JE_PATCH}" files ${JE_INDEX} beforeSHA)
+    string(JSON JE_AFTER_SHA GET "${JE_PATCH}" files ${JE_INDEX} afterSHA)
+    JE_python_verify_file("${JE_ASTC_WORK}/${JE_PATH}" "${JE_BEFORE_SHA}" "ASTC pristine patch input")
+    file(READ "${JE_ASTC_WORK}/${JE_PATH}" JE_BEFORE)
+    set(JE_AFTER "${JE_BEFORE}")
+    string(JSON JE_COUNT LENGTH "${JE_PATCH}" files ${JE_INDEX} hunks)
+    math(EXPR JE_LAST "${JE_COUNT} - 1")
+    foreach(JE_HUNK RANGE 0 ${JE_LAST})
+        string(JSON JE_OLD GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} before)
+        string(JSON JE_NEW GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} after)
+        string(FIND "${JE_AFTER}" "${JE_OLD}" JE_POSITION)
+        if(JE_POSITION LESS 0)
+            message(FATAL_ERROR "JE ASTC patch: exact hunk context missing")
+        endif()
+        math(EXPR JE_NEXT "${JE_POSITION} + 1")
+        string(SUBSTRING "${JE_AFTER}" ${JE_NEXT} -1 JE_REMAINDER)
+        string(FIND "${JE_REMAINDER}" "${JE_OLD}" JE_DUPLICATE)
+        if(NOT JE_DUPLICATE EQUAL -1)
+            message(FATAL_ERROR "JE ASTC patch: hunk context is not unique")
+        endif()
+        string(REPLACE "${JE_OLD}" "${JE_NEW}" JE_AFTER "${JE_AFTER}")
+    endforeach()
+    set(JE_INVERSE "${JE_AFTER}")
+    foreach(JE_HUNK RANGE ${JE_LAST} 0 -1)
+        string(JSON JE_OLD GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} before)
+        string(JSON JE_NEW GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} after)
+        string(REPLACE "${JE_NEW}" "${JE_OLD}" JE_INVERSE "${JE_INVERSE}")
+    endforeach()
+    string(SHA256 JE_ACTUAL_AFTER "${JE_AFTER}")
+    string(TOLOWER "${JE_AFTER_SHA}" JE_EXPECTED_AFTER)
+    if(NOT JE_INVERSE STREQUAL JE_BEFORE OR NOT JE_ACTUAL_AFTER STREQUAL JE_EXPECTED_AFTER)
+        message(FATAL_ERROR "JE ASTC patch: post-hash or exact inverse mismatch")
+    endif()
+    set(JE_PATCH_PATH_${JE_INDEX} "${JE_PATH}")
+    set(JE_PATCH_TEXT_${JE_INDEX} "${JE_AFTER}")
+    set(JE_PATCH_SHA_${JE_INDEX} "${JE_EXPECTED_AFTER}")
+endforeach()
+foreach(JE_INDEX RANGE 0 1)
+    file(CONFIGURE OUTPUT "${JE_ASTC_WORK}/${JE_PATCH_PATH_${JE_INDEX}}" CONTENT "${JE_PATCH_TEXT_${JE_INDEX}}" @ONLY NEWLINE_STYLE UNIX)
+    JE_python_verify_file("${JE_ASTC_WORK}/${JE_PATCH_PATH_${JE_INDEX}}" "${JE_PATCH_SHA_${JE_INDEX}}" "ASTC patched raw bytes")
+endforeach()
diff --git a/cmake/Tools/LocalPackages/ASTCEncoder/astc-encoder-3.2-rev1.patch b/cmake/Tools/LocalPackages/ASTCEncoder/astc-encoder-3.2-rev1.patch
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/ASTCEncoder/astc-encoder-3.2-rev1.patch
@@ -0,0 +1,55 @@
+diff --git a/Source/CMakeLists.txt b/Source/CMakeLists.txt
+index a90fa27..e5ecf8e 100644
+--- a/Source/CMakeLists.txt
++++ b/Source/CMakeLists.txt
+@@ -15,10 +15,11 @@
+ #  under the License.
+ #  ----------------------------------------------------------------------------
+ 
++# O3DE change: use "-flto -ffat-lto-objects" instead of "-flto -fno-fat-lto-objects" for linux since it may remove some functions for static library which leads to undefined symbols
+ # Overwrite the LTO flags to force fat LTO; worth 3-4% performance
+ # See https://gitlab.kitware.com/cmake/cmake/-/issues/16808
+ if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND ${CLI})
+-    set(CMAKE_CXX_COMPILE_OPTIONS_IPO "-flto")
++    set(CMAKE_CXX_COMPILE_OPTIONS_IPO "-ffat-lto-objects")
+ endif()
+ 
+ if(${DECOMPRESSOR})
+diff --git a/Source/cmake_core.cmake b/Source/cmake_core.cmake
+index 5ceb521..f6d2426 100644
+--- a/Source/cmake_core.cmake
++++ b/Source/cmake_core.cmake
+@@ -104,6 +104,9 @@ macro(astcenc_set_properties NAME)
+             $<$<CXX_COMPILER_ID:MSVC>:/EHsc>
+             $<$<CXX_COMPILER_ID:MSVC>:/fp:strict>
+ 
++            # O3DE change: remove /GL for MSVC build to resolve linking issue            
++            $<$<CXX_COMPILER_ID:MSVC>:/GL->
++
+             # G++ and Clang++ compiler defines
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wall>
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wextra>
+@@ -112,6 +115,9 @@ macro(astcenc_set_properties NAME)
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wshadow>
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wdouble-promotion>
+ 
++            # O3DE change: add PIC to address linking static library issue
++            $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-fPIC>
++
+             # Hide noise thrown up by Clang 10 and clang-cl
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wno-unknown-warning-option>
+             $<$<NOT:$<CXX_COMPILER_ID:MSVC>>:-Wno-c++98-compat-pedantic>
+@@ -141,10 +147,11 @@ macro(astcenc_set_properties NAME)
+             PROPERTY
+                 INTERPROCEDURAL_OPTIMIZATION_RELEASE True)
+ 
+-        # Use a static runtime on MSVC builds (ignored on non-MSVC compilers)
++        # O3DE change: changed from using static runtime to dynamic runtime since O3DE libraries uses dynamic runtime 
++        # Use a dynamic runtime on MSVC builds (ignored on non-MSVC compilers)
+         set_property(TARGET ${NAME}
+             PROPERTY
+-                MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>")
++                MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
+     endif()
+ 
+     # Set up configuration for SIMD ISA builds
diff --git a/cmake/Tools/LocalPackages/ASTCEncoder/BuildASTCEncoderPackage.cmake b/cmake/Tools/LocalPackages/ASTCEncoder/BuildASTCEncoderPackage.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/ASTCEncoder/BuildASTCEncoderPackage.cmake
@@ -0,0 +1,109 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+cmake_minimum_required(VERSION 3.24)
+include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
+foreach(JE_ARGUMENT IN ITEMS SOURCE_ARCHIVE SOURCE_SHA256 SOURCE_URL OUTPUT)
+    if(NOT DEFINED JE_ASTC_${JE_ARGUMENT} OR "${JE_ASTC_${JE_ARGUMENT}}" STREQUAL "")
+        message(FATAL_ERROR "JE local ASTC: JE_ASTC_${JE_ARGUMENT} is required")
+    endif()
+endforeach()
+JE_python_require_local_path(JE_ASTC_SOURCE_ARCHIVE)
+JE_python_require_local_path(JE_ASTC_OUTPUT)
+get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
+set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
+cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_ASTC_OUTPUT}" NORMALIZE JE_OUTPUT_IN_BUILD)
+if(NOT JE_OUTPUT_IN_BUILD OR JE_ASTC_OUTPUT STREQUAL JE_BUILD_ROOT)
+    message(FATAL_ERROR "JE local ASTC: output must be beneath this checkout/build")
+endif()
+if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
+    message(FATAL_ERROR "JE local ASTC requires Windows x64 and Visual Studio 2022")
+endif()
+if(EXISTS "${JE_ASTC_OUTPUT}")
+    message(FATAL_ERROR "JE local ASTC: output must be new; existing outputs are preserved")
+endif()
+set(JE_SOURCE_COMMIT "f32d8d4dd9e06f8986cd5e10f12e199fc023f150")
+set(JE_EXPECTED_HASH "291c26fcf20b8e23a6eb1ad4dd75f5afecf79d316c0477c532df6d5693291403")
+set(JE_EXPECTED_URL "https://codeload.github.com/ARM-software/astc-encoder/tar.gz/${JE_SOURCE_COMMIT}")
+string(TOLOWER "${JE_ASTC_SOURCE_SHA256}" JE_SOURCE_HASH)
+if(NOT JE_SOURCE_HASH STREQUAL JE_EXPECTED_HASH OR NOT JE_ASTC_SOURCE_URL STREQUAL JE_EXPECTED_URL)
+    message(FATAL_ERROR "JE local ASTC: source URL/SHA256 must match the audited 3.2 archive")
+endif()
+JE_python_verify_file("${JE_ASTC_SOURCE_ARCHIVE}" "${JE_SOURCE_HASH}" "ASTC source archive")
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/astc-encoder-3.2-rev1.patch" "88e0389289a28db8d937842d890a7ec4953d2295c263997236b05be4b3b5bd00" "original ASTC recipe patch")
+JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json" "1d45acd2e7674fdb62afd8187c5ff7d41c72590cd359f84ce518cad5e3ab2dca" "ASTC patch manifest")
+
+# Only the pinned, completely audited zero-link archive is extracted into fresh private work.
+set(JE_ASTC_WORK "${JE_ASTC_OUTPUT}/source-work/astc-encoder-${JE_SOURCE_COMMIT}")
+set(JE_BUILD "${JE_ASTC_OUTPUT}/build")
+set(JE_STAGE "${JE_ASTC_OUTPUT}/stage")
+file(MAKE_DIRECTORY "${JE_ASTC_OUTPUT}/source-work")
+file(ARCHIVE_EXTRACT INPUT "${JE_ASTC_SOURCE_ARCHIVE}" DESTINATION "${JE_ASTC_OUTPUT}/source-work")
+JE_python_verify_file("${JE_ASTC_WORK}/CMakeLists.txt" "86f785318c024bbe740ca5ff05982c195a3e4a14a8dc01e663b2e245ea3c2a85" "ASTC source project")
+JE_python_verify_file("${JE_ASTC_WORK}/Source/astcenc.h" "a19c5a0ba650eb7f61c24b29673eee78b0d6f72b5b17426cfe349bd9f82967aa" "ASTC 3.2 API header")
+include("${CMAKE_CURRENT_LIST_DIR}/ApplyASTCPatch.cmake")
+
+function(JE_astc_native JE_LABEL)
+    file(WRITE "${JE_ASTC_OUTPUT}/${JE_LABEL}-argv.txt" "")
+    foreach(JE_ARG IN LISTS ARGN)
+        file(APPEND "${JE_ASTC_OUTPUT}/${JE_LABEL}-argv.txt" "${JE_ARG}\n")
+    endforeach()
+    string(TIMESTAMP JE_START "%Y-%m-%dT%H:%M:%SZ" UTC)
+    execute_process(COMMAND ${ARGN} RESULT_VARIABLE JE_RESULT
+        OUTPUT_FILE "${JE_ASTC_OUTPUT}/${JE_LABEL}-stdout.log" ERROR_FILE "${JE_ASTC_OUTPUT}/${JE_LABEL}-stderr.log")
+    string(TIMESTAMP JE_END "%Y-%m-%dT%H:%M:%SZ" UTC)
+    file(WRITE "${JE_ASTC_OUTPUT}/${JE_LABEL}-result.txt" "start=${JE_START}\nend=${JE_END}\nresult=${JE_RESULT}\n")
+    if(NOT JE_RESULT STREQUAL "0")
+        message(FATAL_ERROR "JE local ASTC ${JE_LABEL} failed (${JE_RESULT}); outputs retained, package not published")
+    endif()
+endfunction()
+JE_astc_native(configure "${CMAKE_COMMAND}" -S "${JE_ASTC_WORK}" -B "${JE_BUILD}"
+    -G "Visual Studio 17 2022" -A x64 -T v143
+    -DISA_SSE41=ON -DISA_AVX2=OFF -DISA_SSE2=OFF -DISA_NEON=OFF -DISA_NONE=OFF -DISA_NATIVE=OFF
+    -DDECOMPRESSOR=OFF -DCLI=ON -DDIAGNOSTICS=OFF -DUNITTEST=OFF -DBUILD_TESTING=OFF)
+foreach(JE_CONFIG IN ITEMS Release Debug)
+    JE_astc_native(build-${JE_CONFIG} "${CMAKE_COMMAND}" --build "${JE_BUILD}" --config ${JE_CONFIG}
+        --target astcenc-sse4.1-static astcenc-sse4.1 --parallel 8)
+    foreach(JE_FILE IN ITEMS astcenc-sse4.1-static.lib astcenc-sse4.1.exe)
+        if(NOT EXISTS "${JE_BUILD}/Source/${JE_CONFIG}/${JE_FILE}")
+            message(FATAL_ERROR "JE local ASTC: expected ${JE_CONFIG} artifact missing: ${JE_FILE}")
+        endif()
+    endforeach()
+endforeach()
+# Stage only after both configurations succeed. No global install, tools download or runtime deploy.
+file(MAKE_DIRECTORY "${JE_STAGE}/astc-encoder/include" "${JE_STAGE}/LICENSES/ASTC" "${JE_STAGE}/LICENSES/O3DE")
+foreach(JE_CONFIG IN ITEMS Release Debug)
+    file(MAKE_DIRECTORY "${JE_STAGE}/astc-encoder/bin/${JE_CONFIG}")
+    file(COPY "${JE_BUILD}/Source/${JE_CONFIG}/astcenc-sse4.1-static.lib" "${JE_BUILD}/Source/${JE_CONFIG}/astcenc-sse4.1.exe"
+        DESTINATION "${JE_STAGE}/astc-encoder/bin/${JE_CONFIG}")
+endforeach()
+file(COPY "${JE_ASTC_WORK}/Source/astcenc.h" DESTINATION "${JE_STAGE}/astc-encoder/include")
+configure_file("${JE_ASTC_WORK}/LICENSE.txt" "${JE_STAGE}/astc-encoder/LICENSE.txt" COPYONLY)
+# Keep full original notices of compiled library/CLI code, including embedded miniz/OpenEXR/STB.
+file(GLOB JE_NOTICE_SOURCES "${JE_ASTC_WORK}/Source/*.cpp" "${JE_ASTC_WORK}/Source/*.h")
+file(COPY ${JE_NOTICE_SOURCES} DESTINATION "${JE_STAGE}/LICENSES/ASTC/source-notices")
+file(COPY "${JE_ASTC_WORK}/LICENSE.txt" DESTINATION "${JE_STAGE}/LICENSES/ASTC")
+file(COPY "${CMAKE_CURRENT_LIST_DIR}/astc-encoder-3.2-rev1.patch" "${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json"
+    DESTINATION "${JE_STAGE}/LICENSES/O3DE/recipe")
+file(COPY "${JE_ENGINE_ROOT}/LICENSE.txt" "${JE_ENGINE_ROOT}/LICENSE_APACHE2.TXT" "${JE_ENGINE_ROOT}/LICENSE_MIT.TXT" DESTINATION "${JE_STAGE}/LICENSES/O3DE")
+file(COPY "${CMAKE_CURRENT_LIST_DIR}/Findastc-encoder.cmake" "${CMAKE_CURRENT_LIST_DIR}/NOTICE.txt" "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION "${JE_STAGE}")
+configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
+file(WRITE "${JE_STAGE}/astc-encoder/JERecipe.json"
+    "{\n  \"sourceVersion\": \"3.2.0\", \"sourceCommit\": \"${JE_SOURCE_COMMIT}\",\n"
+    "  \"historicalRecipeCommit\": \"90480ca41d15e1b20a28f90e2f996fd0e5a3a68c\",\n"
+    "  \"historicalPackageVersion\": \"3.2-rev2\", \"historicalBinaryHashMatch\": false,\n"
+    "  \"generator\": \"Visual Studio 17 2022\", \"toolset\": \"v143\", \"architecture\": \"x64\",\n"
+    "  \"configurations\": [\"Release\",\"Debug\"], \"parallelJobs\": 8,\n"
+    "  \"runtimeLibrary\": \"MultiThreaded$<$<CONFIG:Debug>:Debug>DLL\",\n"
+    "  \"isa\": \"SSE4.1\", \"fullCodec\": true, \"cliDebugTool\": true, \"unitTests\": false,\n"
+    "  \"patchSHA256\": \"88e0389289a28db8d937842d890a7ec4953d2295c263997236b05be4b3b5bd00\",\n"
+    "  \"patchedSourceCMakeSHA256\": \"4e425cff86bb25deb666ec8f8135e607c8833c32ea08f16b6b6f5839d6420fd7\",\n"
+    "  \"patchedCoreCMakeSHA256\": \"eecc5233bedd1d2e6340bb7edc98d75474019a24df52eb912f7db3301292b80f\"\n}\n")
+set(JE_PACKAGE_STAGE "${JE_STAGE}")
+set(JE_PACKAGE_NAME "astc-encoder-3.2-je-rev1-windows")
+set(JE_PACKAGE_OUTPUT "${JE_ASTC_OUTPUT}/packages")
+set(JE_PACKAGE_VERSION "3.2.0")
+set(JE_PACKAGE_SOURCE_COMMIT "${JE_SOURCE_COMMIT}")
+set(JE_PACKAGE_SOURCE_SHA256 "${JE_SOURCE_HASH}")
+set(JE_PACKAGE_SOURCE_URL "${JE_EXPECTED_URL}")
+set(JE_PACKAGE_LICENSE "Apache-2.0 AND MIT AND BSD-3-Clause AND Unlicense")
+include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
diff --git a/cmake/Tools/LocalPackages/ASTCEncoder/Findastc-encoder.cmake b/cmake/Tools/LocalPackages/ASTCEncoder/Findastc-encoder.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/ASTCEncoder/Findastc-encoder.cmake
@@ -0,0 +1,34 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
+set(JE_ASTC_ROOT "${CMAKE_CURRENT_LIST_DIR}")
+JE_python_require_local_path(JE_ASTC_ROOT)
+if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
+    message(FATAL_ERROR "JE local ASTC package requires Windows x64")
+endif()
+set(astc-encoder_VERSION 3.2.0)
+set(astc-encoder_INCLUDE_DIR "${JE_ASTC_ROOT}/astc-encoder/include")
+set(astc-encoder_LIBRARY_DIR "${JE_ASTC_ROOT}/astc-encoder/bin")
+set(astc-encoder_LIBRARY_RELEASE "${astc-encoder_LIBRARY_DIR}/Release/astcenc-sse4.1-static.lib")
+set(astc-encoder_LIBRARY_DEBUG "${astc-encoder_LIBRARY_DIR}/Debug/astcenc-sse4.1-static.lib")
+foreach(JE_PATH IN ITEMS astc-encoder_INCLUDE_DIR astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG)
+    JE_python_require_local_path(${JE_PATH})
+endforeach()
+# This API has no version macro. Bind the reported source-project version to its exact header bytes.
+JE_python_verify_file("${astc-encoder_INCLUDE_DIR}/astcenc.h" "a19c5a0ba650eb7f61c24b29673eee78b0d6f72b5b17426cfe349bd9f82967aa" "ASTC 3.2 API header")
+foreach(JE_LIBRARY IN ITEMS astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG)
+    if(NOT EXISTS "${${JE_LIBRARY}}" OR IS_DIRECTORY "${${JE_LIBRARY}}")
+        message(FATAL_ERROR "JE ASTC package: required local library missing: ${${JE_LIBRARY}}")
+    endif()
+endforeach()
+include(FindPackageHandleStandardArgs)
+find_package_handle_standard_args(astc-encoder REQUIRED_VARS astc-encoder_INCLUDE_DIR astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG VERSION_VAR astc-encoder_VERSION)
+if(NOT TARGET 3rdParty::astc-encoder)
+    add_library(3rdParty::astc-encoder STATIC IMPORTED GLOBAL)
+    set_target_properties(3rdParty::astc-encoder PROPERTIES IMPORTED_LOCATION "${astc-encoder_LIBRARY_RELEASE}" IMPORTED_LOCATION_DEBUG "${astc-encoder_LIBRARY_DEBUG}")
+    if(COMMAND ly_target_include_system_directories)
+        ly_target_include_system_directories(TARGET 3rdParty::astc-encoder INTERFACE "${astc-encoder_INCLUDE_DIR}")
+    else()
+        target_include_directories(3rdParty::astc-encoder SYSTEM INTERFACE "${astc-encoder_INCLUDE_DIR}")
+    endif()
+endif()
diff --git a/cmake/Tools/LocalPackages/ASTCEncoder/NOTICE.txt b/cmake/Tools/LocalPackages/ASTCEncoder/NOTICE.txt
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/ASTCEncoder/NOTICE.txt
@@ -0,0 +1,22 @@
+ASTC encoder source: ARM-software/astc-encoder tag 3.2, commit
+f32d8d4dd9e06f8986cd5e10f12e199fc023f150; project version 3.2.0.
+Arm library and CLI source are Apache-2.0. Complete original LICENSE.txt
+and compiled source notices are retained. The CLI bundles STB (MIT chosen
+from its dual license), TinyEXR/OpenEXR (BSD-3-Clause), and miniz (Unlicense);
+their full original headers/notices are in LICENSES/ASTC/source-notices.
+Unbuilt GoogleTest and test image assets are not included in this package.
+
+Original O3DE recipe authority: 90480ca41d15e1b20a28f90e2f996fd0e5a3a68c,
+package-system/astc-encoder, package 3.2-rev2. Its patch named
+astc-encoder-3.2-rev1.patch is preserved byte-for-byte and applied only to a
+fresh private source copy with exact contexts, SHA256 and inverse checks.
+Only two upstream CMake files change: dynamic MSVC CRT, /GL-, non-MSVC PIC
+and fat-LTO flags. No codec source/API changes. O3DE glue is Apache-2.0 OR MIT;
+full original O3DE licenses and the recipe patch are retained.
+
+JE adaptation: VS2022/v143 replaces VS2019, preserving Windows x64 SSE4.1,
+full compression/decompression, Release/Debug and /MD and /MDd CRT
+(MultiThreadedDLL / MultiThreadedDebugDLL). The package has a new JE identity
+and a newly measured archive hash; historical binary hash/ABI identity is
+not asserted. CLI is a host debugging tool, not a Runtime deployment.
+Rights/security/product acceptance remain with the integration owner.
