diff --git a/cmake/Tools/LocalPackages/PhysX/StagePhysXPackage.cmake b/cmake/Tools/LocalPackages/PhysX/StagePhysXPackage.cmake
new file mode 100644
--- /dev/null
+++ b/cmake/Tools/LocalPackages/PhysX/StagePhysXPackage.cmake
@@ -0,0 +1,135 @@
+# Copyright (c) Contributors to the Open 3D Engine Project.
+# SPDX-License-Identifier: Apache-2.0 OR MIT
+
+# Stage the already built static pass. No configure/build, SDK script or acquisition.
+cmake_minimum_required(VERSION 3.24)
+include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
+foreach(JE_ARGUMENT IN ITEMS SOURCE_ARCHIVE SOURCE_ROOT SOURCE_MANIFEST ARTIFACT_MANIFEST ARTIFACT_MANIFEST_SHA256 OUTPUT)
+    if(NOT DEFINED JE_PHYSX_${JE_ARGUMENT} OR "${JE_PHYSX_${JE_ARGUMENT}}" STREQUAL "")
+        message(FATAL_ERROR "JE PhysX stage: JE_PHYSX_${JE_ARGUMENT} is required")
+    endif()
+endforeach()
+foreach(JE_ARGUMENT IN ITEMS SOURCE_ARCHIVE SOURCE_ROOT SOURCE_MANIFEST ARTIFACT_MANIFEST OUTPUT)
+    JE_python_require_local_path(JE_PHYSX_${JE_ARGUMENT})
+endforeach()
+get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
+set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
+cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_PHYSX_OUTPUT}" NORMALIZE JE_IN_BUILD)
+if(NOT JE_IN_BUILD OR JE_PHYSX_OUTPUT STREQUAL JE_BUILD_ROOT)
+    message(FATAL_ERROR "JE PhysX stage: output must be beneath this checkout/build")
+endif()
+if(EXISTS "${JE_PHYSX_OUTPUT}")
+    message(FATAL_ERROR "JE PhysX stage: output must be fresh; existing outputs are preserved")
+endif()
+JE_python_verify_file("${JE_PHYSX_SOURCE_ARCHIVE}" "a2dfa049b0c7fa67723d27d70520d0ed7bcb5dd3c2d9df8dfb169d8a39c4c142" "PhysX SDK source archive")
+JE_python_verify_file("${JE_PHYSX_SOURCE_MANIFEST}" "202329a844df20f8e3349c589a3d9567f7d633615b2b17e37fd49929f03ac2ad" "PhysX SDK source manifest")
+JE_python_verify_file("${JE_PHYSX_ARTIFACT_MANIFEST}" "${JE_PHYSX_ARTIFACT_MANIFEST_SHA256}" "PhysX native artifact witness")
+file(READ "${CMAKE_CURRENT_LIST_DIR}/Recipe.json" JE_RECIPE_JSON)
+string(JSON JE_HELPER_COUNT LENGTH "${JE_RECIPE_JSON}" helperOriginals)
+if(NOT JE_HELPER_COUNT EQUAL 6)
+    message(FATAL_ERROR "JE PhysX stage: complete official helper/notice provenance required")
+endif()
+foreach(JE_INDEX RANGE 5)
+    string(JSON JE_HELPER GET "${JE_RECIPE_JSON}" helperOriginals ${JE_INDEX} path)
+    string(JSON JE_HELPER_SHA GET "${JE_RECIPE_JSON}" helperOriginals ${JE_INDEX} sha256)
+    JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/official-build-helpers/${JE_HELPER}" "${JE_HELPER_SHA}" "PhysX official helper/notice")
+endforeach()
+file(READ "${JE_PHYSX_SOURCE_MANIFEST}" JE_SOURCE_JSON)
+file(READ "${JE_PHYSX_ARTIFACT_MANIFEST}" JE_ARTIFACT_JSON)
+string(JSON JE_SOURCE_COUNT LENGTH "${JE_SOURCE_JSON}" entries)
+string(JSON JE_LIBRARY_COUNT LENGTH "${JE_ARTIFACT_JSON}" libraries)
+if(NOT JE_SOURCE_COUNT EQUAL 1788 OR NOT JE_LIBRARY_COUNT EQUAL 56)
+    message(FATAL_ERROR "JE PhysX stage: require the complete 1788-source/56-static-archive witnesses")
+endif()
+set(JE_MAIN_LIBS PhysX PhysXPvdSDK PhysXVehicle PhysXCharacterKinematic PhysXExtensions PhysXCooking PhysXCommon PhysXFoundation)
+set(JE_EXTRA_LIBS LowLevel LowLevelAABB LowLevelDynamics PhysXTask SceneQuery SimulationController)
+set(JE_EXPECTED_PAIRS "")
+foreach(JE_CONFIG IN ITEMS debug checked profile release)
+    foreach(JE_TARGET IN LISTS JE_MAIN_LIBS JE_EXTRA_LIBS)
+        list(APPEND JE_EXPECTED_PAIRS "${JE_CONFIG}/${JE_TARGET}")
+    endforeach()
+endforeach()
+# Validate all inputs before creating a stage or publishing a package.
+set(JE_SOURCE_PATHS "")
+math(EXPR JE_LAST_SOURCE "${JE_SOURCE_COUNT}-1")
+foreach(JE_INDEX RANGE ${JE_LAST_SOURCE})
+    string(JSON JE_REL GET "${JE_SOURCE_JSON}" entries ${JE_INDEX} path)
+    string(JSON JE_HASH GET "${JE_SOURCE_JSON}" entries ${JE_INDEX} sha256)
+    string(JSON JE_BYTES GET "${JE_SOURCE_JSON}" entries ${JE_INDEX} bytes)
+    if(NOT JE_REL MATCHES "^(physx/|LICENSE[.]md$|README[.]md$)" OR JE_REL MATCHES "(^|/)[.][.](/|$)|[:\\]" OR JE_REL IN_LIST JE_SOURCE_PATHS)
+        message(FATAL_ERROR "JE PhysX stage: invalid source membership")
+    endif()
+    list(APPEND JE_SOURCE_PATHS "${JE_REL}")
+    set(JE_SOURCE_FILE "${JE_PHYSX_SOURCE_ROOT}/${JE_REL}")
+    JE_python_verify_file("${JE_SOURCE_FILE}" "${JE_HASH}" "PhysX immutable source ${JE_REL}")
+    file(SIZE "${JE_SOURCE_FILE}" JE_ACTUAL_BYTES)
+    if(NOT JE_ACTUAL_BYTES EQUAL JE_BYTES)
+        message(FATAL_ERROR "JE PhysX stage: source byte count differs")
+    endif()
+endforeach()
+set(JE_ACTUAL_PAIRS "")
+foreach(JE_INDEX RANGE 55)
+    foreach(JE_FIELD IN ITEMS config target path sha256 bytes)
+        string(JSON JE_${JE_FIELD} GET "${JE_ARTIFACT_JSON}" libraries ${JE_INDEX} ${JE_FIELD})
+    endforeach()
+    set(JE_PAIR "${JE_config}/${JE_target}")
+    if(NOT JE_PAIR IN_LIST JE_EXPECTED_PAIRS OR JE_PAIR IN_LIST JE_ACTUAL_PAIRS)
+        message(FATAL_ERROR "JE PhysX stage: invalid native library membership ${JE_PAIR}")
+    endif()
+    list(APPEND JE_ACTUAL_PAIRS "${JE_PAIR}")
+    get_filename_component(JE_BASENAME "${JE_path}" NAME)
+    if(JE_target IN_LIST JE_MAIN_LIBS)
+        set(JE_EXPECTED_BASENAME "${JE_target}_static_64.lib")
+    else()
+        # The static pass builds object-library archives in target.dir/config.
+        set(JE_EXPECTED_BASENAME "${JE_target}.lib")
+    endif()
+    if(NOT JE_BASENAME STREQUAL JE_EXPECTED_BASENAME)
+        message(FATAL_ERROR "JE PhysX stage: unexpected original library name ${JE_BASENAME}")
+    endif()
+    JE_python_verify_file("${JE_path}" "${JE_sha256}" "PhysX native archive ${JE_PAIR}")
+    file(SIZE "${JE_path}" JE_ACTUAL_BYTES)
+    if(NOT JE_ACTUAL_BYTES EQUAL JE_bytes OR JE_ACTUAL_BYTES EQUAL 0)
+        message(FATAL_ERROR "JE PhysX stage: native archive byte count differs")
+    endif()
+endforeach()
+string(JSON JE_GENERATED_HEADER GET "${JE_ARTIFACT_JSON}" generatedHeader path)
+string(JSON JE_GENERATED_HEADER_SHA GET "${JE_ARTIFACT_JSON}" generatedHeader sha256)
+JE_python_verify_file("${JE_GENERATED_HEADER}" "${JE_GENERATED_HEADER_SHA}" "PhysX generated PxConfig.h")
+file(READ "${JE_GENERATED_HEADER}" JE_CONFIG_TEXT)
+if(NOT JE_CONFIG_TEXT MATCHES "#define PX_PHYSX_STATIC_LIB")
+    message(FATAL_ERROR "JE PhysX stage: generated header must describe the static pass")
+endif()
+set(JE_STAGE "${JE_PHYSX_OUTPUT}/stage")
+foreach(JE_REL IN LISTS JE_SOURCE_PATHS)
+    if(JE_REL MATCHES "^physx/include/" OR JE_REL STREQUAL "physx/version.txt")
+        configure_file("${JE_PHYSX_SOURCE_ROOT}/${JE_REL}" "${JE_STAGE}/PhysX/${JE_REL}" COPYONLY)
+    endif()
+endforeach()
+configure_file("${JE_GENERATED_HEADER}" "${JE_STAGE}/PhysX/physx/include/PxConfig.h" COPYONLY)
+foreach(JE_INDEX RANGE 55)
+    foreach(JE_FIELD IN ITEMS config target path)
+        string(JSON JE_${JE_FIELD} GET "${JE_ARTIFACT_JSON}" libraries ${JE_INDEX} ${JE_FIELD})
+    endforeach()
+    configure_file("${JE_path}" "${JE_STAGE}/PhysX/physx/bin/static/${JE_config}/${JE_target}_static_64.lib" COPYONLY)
+endforeach()
+configure_file("${JE_PHYSX_ARTIFACT_MANIFEST}" "${JE_STAGE}/PhysX/JEStaticArtifactWitness.json" COPYONLY)
+configure_file("${JE_PHYSX_SOURCE_ROOT}/LICENSE.md" "${JE_STAGE}/LICENSES/PhysX/LICENSE.md" COPYONLY)
+configure_file("${JE_PHYSX_SOURCE_ROOT}/README.md" "${JE_STAGE}/LICENSES/PhysX/README.md" COPYONLY)
+foreach(JE_FILE IN ITEMS FindPhysX5.cmake NOTICE.txt Recipe.json)
+    configure_file("${CMAKE_CURRENT_LIST_DIR}/${JE_FILE}" "${JE_STAGE}/${JE_FILE}" COPYONLY)
+endforeach()
+configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
+file(COPY "${CMAKE_CURRENT_LIST_DIR}/official-build-helpers" DESTINATION "${JE_STAGE}/LICENSES")
+foreach(JE_FILE IN ITEMS LICENSE.txt LICENSE_APACHE2.TXT LICENSE_MIT.TXT)
+    configure_file("${JE_ENGINE_ROOT}/${JE_FILE}" "${JE_STAGE}/LICENSES/O3DE/${JE_FILE}" COPYONLY)
+endforeach()
+set(JE_PACKAGE_STAGE "${JE_STAGE}")
+set(JE_PACKAGE_NAME "PhysX-5.1.1-je-cpu-rev1-windows")
+set(JE_PACKAGE_OUTPUT "${JE_PHYSX_OUTPUT}/packages")
+set(JE_PACKAGE_VERSION "5.1.1")
+set(JE_PACKAGE_SOURCE_COMMIT "0bbcff3d0c541325f4d14c36ee18f24e22e35e6e")
+set(JE_PACKAGE_SOURCE_SHA256 "a2dfa049b0c7fa67723d27d70520d0ed7bcb5dd3c2d9df8dfb169d8a39c4c142")
+set(JE_PACKAGE_SOURCE_URL "https://codeload.github.com/NVIDIA-Omniverse/PhysX/tar.gz/0bbcff3d0c541325f4d14c36ee18f24e22e35e6e")
+set(JE_PACKAGE_LICENSE "BSD-3-Clause; original notices preserved")
+include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
