idate(InputStream& is, OutputStream& os) {\n-#define RAPIDJSON_COPY() os.Put(c = is.Take())\n+#define RAPIDJSON_COPY() if (c != '\\0') os.Put(c = is.Take())\n #define RAPIDJSON_TRANS(mask) result &= ((GetRange(static_cast<unsigned char>(c)) & mask) != 0)\n #define RAPIDJSON_TAIL() RAPIDJSON_COPY(); RAPIDJSON_TRANS(0x70)\n-        Ch c;\n+        Ch c = static_cast<Ch>(-1);\n         RAPIDJSON_COPY();\n         if (!(c & 0x80))\n             return true;"},{"sha":"dec3da6988a8fb948be9d7be236289692849cd50","filename":"test/unittest/readertest.cpp","status":"modified","additions":18,"deletions":0,"changes":18,"blob_url":"https://github.com/Tencent/rapidjson/blob/24b5e7a8b27f42fa16b96fc70aade9106cf7102f/test%2Funittest%2Freadertest.cpp","raw_url":"https://github.com/Tencent/rapidjson/raw/24b5e7a8b27f42fa16b96fc70aade9106cf7102f/test%2Funittest%2Freadertest.cpp","contents_url":"https://api.github.com/repos/Tencent/rapidjson/contents/test%2Funittest%2Freadertest.cpp?ref=24b5e7a8b27f42fa16b96fc70aade9106cf7102f","patch":"@@ -987,6 +987,24 @@ TEST(Reader, ParseString_Error) {\n         }\n     }\n \n+    // 3.6 Lonely start characters near the end of the input\n+    {\n+        char e[] = { '\\\"', 0, '\\\"', '\\0' };\n+        for (unsigned c = 0xC0u; c <= 0xFFu; c++) {\n+            e[1] = static_cast<char>(c);\n+            unsigned streamPos;\n+            if (c <= 0xC1u)\n+                streamPos = 2; // 0xC0 - 0xC1\n+            else if (c <= 0xDFu)\n+                streamPos = 3; // 0xC2 - 0xDF\n+            else if (c <= 0xF4u)\n+                streamPos = 4; // 0xE0 - 0xF4\n+            else\n+                streamPos = 2; // 0xF5 - 0xFF\n+            TEST_STRING_ERROR(kParseErrorStringInvalidEncoding, e, 1u, streamPos);\n+        }\n+    }\n+\n     // 4  Overlong sequences\n \n     // 4.1  Examples of an overlong ASCII character"}]}