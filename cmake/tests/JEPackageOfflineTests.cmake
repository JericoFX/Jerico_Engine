cmake_minimum_required(VERSION 3.24)
get_filename_component(JE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT JE_TEST_OUTPUT)
    message(FATAL_ERROR "Set JE_TEST_OUTPUT to a dedicated evidence directory outside the source tree")
endif()
if(NOT IS_ABSOLUTE "${JE_TEST_OUTPUT}")
    message(FATAL_ERROR "JE_TEST_OUTPUT must be an absolute path to a dedicated evidence directory")
endif()
file(MAKE_DIRECTORY "${JE_TEST_OUTPUT}")
# Every run owns a new fixture; no user package/cache directory is removed.
string(TIMESTAMP JE_RUN "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef JE_SUFFIX)
set(JE_RUN "${JE_TEST_OUTPUT}/${JE_RUN}-${JE_SUFFIX} with spaces")
set(JE_SOURCE "${JE_RUN}/source")
file(MAKE_DIRECTORY "${JE_SOURCE}/payload")
file(WRITE "${JE_SOURCE}/payload/payload.txt" "JE offline fixture\n")
file(WRITE "${JE_SOURCE}/payload/PackageInfo.json" "{\"name\":\"JEFixture\"}\n")
file(SHA256 "${JE_SOURCE}/payload/payload.txt" JE_PAYLOAD_HASH)
file(SHA256 "${JE_SOURCE}/payload/PackageInfo.json" JE_INFO_HASH)
file(WRITE "${JE_SOURCE}/payload/SHA256SUMS" "${JE_PAYLOAD_HASH} *payload.txt\n${JE_INFO_HASH} *PackageInfo.json\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cJf "${JE_SOURCE}/JEFixture.tar.xz"
    payload.txt PackageInfo.json SHA256SUMS WORKING_DIRECTORY "${JE_SOURCE}/payload"
    RESULT_VARIABLE JE_TAR_RESULT)
if(NOT JE_TAR_RESULT EQUAL 0)
    message(FATAL_ERROR "JE fixture archive creation failed: ${JE_TAR_RESULT}")
endif()
file(SHA256 "${JE_SOURCE}/JEFixture.tar.xz" JE_HASH)

function(JE_run_case JE_CASE JE_EXPECT JE_REMOTE)
    set(JE_WORK "${JE_RUN}/${JE_CASE}")
    file(MAKE_DIRECTORY "${JE_WORK}")
    if(JE_CASE STREQUAL "git" OR JE_CASE STREQUAL "source_override" OR JE_CASE MATCHES "^fetch_")
        file(MAKE_DIRECTORY "${JE_WORK}/project")
        file(WRITE "${JE_WORK}/project/CMakeLists.txt"
            "cmake_minimum_required(VERSION 3.24)\nproject(JEOfflineFixture LANGUAGES NONE)\ninclude(\"${CMAKE_CURRENT_LIST_DIR}/JEPackageOfflineCase.cmake\")\n")
        set(JE_MODE -S "${JE_WORK}/project" -B "${JE_WORK}/build")
    else()
        set(JE_MODE -P "${CMAKE_CURRENT_LIST_DIR}/JEPackageOfflineCase.cmake")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DJE_ROOT=${JE_ROOT}" "-DJE_WORK=${JE_WORK}"
        "-DJE_SOURCE=${JE_SOURCE}" "-DJE_HASH=${JE_HASH}" "-DJE_CASE=${JE_CASE}"
        "-DJE_REMOTE=${JE_REMOTE}" ${JE_MODE}
        RESULT_VARIABLE JE_RESULT OUTPUT_VARIABLE JE_STDOUT ERROR_VARIABLE JE_STDERR)
    set(JE_LOG "${JE_STDOUT}\n${JE_STDERR}")
    file(WRITE "${JE_WORK}/result.log" "exit=${JE_RESULT}\n${JE_LOG}")
    if(EXISTS "${JE_WORK}/forbidden-io")
        message(SEND_ERROR "JE FAIL ${JE_CASE}: attempted remote I/O (intercepted), log ${JE_WORK}/result.log")
    elseif(EXISTS "${JE_WORK}/forbidden-hook")
        message(SEND_ERROR "JE FAIL ${JE_CASE}: executed a forwarded patch hook, log ${JE_WORK}/result.log")
    elseif(JE_EXPECT STREQUAL "PASS")
        if(NOT JE_RESULT EQUAL 0)
            message(SEND_ERROR "JE FAIL ${JE_CASE}: exit ${JE_RESULT}, log ${JE_WORK}/result.log")
        else()
            message(STATUS "JE PASS ${JE_CASE}")
        endif()
    elseif(JE_RESULT EQUAL 0 OR NOT JE_LOG MATCHES "${JE_EXPECT}")
        message(SEND_ERROR "JE FAIL ${JE_CASE}: expected ${JE_EXPECT}, exit ${JE_RESULT}, log ${JE_WORK}/result.log")
    else()
        message(STATUS "JE PASS ${JE_CASE} (rejected before remote I/O)")
    endif()
endfunction()

JE_run_case(default PASS "")
JE_run_case(local PASS "")
JE_run_case(cached PASS "")
JE_run_case(corrupt PASS "")
JE_run_case(missing "JE package unavailable offline: JEFixture" "")
JE_run_case(missing_hash "could not find a hash for package JEFixture" "")
JE_run_case(source_override PASS "")
JE_run_case(git "JE FetchContent unavailable offline: JEFixture" "")
JE_run_case(fetch_local PASS "")
JE_run_case(fetch_cached PASS "")
JE_run_case(fetch_missing "JE FetchContent unavailable offline: JEFixture" "")
JE_run_case(fetch_patch "JE FetchContent arguments rejected: JEFixture" "")
JE_run_case(fetch_download_dir "JE FetchContent arguments rejected: JEFixture" "")
JE_run_case(fetch_flags PASS "")
foreach(JE_ORIGIN cache env)
    JE_run_case(${JE_ORIGIN}_https "JE package source rejected" "https://invalid.example/packages")
    JE_run_case(${JE_ORIGIN}_cloudfront "JE package source rejected" "https://d3t6xeg4fgfoum.cloudfront.net")
    JE_run_case(${JE_ORIGIN}_s3 "JE package source rejected" "s3://invalid-bucket/packages")
    JE_run_case(${JE_ORIGIN}_filehost "JE package source rejected" "file://invalid-host/packages")
endforeach()
JE_run_case(direct "JE package source rejected" "https://invalid.example/archive")
JE_run_case(internal "JE package source rejected" "s3://invalid-bucket/archive")
message(STATUS "JE package policy evidence: ${JE_RUN}")
