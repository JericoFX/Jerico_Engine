cmake_minimum_required(VERSION 3.24)
set(LY_ROOT_FOLDER "${JE_ROOT}")
set(LY_3RDPARTY_PATH "${JE_WORK}/third party")
set(LY_PACKAGE_DOWNLOAD_CACHE_LOCATION "${JE_WORK}/cache")
set(LY_PACKAGE_UNPACK_LOCATION "${JE_WORK}/unpack")
set(LY_PACKAGE_SERVER_URLS "" CACHE STRING "" FORCE)
unset(ENV{LY_PACKAGE_SERVER_URLS})
unset(ENV{LY_PACKAGE_DOWNLOAD_CACHE_LOCATION})
unset(ENV{LY_PACKAGE_UNPACK_LOCATION})
if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(O3DE_SCRIPT_ONLY TRUE)
    set_property(GLOBAL PROPERTY O3DE_SCRIPT_ONLY TRUE)
    set(PAL_PLATFORM_NAME Windows)
    set(PAL_PLATFORM_NAME_LOWERCASE windows)
    function(o3de_pal_dir JE_OUTPUT JE_PATH)
        set(${JE_OUTPUT} "${JE_PATH}" PARENT_SCOPE)
    endfunction()
endif()

# Intercept only a forbidden I/O attempt; all local transfers and validation use real CMake.
macro(file)
    if("${ARGV0}" STREQUAL "DOWNLOAD" AND NOT "${ARGV1}" MATCHES "^file:///")
        _file(WRITE "${JE_WORK}/forbidden-io" "${ARGV0}")
        message(FATAL_ERROR "JE test intercepted forbidden remote I/O")
    endif()
    _file(${ARGV})
endmacro()

if(JE_CASE MATCHES "^cache_")
    set(LY_PACKAGE_SERVER_URLS "${JE_REMOTE}" CACHE STRING "" FORCE)
elseif(JE_CASE MATCHES "^env_")
    set(ENV{LY_PACKAGE_SERVER_URLS} "${JE_REMOTE}")
elseif(JE_CASE STREQUAL "local" OR JE_CASE STREQUAL "corrupt")
    if(WIN32)
        set(LY_PACKAGE_SERVER_URLS "file:///${JE_SOURCE}")
    else()
        set(LY_PACKAGE_SERVER_URLS "file://${JE_SOURCE}")
    endif()
endif()

include("${JE_ROOT}/cmake/3rdPartyPackages.cmake")

if(JE_CASE STREQUAL "default")
    if(LY_PACKAGE_SERVER_URLS OR COMMAND ly_s3_download)
        message(FATAL_ERROR "JE test: default contains a remote source or S3 downloader")
    endif()
elseif(JE_CASE MATCHES "^(cache_|env_)")
    message(FATAL_ERROR "JE test: remote package source was not rejected")
elseif(JE_CASE STREQUAL "direct" OR JE_CASE STREQUAL "internal")
    file(MAKE_DIRECTORY "${JE_WORK}/cache")
    file(WRITE "${JE_WORK}/cache/sentinel" "keep")
    file(SHA256 "${JE_WORK}/cache/sentinel" JE_SENTINEL_HASH)
    if(JE_CASE STREQUAL "direct")
        download_file(URL "${JE_REMOTE}" TARGET_FILE "${JE_WORK}/cache/sentinel"
            EXPECTED_HASH "${JE_SENTINEL_HASH}" RESULTS JE_RESULT)
    else()
        if(COMMAND ly_s3_download)
            function(ly_s3_download)
                file(WRITE "${JE_WORK}/forbidden-io" "S3 downloader invoked")
                message(FATAL_ERROR "JE test intercepted forbidden S3 I/O")
            endfunction()
        endif()
        download_file_internal(URL "${JE_REMOTE}" TARGET_FILE "${JE_WORK}/cache/sentinel"
            EXPECTED_HASH "${JE_SENTINEL_HASH}" RESULTS JE_RESULT SHOULD_RETRY JE_RETRY)
    endif()
    message(FATAL_ERROR "JE test: direct remote URL was not rejected")
elseif(JE_CASE STREQUAL "missing_hash")
    ly_enable_package(JEFixture)
elseif(JE_CASE STREQUAL "git" OR JE_CASE STREQUAL "source_override" OR JE_CASE MATCHES "^fetch_")
    if(JE_CASE STREQUAL "source_override")
        set(FETCHCONTENT_SOURCE_DIR_JEFIXTURE "${JE_SOURCE}/payload")
    endif()
    if(JE_CASE MATCHES "^fetch_(local|patch|download_dir|flags)$")
        if(WIN32)
            set(JE_URL "file:///${JE_SOURCE}/JEFixture.tar.xz")
        else()
            set(JE_URL "file://${JE_SOURCE}/JEFixture.tar.xz")
        endif()
    elseif(JE_CASE STREQUAL "fetch_cached" OR JE_CASE STREQUAL "fetch_missing")
        set(JE_URL "https://invalid.example/JEFixture.tar.xz")
        if(JE_CASE STREQUAL "fetch_cached")
            file(MAKE_DIRECTORY "${JE_WORK}/cache/JEFixture")
            configure_file("${JE_SOURCE}/JEFixture.tar.xz" "${JE_WORK}/cache/JEFixture/${JE_HASH}-JEFixture.tar.xz" COPYONLY)
        endif()
    endif()
    if(JE_URL)
        if(JE_CASE STREQUAL "fetch_patch")
            o3de_fetch_content(JEFixture URL "${JE_URL}" URL_HASH "${JE_HASH}" NO_ADD_SUBDIR
                PATCH_COMMAND "${CMAKE_COMMAND}" -E touch "${JE_WORK}/forbidden-hook")
        elseif(JE_CASE STREQUAL "fetch_download_dir")
            o3de_fetch_content(JEFixture URL "${JE_URL}" URL_HASH "${JE_HASH}" NO_ADD_SUBDIR
                DOWNLOAD_DIR "${JE_WORK}/forwarded download")
        elseif(JE_CASE STREQUAL "fetch_flags")
            o3de_fetch_content(JEFixture URL "${JE_URL}" URL_HASH "${JE_HASH}"
                SOURCE_SUBDIR "no-add-subdir" SYSTEM EXCLUDE_FROM_ALL)
        else()
            o3de_fetch_content(JEFixture URL "${JE_URL}" URL_HASH "${JE_HASH}"
                GIT "https://invalid.example/fixture.git" GIT_HASH "test-pin" NO_ADD_SUBDIR)
        endif()
    else()
        o3de_fetch_content(JEFixture GIT "https://invalid.example/fixture.git" GIT_HASH "test-pin" NO_ADD_SUBDIR)
    endif()
    if(JE_CASE STREQUAL "git")
        message(FATAL_ERROR "JE test: Git fallback was not rejected")
    endif()
    FetchContent_MakeAvailable(JEFixture)
    FetchContent_GetProperties(JEFixture SOURCE_DIR JE_FETCH_SOURCE)
    if(NOT EXISTS "${JE_FETCH_SOURCE}/payload.txt")
        message(FATAL_ERROR "JE test: FetchContent did not expose the local payload")
    endif()
else()
    ly_associate_package(PACKAGE_NAME JEFixture TARGETS JEFixture PACKAGE_HASH "${JE_HASH}")
    if(JE_CASE STREQUAL "cached")
        file(MAKE_DIRECTORY "${JE_WORK}/cache")
        file(COPY "${JE_SOURCE}/JEFixture.tar.xz" DESTINATION "${JE_WORK}/cache")
    elseif(JE_CASE STREQUAL "corrupt")
        file(MAKE_DIRECTORY "${JE_WORK}/cache")
        file(WRITE "${JE_WORK}/cache/JEFixture.tar.xz" "wrong hash")
    endif()
    ly_enable_package(JEFixture)
    if(NOT EXISTS "${JE_WORK}/unpack/JEFixture/payload.txt")
        message(FATAL_ERROR "JE test: local package was not installed")
    endif()
    file(READ "${JE_WORK}/unpack/JEFixture/payload.txt" JE_PAYLOAD)
    if(NOT JE_PAYLOAD STREQUAL "JE offline fixture\n")
        message(FATAL_ERROR "JE test: installed payload differs")
    endif()
    # Reuse the extracted package with no sources, then restore a removed payload from cache.
    set(LY_PACKAGE_SERVER_URLS "")
    set_property(GLOBAL PROPERTY LY_JEFixture_VALIDATED)
    ly_enable_package(JEFixture)
    file(REMOVE "${JE_WORK}/unpack/JEFixture/payload.txt")
    set(LY_PACKAGE_VALIDATE_CONTENTS TRUE)
    set_property(GLOBAL PROPERTY LY_JEFixture_VALIDATED)
    ly_enable_package(JEFixture)
    if(NOT EXISTS "${JE_WORK}/unpack/JEFixture/payload.txt")
        message(FATAL_ERROR "JE test: incomplete extracted package was not restored from cache")
    endif()
endif()
