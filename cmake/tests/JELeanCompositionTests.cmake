cmake_minimum_required(VERSION 3.24)
get_filename_component(JE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT JE_TEST_OUTPUT OR NOT IS_ABSOLUTE "${JE_TEST_OUTPUT}")
    message(FATAL_ERROR "Set JE_TEST_OUTPUT to a dedicated absolute evidence directory")
endif()
if(NOT JE_SUBDIRECTORIES_SOURCE)
    set(JE_SUBDIRECTORIES_SOURCE "${JE_ROOT}/cmake/Subdirectories.cmake")
endif()
if(NOT IS_ABSOLUTE "${JE_SUBDIRECTORIES_SOURCE}" OR NOT EXISTS "${JE_SUBDIRECTORIES_SOURCE}")
    message(FATAL_ERROR "JE_SUBDIRECTORIES_SOURCE must be an existing absolute production source path")
endif()
string(TIMESTAMP JE_RUN "%Y%m%d-%H%M%S")
string(RANDOM LENGTH 8 ALPHABET 0123456789abcdef JE_SUFFIX)
set(JE_RUN "${JE_TEST_OUTPUT}/${JE_RUN}-${JE_SUFFIX}")
file(MAKE_DIRECTORY "${JE_RUN}")
set(JE_FAILURES "")
foreach(JE_CASE composition selected_nvcloth user_nvcloth child_only child_depends_owner cached missing cycle)
    execute_process(COMMAND "${CMAKE_COMMAND}"
        "-DJE_ROOT:PATH=${JE_ROOT}" "-DJE_SUBDIRECTORIES_SOURCE:FILEPATH=${JE_SUBDIRECTORIES_SOURCE}"
        "-DJE_FIXTURE_ROOT:PATH=${JE_RUN}/${JE_CASE}/fixtures" "-DJE_CASE:STRING=${JE_CASE}"
        -S "${CMAKE_CURRENT_LIST_DIR}/JELeanCompositionFixture" -B "${JE_RUN}/${JE_CASE}/build"
        RESULT_VARIABLE JE_RESULT OUTPUT_VARIABLE JE_STDOUT ERROR_VARIABLE JE_STDERR)
    set(JE_LOG "${JE_STDOUT}\n${JE_STDERR}")
    file(WRITE "${JE_RUN}/${JE_CASE}/result.log" "exit=${JE_RESULT}\n${JE_LOG}")
    if(JE_CASE STREQUAL "missing")
        if(JE_RESULT EQUAL 0 OR NOT JE_LOG MATCHES "Unable to locate gem path for Gem.*MissingRequired")
            list(APPEND JE_FAILURES "${JE_CASE}")
        endif()
    elseif(JE_CASE STREQUAL "cycle")
        if(JE_RESULT EQUAL 0 OR NOT JE_LOG MATCHES "a cycle was detected")
            list(APPEND JE_FAILURES "${JE_CASE}")
        endif()
    elseif(NOT JE_RESULT EQUAL 0 OR NOT JE_LOG MATCHES "JE composition verified: ${JE_CASE}")
        list(APPEND JE_FAILURES "${JE_CASE}")
    endif()
endforeach()
if(JE_FAILURES)
    message(FATAL_ERROR "JE lean composition failures: ${JE_FAILURES}; evidence ${JE_RUN}")
endif()
message(STATUS "JE lean composition 8 cases verified; evidence ${JE_RUN}")
