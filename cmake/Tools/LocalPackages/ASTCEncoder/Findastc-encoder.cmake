include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_ASTC_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_ASTC_ROOT)
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local ASTC package requires Windows x64")
endif()
set(astc-encoder_VERSION 3.2.0)
set(astc-encoder_INCLUDE_DIR "${JE_ASTC_ROOT}/astc-encoder/include")
set(astc-encoder_LIBRARY_DIR "${JE_ASTC_ROOT}/astc-encoder/bin")
set(astc-encoder_LIBRARY_RELEASE "${astc-encoder_LIBRARY_DIR}/Release/astcenc-sse4.1-static.lib")
set(astc-encoder_LIBRARY_DEBUG "${astc-encoder_LIBRARY_DIR}/Debug/astcenc-sse4.1-static.lib")
foreach(JE_PATH IN ITEMS astc-encoder_INCLUDE_DIR astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG)
    JE_python_require_local_path(${JE_PATH})
endforeach()
# This API has no version macro. Bind the reported source-project version to its exact header bytes.
JE_python_verify_file("${astc-encoder_INCLUDE_DIR}/astcenc.h" "a19c5a0ba650eb7f61c24b29673eee78b0d6f72b5b17426cfe349bd9f82967aa" "ASTC 3.2 API header")
foreach(JE_LIBRARY IN ITEMS astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG)
    if(NOT EXISTS "${${JE_LIBRARY}}" OR IS_DIRECTORY "${${JE_LIBRARY}}")
        message(FATAL_ERROR "JE ASTC package: required local library missing: ${${JE_LIBRARY}}")
    endif()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(astc-encoder REQUIRED_VARS astc-encoder_INCLUDE_DIR astc-encoder_LIBRARY_RELEASE astc-encoder_LIBRARY_DEBUG VERSION_VAR astc-encoder_VERSION)
if(NOT TARGET 3rdParty::astc-encoder)
    add_library(3rdParty::astc-encoder STATIC IMPORTED GLOBAL)
    set_target_properties(3rdParty::astc-encoder PROPERTIES IMPORTED_LOCATION "${astc-encoder_LIBRARY_RELEASE}" IMPORTED_LOCATION_DEBUG "${astc-encoder_LIBRARY_DEBUG}")
    if(COMMAND ly_target_include_system_directories)
        ly_target_include_system_directories(TARGET 3rdParty::astc-encoder INTERFACE "${astc-encoder_INCLUDE_DIR}")
    else()
        target_include_directories(3rdParty::astc-encoder SYSTEM INTERFACE "${astc-encoder_INCLUDE_DIR}")
    endif()
endif()
