include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
JE_python_require_local_path(JE_ASTC_WORK)
get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_ASTC_WORK}" NORMALIZE JE_WORK_IN_BUILD)
if(NOT JE_WORK_IN_BUILD OR JE_ASTC_WORK STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE ASTC patch: private work must be beneath this checkout/build")
endif()
JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/astc-encoder-3.2-rev1.patch" "88e0389289a28db8d937842d890a7ec4953d2295c263997236b05be4b3b5bd00" "original ASTC recipe patch")
JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json" "1d45acd2e7674fdb62afd8187c5ff7d41c72590cd359f84ce518cad5e3ab2dca" "ASTC patch manifest")
file(READ "${CMAKE_CURRENT_LIST_DIR}/PatchHunks.json" JE_PATCH)
# Validate all original bytes, contexts, post-hashes and inverses before either write.
foreach(JE_INDEX RANGE 0 1)
    string(JSON JE_PATH GET "${JE_PATCH}" files ${JE_INDEX} path)
    if(NOT JE_PATH STREQUAL "Source/CMakeLists.txt" AND NOT JE_PATH STREQUAL "Source/cmake_core.cmake")
        message(FATAL_ERROR "JE ASTC patch: unexpected source path")
    endif()
    string(JSON JE_BEFORE_SHA GET "${JE_PATCH}" files ${JE_INDEX} beforeSHA)
    string(JSON JE_AFTER_SHA GET "${JE_PATCH}" files ${JE_INDEX} afterSHA)
    JE_python_verify_file("${JE_ASTC_WORK}/${JE_PATH}" "${JE_BEFORE_SHA}" "ASTC pristine patch input")
    file(READ "${JE_ASTC_WORK}/${JE_PATH}" JE_BEFORE)
    set(JE_AFTER "${JE_BEFORE}")
    string(JSON JE_COUNT LENGTH "${JE_PATCH}" files ${JE_INDEX} hunks)
    math(EXPR JE_LAST "${JE_COUNT} - 1")
    foreach(JE_HUNK RANGE 0 ${JE_LAST})
        string(JSON JE_OLD GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} before)
        string(JSON JE_NEW GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} after)
        string(FIND "${JE_AFTER}" "${JE_OLD}" JE_POSITION)
        if(JE_POSITION LESS 0)
            message(FATAL_ERROR "JE ASTC patch: exact hunk context missing")
        endif()
        math(EXPR JE_NEXT "${JE_POSITION} + 1")
        string(SUBSTRING "${JE_AFTER}" ${JE_NEXT} -1 JE_REMAINDER)
        string(FIND "${JE_REMAINDER}" "${JE_OLD}" JE_DUPLICATE)
        if(NOT JE_DUPLICATE EQUAL -1)
            message(FATAL_ERROR "JE ASTC patch: hunk context is not unique")
        endif()
        string(REPLACE "${JE_OLD}" "${JE_NEW}" JE_AFTER "${JE_AFTER}")
    endforeach()
    set(JE_INVERSE "${JE_AFTER}")
    foreach(JE_HUNK RANGE ${JE_LAST} 0 -1)
        string(JSON JE_OLD GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} before)
        string(JSON JE_NEW GET "${JE_PATCH}" files ${JE_INDEX} hunks ${JE_HUNK} after)
        string(REPLACE "${JE_NEW}" "${JE_OLD}" JE_INVERSE "${JE_INVERSE}")
    endforeach()
    string(SHA256 JE_ACTUAL_AFTER "${JE_AFTER}")
    string(TOLOWER "${JE_AFTER_SHA}" JE_EXPECTED_AFTER)
    if(NOT JE_INVERSE STREQUAL JE_BEFORE OR NOT JE_ACTUAL_AFTER STREQUAL JE_EXPECTED_AFTER)
        message(FATAL_ERROR "JE ASTC patch: post-hash or exact inverse mismatch")
    endif()
    set(JE_PATCH_PATH_${JE_INDEX} "${JE_PATH}")
    set(JE_PATCH_TEXT_${JE_INDEX} "${JE_AFTER}")
    set(JE_PATCH_SHA_${JE_INDEX} "${JE_EXPECTED_AFTER}")
endforeach()
foreach(JE_INDEX RANGE 0 1)
    file(CONFIGURE OUTPUT "${JE_ASTC_WORK}/${JE_PATCH_PATH_${JE_INDEX}}" CONTENT "${JE_PATCH_TEXT_${JE_INDEX}}" @ONLY NEWLINE_STYLE UNIX)
    JE_python_verify_file("${JE_ASTC_WORK}/${JE_PATCH_PATH_${JE_INDEX}}" "${JE_PATCH_SHA_${JE_INDEX}}" "ASTC patched raw bytes")
endforeach()
