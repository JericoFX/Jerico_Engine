cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
set(JE_INPUT_NAMES SOURCE_ARCHIVE SOURCE_SHA256 SOURCE_URL PERL_ARCHIVE PERL_ROOT PERL_MANIFEST VS_ROOT NASM OUTPUT)
foreach(JE_NAME IN LISTS JE_INPUT_NAMES)
    if(NOT DEFINED JE_OPENSSL_${JE_NAME} OR "${JE_OPENSSL_${JE_NAME}}" STREQUAL "")
        message(FATAL_ERROR "JE local OpenSSL: JE_OPENSSL_${JE_NAME} is required")
    endif()
endforeach()
foreach(JE_NAME IN ITEMS SOURCE_ARCHIVE PERL_ARCHIVE PERL_ROOT PERL_MANIFEST VS_ROOT NASM OUTPUT)
    JE_python_require_local_path(JE_OPENSSL_${JE_NAME})
    # These values enter a quoted native batch file; expansion characters are unsupported.
    if("${JE_OPENSSL_${JE_NAME}}" MATCHES "[%!^&|<>\";\r\n]")
        message(FATAL_ERROR "JE local OpenSSL: unsupported batch path characters in ${JE_NAME}")
    endif()
endforeach()
get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_OPENSSL_OUTPUT}" NORMALIZE JE_OUTPUT_IN_BUILD)
if(NOT JE_OUTPUT_IN_BUILD OR JE_OPENSSL_OUTPUT STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE local OpenSSL: output must be beneath this checkout/build")
endif()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "JE local OpenSSL requires native Windows MSVC x64")
endif()
if(EXISTS "${JE_OPENSSL_OUTPUT}")
    message(FATAL_ERROR "JE local OpenSSL: output must be new; existing outputs are preserved")
endif()
set(JE_SOURCE_COMMIT "ca2e0784d2c38edcefd5d68028f4d954bd8faddb")
set(JE_SOURCE_SHA "9384a2b0570dd80358841464677115df785edb941c71211f75076d72fe6b438f")
set(JE_SOURCE_URL "https://www.openssl.org/source/old/1.1.1/openssl-1.1.1o.tar.gz")
string(TOLOWER "${JE_OPENSSL_SOURCE_SHA256}" JE_DECLARED_SOURCE_SHA)
if(NOT JE_DECLARED_SOURCE_SHA STREQUAL JE_SOURCE_SHA OR NOT JE_OPENSSL_SOURCE_URL STREQUAL JE_SOURCE_URL)
    message(FATAL_ERROR "JE local OpenSSL: source URL/SHA256 must match the audited 1.1.1o release archive")
endif()
JE_python_verify_file("${JE_OPENSSL_SOURCE_ARCHIVE}" "${JE_SOURCE_SHA}" "OpenSSL source archive")
file(SHA512 "${JE_OPENSSL_SOURCE_ARCHIVE}" JE_SOURCE_SHA512)
if(NOT JE_SOURCE_SHA512 STREQUAL "75b2f1499cb4640229eb6cd35d85cbff2e19db17b959ac4d04b60f1b395b73567f9003521452a0fcfeea9b31b26de0a7bccf476ecf9caae02298f3647cfb7e23")
    message(FATAL_ERROR "JE local OpenSSL: source SHA512 mismatch")
endif()
set(JE_PERL_ARCHIVE_SHA "6a081a811781c30aca51dbc036afd93092af91e3297901f02c17043795a10690")
set(JE_PERL_MANIFEST_SHA "fb0cc5933d7f126362fd1f2cd6febfba1d8899fe6dbd5288090637947476052a")
JE_python_verify_file("${JE_OPENSSL_PERL_ARCHIVE}" "${JE_PERL_ARCHIVE_SHA}" "portable Perl archive")
JE_python_verify_file("${JE_OPENSSL_PERL_MANIFEST}" "${JE_PERL_MANIFEST_SHA}" "portable Perl manifest")
set(JE_VCVARS "${JE_OPENSSL_VS_ROOT}/VC/Auxiliary/Build/vcvarsall.bat")
set(JE_MSVC_BIN "${JE_OPENSSL_VS_ROOT}/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64")
set(JE_CL "${JE_MSVC_BIN}/cl.exe")
set(JE_NMAKE "${JE_MSVC_BIN}/nmake.exe")
JE_python_verify_file("${JE_VCVARS}" "ee67e4181ae2578b7842f9f1549a7f66e2166638fa544ce6838d9e9033a02275" "MSVC vcvarsall")
JE_python_verify_file("${JE_CL}" "88c8344236a27a6e727e0a8edc49aaa2690bdc7a9464b9d18cc7abe70a9f1c0d" "MSVC x64 compiler")
JE_python_verify_file("${JE_NMAKE}" "b05f089f67dba8df1d7cc38798b71e62a6ce8881b234dcfc80a657264597626c" "MSVC nmake")
set(JE_NASM_SHA "991775152cadbc85caf05da348ea583145ec9126a0a6f15f20e25896fcd0cd41")
JE_python_verify_file("${JE_OPENSSL_NASM}" "${JE_NASM_SHA}" "NASM executable")
set(JE_POWERSHELL "$ENV{SystemRoot}/System32/WindowsPowerShell/v1.0/powershell.exe")
JE_python_require_local_path(JE_POWERSHELL)
if(NOT EXISTS "${JE_POWERSHELL}")
    message(FATAL_ERROR "JE local OpenSSL: native PowerShell is missing")
endif()
# Full manifest verification precedes all output creation and tool execution.
execute_process(COMMAND "${JE_POWERSHELL}" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass
    -File "${CMAKE_CURRENT_LIST_DIR}/VerifyPerlInput.ps1" -Root "${JE_OPENSSL_PERL_ROOT}" -Manifest "${JE_OPENSSL_PERL_MANIFEST}"
    RESULT_VARIABLE JE_PERL_VERIFY_RESULT OUTPUT_VARIABLE JE_PERL_VERIFY_OUTPUT ERROR_VARIABLE JE_PERL_VERIFY_ERROR)
if(NOT JE_PERL_VERIFY_RESULT EQUAL 0)
    message(FATAL_ERROR "JE local OpenSSL: portable Perl manifest verification failed (${JE_PERL_VERIFY_RESULT}): ${JE_PERL_VERIFY_ERROR}")
endif()
set(JE_WORK "${JE_OPENSSL_OUTPUT}/source-work/openssl-1.1.1o")
set(JE_INSTALL "${JE_OPENSSL_OUTPUT}/install")
set(JE_TOOL_BIN "${JE_OPENSSL_OUTPUT}/tool-bin")
set(JE_STAGE "${JE_OPENSSL_OUTPUT}/stage")
file(MAKE_DIRECTORY "${JE_OPENSSL_OUTPUT}/source-work" "${JE_TOOL_BIN}")
file(WRITE "${JE_OPENSSL_OUTPUT}/perl-manifest-verification.txt" "${JE_PERL_VERIFY_OUTPUT}")
file(ARCHIVE_EXTRACT INPUT "${JE_OPENSSL_SOURCE_ARCHIVE}" DESTINATION "${JE_OPENSSL_OUTPUT}/source-work")
configure_file("${JE_OPENSSL_NASM}" "${JE_TOOL_BIN}/nasm.exe" COPYONLY)
# Original vcpkg header transformations have no matching inputs in this exact release.
# Keep that strict, measured no-op; adding includes would introduce a new source patch.
JE_python_verify_file("${JE_WORK}/include/openssl/dtls1.h" "7304f17cc9998bd7c16539ae9a5ea545f2e0c64086d5e688caba104b6a7ffecc" "dtls1.h unmodified input")
JE_python_verify_file("${JE_WORK}/include/openssl/rand.h" "5a91abcbdd14dcf2fc62761ccc58ee9407274ea558c292fa77ad625204ac2bd7" "rand.h unmodified input")
file(READ "${JE_WORK}/include/openssl/dtls1.h" JE_DTLS_HEADER)
file(READ "${JE_WORK}/include/openssl/rand.h" JE_RAND_HEADER)
string(FIND "${JE_DTLS_HEADER}" "<winsock.h>" JE_DTLS_MATCH)
string(FIND "${JE_RAND_HEADER}" "#  include <windows.h>" JE_RAND_MATCH)
if(NOT JE_DTLS_MATCH EQUAL -1 OR NOT JE_RAND_MATCH EQUAL -1)
    message(FATAL_ERROR "JE local OpenSSL: original header-patch preconditions changed")
endif()
# Save literal local inputs for focused negative-guard replay by the validation owner.
file(WRITE "${JE_OPENSSL_OUTPUT}/producer-inputs.cmake" "# Audited local producer inputs; no acquisition.\n")
foreach(JE_NAME IN LISTS JE_INPUT_NAMES)
    file(APPEND "${JE_OPENSSL_OUTPUT}/producer-inputs.cmake" "set(JE_OPENSSL_${JE_NAME} [==[${JE_OPENSSL_${JE_NAME}}]==])\n")
endforeach()
# Convert batch substitutions to native paths without changing CMake's canonical paths.
foreach(JE_NAME IN ITEMS JE_VCVARS JE_MSVC_BIN JE_CL JE_NMAKE JE_TOOL_BIN JE_WORK JE_INSTALL JE_OPENSSL_OUTPUT JE_OPENSSL_PERL_ROOT)
    set(JE_CANONICAL_${JE_NAME} "${${JE_NAME}}")
    # Keep raw native separators; the batch template supplies its own quotes.
    string(REPLACE "/" "\\" ${JE_NAME} "${${JE_NAME}}")
endforeach()
configure_file("${CMAKE_CURRENT_LIST_DIR}/RunOpenSSLBuild.cmd.in" "${JE_OPENSSL_OUTPUT}/build-openssl.cmd" @ONLY)
foreach(JE_NAME IN ITEMS JE_VCVARS JE_MSVC_BIN JE_CL JE_NMAKE JE_TOOL_BIN JE_WORK JE_INSTALL JE_OPENSSL_OUTPUT JE_OPENSSL_PERL_ROOT)
    set(${JE_NAME} "${JE_CANONICAL_${JE_NAME}}")
endforeach()
string(REPLACE "/" "\\" JE_CMD "$ENV{SystemRoot}/System32/cmd.exe")
string(REPLACE "/" "\\" JE_BATCH "${JE_OPENSSL_OUTPUT}/build-openssl.cmd")
execute_process(COMMAND "${JE_CMD}" /d /c "${JE_BATCH}"
    WORKING_DIRECTORY "${JE_WORK}" RESULT_VARIABLE JE_BUILD_RESULT
    OUTPUT_FILE "${JE_OPENSSL_OUTPUT}/build.stdout.log" ERROR_FILE "${JE_OPENSSL_OUTPUT}/build.stderr.log")
if(NOT JE_BUILD_RESULT EQUAL 0)
    message(FATAL_ERROR "JE local OpenSSL: native build failed (${JE_BUILD_RESULT}); outputs retained")
endif()
foreach(JE_LIBRARY IN ITEMS libcrypto.lib libssl.lib)
    if(NOT EXISTS "${JE_INSTALL}/lib/${JE_LIBRARY}")
        message(FATAL_ERROR "JE local OpenSSL: expected static archive ${JE_LIBRARY} is missing")
    endif()
endforeach()
file(READ "${JE_WORK}/Makefile" JE_MAKEFILE)
if(NOT JE_MAKEFILE MATCHES "/MT" OR NOT JE_MAKEFILE MATCHES "/Zl" OR JE_MAKEFILE MATCHES "/MD")
    message(FATAL_ERROR "JE local OpenSSL: generated makefile does not preserve static /MT /Zl flags")
endif()
file(MAKE_DIRECTORY "${JE_STAGE}/OpenSSL/lib" "${JE_STAGE}/LICENSES/OpenSSL")
file(COPY "${JE_INSTALL}/include" DESTINATION "${JE_STAGE}/OpenSSL")
file(COPY "${JE_INSTALL}/lib/libcrypto.lib" "${JE_INSTALL}/lib/libssl.lib" DESTINATION "${JE_STAGE}/OpenSSL/lib")
file(COPY "${JE_WORK}/LICENSE" DESTINATION "${JE_STAGE}/OpenSSL")
# Preserve full embedded library/assembly notices, including alternate licenses.
foreach(JE_DIR IN ITEMS crypto ssl engines include)
    file(GLOB_RECURSE JE_NOTICES LIST_DIRECTORIES FALSE RELATIVE "${JE_WORK}"
        "${JE_WORK}/${JE_DIR}/*.c" "${JE_WORK}/${JE_DIR}/*.h" "${JE_WORK}/${JE_DIR}/*.h.in"
        "${JE_WORK}/${JE_DIR}/*.pl" "${JE_WORK}/${JE_DIR}/*.S" "${JE_WORK}/${JE_DIR}/*.s"
        "${JE_WORK}/${JE_DIR}/*.asm" "${JE_WORK}/${JE_DIR}/*README*" "${JE_WORK}/${JE_DIR}/*LICENSE*")
    foreach(JE_NOTICE IN LISTS JE_NOTICES)
        configure_file("${JE_WORK}/${JE_NOTICE}" "${JE_STAGE}/LICENSES/OpenSSL/source/${JE_NOTICE}" COPYONLY)
    endforeach()
endforeach()
file(COPY "${JE_WORK}/LICENSE" "${JE_WORK}/ACKNOWLEDGEMENTS" "${JE_WORK}/AUTHORS" DESTINATION "${JE_STAGE}/LICENSES/OpenSSL")
file(COPY "${JE_WORK}/external/perl/Text-Template-1.46" DESTINATION "${JE_STAGE}/LICENSES/OpenSSL/build-tools")
configure_file("${CMAKE_CURRENT_LIST_DIR}/FindOpenSSL.cmake" "${JE_STAGE}/FindOpenSSL.cmake" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
file(COPY "${CMAKE_CURRENT_LIST_DIR}/NOTICE.txt" "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION "${JE_STAGE}")
file(COPY "${JE_ENGINE_ROOT}/LICENSE.txt" "${JE_ENGINE_ROOT}/LICENSE_APACHE2.TXT" "${JE_ENGINE_ROOT}/LICENSE_MIT.TXT" DESTINATION "${JE_STAGE}/LICENSES/O3DE")
file(WRITE "${JE_STAGE}/OpenSSL/JERecipe.json"
    "{\n  \"sourceVersion\": \"1.1.1o\", \"sourceCommit\": \"${JE_SOURCE_COMMIT}\",\n"
    "  \"sourceSHA512\": \"${JE_SOURCE_SHA512}\", \"architecture\": \"VC-WIN64A\", \"toolset\": \"v143/14.44.35207\",\n"
    "  \"compilerFlags\": [\"/MT\", \"/Zl\", \"-utf-8\", \"-FS\"],\n"
    "  \"configureFlags\": [\"enable-static-engine\", \"enable-capieng\", \"no-ssl2\", \"no-tests\", \"no-shared\"],\n"
    "  \"threads\": true, \"assembly\": true, \"consumerCRT\": \"/MD\", \"historicalABI\": \"not asserted\",\n"
    "  \"perlVersion\": \"5.42.3.1\", \"perlArchiveSHA256\": \"${JE_PERL_ARCHIVE_SHA}\", \"perlManifestSHA256\": \"${JE_PERL_MANIFEST_SHA}\",\n"
    "  \"nasmSHA256\": \"${JE_NASM_SHA}\", \"nasmPATH\": \"private verified executable only\",\n"
    "  \"headerPatches\": {\"applied\": false, \"dtls1Matches\": 0, \"randMatches\": 0,\n"
    "    \"reason\": \"Original recipe replacement inputs are absent in the pinned release\",\n"
    "    \"dtls1SHA256\": \"7304f17cc9998bd7c16539ae9a5ea545f2e0c64086d5e688caba104b6a7ffecc\",\n"
    "    \"randSHA256\": \"5a91abcbdd14dcf2fc62761ccc58ee9407274ea558c292fa77ad625204ac2bd7\"}\n}\n")
set(JE_PACKAGE_STAGE "${JE_STAGE}")
set(JE_PACKAGE_NAME "OpenSSL-1.1.1o-je-rev1-windows")
set(JE_PACKAGE_OUTPUT "${JE_OPENSSL_OUTPUT}/packages")
set(JE_PACKAGE_VERSION "1.1.1o")
set(JE_PACKAGE_SOURCE_COMMIT "${JE_SOURCE_COMMIT}")
set(JE_PACKAGE_LICENSE "OpenSSL AND SSLeay")
set(JE_PACKAGE_SOURCE_SHA256 "${JE_SOURCE_SHA}")
set(JE_PACKAGE_SOURCE_URL "${JE_SOURCE_URL}")
include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
