include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_OPENSSL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_OPENSSL_ROOT)
set(OPENSSL_INCLUDE_DIR "${JE_OPENSSL_ROOT}/OpenSSL/include")
set(OPENSSL_LIBS_DIR "${JE_OPENSSL_ROOT}/OpenSSL/lib")
set(OPENSSL_CRYPTO_LIBRARY "${OPENSSL_LIBS_DIR}/libcrypto.lib")
set(OPENSSL_SSL_LIBRARY "${OPENSSL_LIBS_DIR}/libssl.lib")
set(OPENSSL_VERSION "1.1.1o")
set(OPENSSL_VERSION_STRING "${OPENSSL_VERSION}")
set(OPENSSL_INCLUDE_DIRS "${OPENSSL_INCLUDE_DIR}")
set(OPENSSL_CRYPTO_LIBRARIES "${OPENSSL_CRYPTO_LIBRARY}")
set(OPENSSL_SSL_LIBRARIES "${OPENSSL_SSL_LIBRARY}")
set(OPENSSL_LIBRARIES "${OPENSSL_SSL_LIBRARY};${OPENSSL_CRYPTO_LIBRARY}")
set(JE_OPENSSL_FILES_VALID TRUE)
foreach(JE_FILE IN ITEMS "${OPENSSL_INCLUDE_DIR}/openssl/ssl.h" "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" "${OPENSSL_INCLUDE_DIR}/openssl/opensslconf.h" "${OPENSSL_CRYPTO_LIBRARY}" "${OPENSSL_SSL_LIBRARY}")
    JE_python_require_local_path(JE_FILE)
    if(NOT EXISTS "${JE_FILE}" OR IS_DIRECTORY "${JE_FILE}")
        set(JE_OPENSSL_FILES_VALID FALSE)
    endif()
endforeach()
if(JE_OPENSSL_FILES_VALID)
    file(READ "${OPENSSL_INCLUDE_DIR}/openssl/opensslv.h" JE_VERSION_HEADER)
    if(NOT JE_VERSION_HEADER MATCHES "OPENSSL_VERSION_NUMBER[ \t]+0x101010ffL")
        set(JE_OPENSSL_FILES_VALID FALSE)
    endif()
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(OpenSSL REQUIRED_VARS JE_OPENSSL_FILES_VALID OPENSSL_INCLUDE_DIR OPENSSL_CRYPTO_LIBRARY OPENSSL_SSL_LIBRARY VERSION_VAR OPENSSL_VERSION)
set(OPENSSL_FOUND "${OpenSSL_FOUND}")
if(NOT OpenSSL_FOUND)
    return()
endif()
if(NOT WIN32 OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local OpenSSL package requires Windows x64")
endif()
if(TARGET OpenSSL::Crypto OR TARGET OpenSSL::SSL OR TARGET 3rdParty::OpenSSL)
    foreach(JE_TARGET IN ITEMS OpenSSL::Crypto OpenSSL::SSL 3rdParty::OpenSSL)
        if(NOT TARGET ${JE_TARGET})
            message(FATAL_ERROR "JE local OpenSSL: partial existing provider")
        endif()
    endforeach()
    foreach(JE_KIND IN ITEMS Crypto SSL)
        get_target_property(JE_LOCATION OpenSSL::${JE_KIND} IMPORTED_LOCATION)
        get_target_property(JE_TYPE OpenSSL::${JE_KIND} TYPE)
        string(TOLOWER "${JE_KIND}" JE_LOWER_KIND)
        if(NOT JE_LOCATION STREQUAL "${OPENSSL_LIBS_DIR}/lib${JE_LOWER_KIND}.lib" OR NOT JE_TYPE STREQUAL "STATIC_LIBRARY")
            message(FATAL_ERROR "JE local OpenSSL: different existing provider")
        endif()
    endforeach()
    get_target_property(JE_ALIAS 3rdParty::OpenSSL ALIASED_TARGET)
    if(NOT JE_ALIAS STREQUAL "OpenSSL::SSL")
        message(FATAL_ERROR "JE local OpenSSL: different 3rdParty alias")
    endif()
    return()
endif()
add_library(OpenSSL::Crypto STATIC IMPORTED GLOBAL)
set_target_properties(OpenSSL::Crypto PROPERTIES IMPORTED_LOCATION "${OPENSSL_CRYPTO_LIBRARY}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}" INTERFACE_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES "ws2_32;gdi32;advapi32;crypt32;user32")
add_library(OpenSSL::SSL STATIC IMPORTED GLOBAL)
set_target_properties(OpenSSL::SSL PROPERTIES IMPORTED_LOCATION "${OPENSSL_SSL_LIBRARY}" INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}" INTERFACE_INCLUDE_DIRECTORIES "${OPENSSL_INCLUDE_DIR}" INTERFACE_LINK_LIBRARIES "OpenSSL::Crypto")
add_library(3rdParty::OpenSSL ALIAS OpenSSL::SSL)
