if(TARGET 3rdParty::ISPCTexComp)
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_ISPC_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_ISPC_LOCAL_ROOT)
if(NOT WIN32 AND NOT PAL_PLATFORM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "JE local ISPCTexComp package is Windows x64 only")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local ISPCTexComp package requires an x64 consumer")
endif()
set(ISPCTexComp_INCLUDE_DIR "${CMAKE_CURRENT_LIST_DIR}/ISPCTexComp/include")
set(ISPCTexComp_BINARY_DIR "${CMAKE_CURRENT_LIST_DIR}/ISPCTexComp/bin")
set(ISPCTexComp_LIBRARY "${ISPCTexComp_BINARY_DIR}/ispc_texcomp.lib")
set(ISPCTexComp_RUNTIME_DEPENDENCIES "${ISPCTexComp_BINARY_DIR}/ispc_texcomp.dll")
set(ISPCTexComp_VERSION_STRING "36b80aa")
foreach(JE_FILE IN ITEMS "${ISPCTexComp_INCLUDE_DIR}/ISPC/ispc_texcomp.h" "${ISPCTexComp_LIBRARY}" "${ISPCTexComp_RUNTIME_DEPENDENCIES}")
    JE_python_require_local_path(JE_FILE)
    if(NOT EXISTS "${JE_FILE}" OR IS_DIRECTORY "${JE_FILE}")
        message(FATAL_ERROR "JE local ISPCTexComp: required package file is missing: ${JE_FILE}")
    endif()
endforeach()
add_library(3rdParty::ISPCTexComp INTERFACE IMPORTED GLOBAL)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::ISPCTexComp INTERFACE "${ISPCTexComp_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::ISPCTexComp SYSTEM INTERFACE "${ISPCTexComp_INCLUDE_DIR}")
endif()
target_link_libraries(3rdParty::ISPCTexComp INTERFACE "${ISPCTexComp_LIBRARY}")
if(COMMAND ly_add_target_files)
    ly_add_target_files(TARGETS 3rdParty::ISPCTexComp FILES "${ISPCTexComp_RUNTIME_DEPENDENCIES}")
endif()
set(ISPCTexComp_FOUND TRUE)
