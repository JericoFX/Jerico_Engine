cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
set(JE_INPUT_NAMES SOURCE_ARCHIVE SOURCE_ROOT SOURCE_MANIFEST TOOL_ARCHIVE TOOL_ROOT TOOL_MANIFEST VS_ROOT POWERSHELL OUTPUT)
foreach(JE_NAME IN LISTS JE_INPUT_NAMES)
    JE_python_require_local_path(JE_ISPC_${JE_NAME})
    if("${JE_ISPC_${JE_NAME}}" MATCHES "[%!^&|<>\";\r\n]")
        message(FATAL_ERROR "JE ISPCTexComp: unsupported batch path characters in ${JE_NAME}")
    endif()
endforeach()
get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_ISPC_OUTPUT}" NORMALIZE JE_OUTPUT_IN_BUILD)
if(NOT JE_OUTPUT_IN_BUILD OR JE_ISPC_OUTPUT STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE ISPCTexComp: output must be beneath this checkout/build")
endif()
if(EXISTS "${JE_ISPC_OUTPUT}")
    message(FATAL_ERROR "JE ISPCTexComp: output must be new; previous outputs are preserved")
endif()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "JE ISPCTexComp: native Windows MSVC x64 is required")
endif()
set(JE_SOURCE_SHA "029373e6ec5b10d7e29eefdc5a231fb86c79b76a4a39c58c2727c6729de28ab7")
set(JE_TOOL_SHA "b34de2c36aff2afaa56b669ea41f9e614a045564ca74fc0b138e17ccea4880b7")
JE_python_verify_file("${JE_ISPC_SOURCE_ARCHIVE}" "${JE_SOURCE_SHA}" "pinned encoder archive")
JE_python_verify_file("${JE_ISPC_TOOL_ARCHIVE}" "${JE_TOOL_SHA}" "official ISPC 1.16.1 archive")
file(SIZE "${JE_ISPC_SOURCE_ARCHIVE}" JE_SOURCE_BYTES)
file(SIZE "${JE_ISPC_TOOL_ARCHIVE}" JE_TOOL_BYTES)
if(NOT JE_SOURCE_BYTES EQUAL 6435298 OR NOT JE_TOOL_BYTES EQUAL 44708214)
    message(FATAL_ERROR "JE ISPCTexComp: audited archive size mismatch")
endif()
JE_python_verify_file("${JE_ISPC_SOURCE_MANIFEST}" "57f92dec28e02ed21fc8d496b46668e9f7c8a2c687596197663ce3a8fe3a2b44" "immutable encoder manifest")
JE_python_verify_file("${JE_ISPC_TOOL_MANIFEST}" "c7b2d1e932455ea837bd824b8440dbd7c964a9ee2e5f5ae69e16833e37af7f6e" "immutable ISPC manifest")
set(JE_VCVARS "${JE_ISPC_VS_ROOT}/VC/Auxiliary/Build/vcvarsall.bat")
set(JE_MSBUILD "${JE_ISPC_VS_ROOT}/MSBuild/Current/Bin/amd64/MSBuild.exe")
set(JE_CL "${JE_ISPC_VS_ROOT}/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe")
JE_python_verify_file("${JE_VCVARS}" "ee67e4181ae2578b7842f9f1549a7f66e2166638fa544ce6838d9e9033a02275" "MSVC vcvarsall")
JE_python_verify_file("${JE_MSBUILD}" "58fbe0acac5265fe9a93acb291e1dbd50432c4ebf00ff9b9fb4c34bc0f247c73" "MSBuild x64")
JE_python_verify_file("${JE_CL}" "88c8344236a27a6e727e0a8edc49aaa2690bdc7a9464b9d18cc7abe70a9f1c0d" "MSVC x64 compiler")
JE_python_verify_file("${JE_ISPC_VS_ROOT}/MSBuild/Microsoft/VC/v170/Microsoft.Cl.Common.props"
    "9d9c3aa8770dfc7e7430b831252e1efbab0799c7ce0d25a03485ff506bed575b" "original Release /MD default")
JE_python_verify_file("${JE_ISPC_TOOL_ROOT}/bin/ispc.exe"
    "91f687613eff144125057463255d79db78960ed1f5fcd487411187f5a8e3323f" "external ISPC compiler")
JE_python_verify_file("${JE_ISPC_POWERSHELL}" "362a356ce7f0940ec74f73a8fc2c990a2cc24a38a11c90bbd8eca947110ad139" "audited PowerShell Core 7.6.5")
execute_process(COMMAND "${JE_ISPC_POWERSHELL}" -NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass
    -File "${CMAKE_CURRENT_LIST_DIR}/VerifyInputs.ps1"
    -SourceRoot "${JE_ISPC_SOURCE_ROOT}" -SourceManifest "${JE_ISPC_SOURCE_MANIFEST}"
    -ToolRoot "${JE_ISPC_TOOL_ROOT}" -ToolManifest "${JE_ISPC_TOOL_MANIFEST}"
    RESULT_VARIABLE JE_VERIFY_RESULT OUTPUT_VARIABLE JE_VERIFY_OUTPUT ERROR_VARIABLE JE_VERIFY_ERROR)
if(NOT JE_VERIFY_RESULT EQUAL 0)
    message(FATAL_ERROR "JE ISPCTexComp: immutable input verification failed (${JE_VERIFY_RESULT}): ${JE_VERIFY_ERROR}")
endif()
# Only the private copy receives generated kernel headers and objects.
set(JE_WORK "${JE_ISPC_OUTPUT}/source-work/encoder")
set(JE_BIN "${JE_ISPC_OUTPUT}/bin")
set(JE_INT "${JE_ISPC_OUTPUT}/obj")
set(JE_EMPTY_USER "${JE_ISPC_OUTPUT}/empty-user")
set(JE_EMPTY_PROPS "${JE_ISPC_OUTPUT}/NoOverrides.props")
set(JE_STAGE "${JE_ISPC_OUTPUT}/stage")
file(MAKE_DIRECTORY "${JE_WORK}" "${JE_WORK}/ISPC/win" "${JE_EMPTY_USER}")
file(COPY "${JE_ISPC_SOURCE_ROOT}/" DESTINATION "${JE_WORK}")
configure_file("${JE_ISPC_TOOL_ROOT}/bin/ispc.exe" "${JE_WORK}/ISPC/win/ispc.exe" COPYONLY)
file(WRITE "${JE_ISPC_OUTPUT}/input-verification.txt" "${JE_VERIFY_OUTPUT}")
file(CONFIGURE OUTPUT "${JE_EMPTY_PROPS}" CONTENT
    "<Project xmlns=\"http://schemas.microsoft.com/developer/msbuild/2003\" />\n" @ONLY NEWLINE_STYLE UNIX)
file(WRITE "${JE_ISPC_OUTPUT}/producer-inputs.cmake" "# Audited offline inputs.\n")
foreach(JE_NAME IN LISTS JE_INPUT_NAMES)
    file(APPEND "${JE_ISPC_OUTPUT}/producer-inputs.cmake" "set(JE_ISPC_${JE_NAME} [==[${JE_ISPC_${JE_NAME}}]==])\n")
endforeach()
foreach(JE_NAME IN ITEMS VCVARS MSBUILD WORK)
    string(REPLACE "/" "\\" JE_NATIVE_${JE_NAME} "${JE_${JE_NAME}}")
endforeach()
string(REPLACE "/" "\\" JE_NATIVE_OUTPUT "${JE_ISPC_OUTPUT}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/RunBuild.cmd.in" "${JE_ISPC_OUTPUT}/build.cmd" @ONLY)
# cmd.exe itself requires native separators, as established by the OpenSSL witness.
string(REPLACE "/" "\\" JE_CMD "$ENV{SystemRoot}/System32/cmd.exe")
string(REPLACE "/" "\\" JE_BATCH "${JE_ISPC_OUTPUT}/build.cmd")
execute_process(COMMAND "${JE_CMD}" /d /c "${JE_BATCH}" WORKING_DIRECTORY "${JE_WORK}/ispc_texcomp"
    RESULT_VARIABLE JE_BUILD_RESULT OUTPUT_FILE "${JE_ISPC_OUTPUT}/build.stdout.log" ERROR_FILE "${JE_ISPC_OUTPUT}/build.stderr.log")
if(NOT JE_BUILD_RESULT EQUAL 0)
    message(FATAL_ERROR "JE ISPCTexComp: original native project failed (${JE_BUILD_RESULT}); outputs retained")
endif()
foreach(JE_KERNEL IN ITEMS kernel kernel_astc)
    foreach(JE_SUFFIX IN ITEMS "" _sse2 _sse4 _avx _avx2)
        if(NOT EXISTS "${JE_BIN}/${JE_KERNEL}${JE_SUFFIX}.obj")
            message(FATAL_ERROR "JE ISPCTexComp: original multi-target kernel object is missing")
        endif()
    endforeach()
endforeach()
foreach(JE_FILE IN ITEMS ispc_texcomp.dll ispc_texcomp.lib)
    if(NOT EXISTS "${JE_BIN}/${JE_FILE}")
        message(FATAL_ERROR "JE ISPCTexComp: expected ${JE_FILE} is missing")
    endif()
endforeach()
file(MAKE_DIRECTORY "${JE_STAGE}/ISPCTexComp/include/ISPC" "${JE_STAGE}/ISPCTexComp/bin" "${JE_STAGE}/LICENSES/ISPCTexComp/source")
file(COPY "${JE_BIN}/ispc_texcomp.dll" "${JE_BIN}/ispc_texcomp.lib" DESTINATION "${JE_STAGE}/ISPCTexComp/bin")
configure_file("${JE_WORK}/ispc_texcomp/ispc_texcomp.h" "${JE_STAGE}/ISPCTexComp/include/ISPC/ispc_texcomp.h" COPYONLY)
file(COPY "${JE_WORK}/license.txt" DESTINATION "${JE_STAGE}/ISPCTexComp")
file(COPY "${JE_WORK}/ispc_texcomp/" DESTINATION "${JE_STAGE}/LICENSES/ISPCTexComp/source"
    FILES_MATCHING PATTERN "*.cpp" PATTERN "*.ispc" PATTERN "ispc_texcomp.h")
file(COPY "${JE_ISPC_TOOL_ROOT}/LICENSE.txt" "${JE_ISPC_TOOL_ROOT}/third-party-programs.txt" DESTINATION "${JE_STAGE}/LICENSES/ISPC-build-tool")
file(COPY "${JE_ENGINE_ROOT}/LICENSE.txt" "${JE_ENGINE_ROOT}/LICENSE_APACHE2.TXT" "${JE_ENGINE_ROOT}/LICENSE_MIT.TXT" DESTINATION "${JE_STAGE}/LICENSES/O3DE")
configure_file("${CMAKE_CURRENT_LIST_DIR}/FindISPCTexComp.cmake" "${JE_STAGE}/FindISPCTexComp.cmake" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
file(COPY "${CMAKE_CURRENT_LIST_DIR}/NOTICE.txt" "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION "${JE_STAGE}")
file(WRITE "${JE_STAGE}/ISPCTexComp/JERecipe.json"
    "{\n  \"sourceCommit\": \"36b80aac50ea401a9adde44d86712c2241b2acfd\", \"architecture\": \"x64\",\n"
    "  \"toolset\": \"v143/14.44.35207\", \"sdk\": \"10.0.26100.0\", \"CRT\": \"/MD Release\",\n"
    "  \"ISPC\": \"1.16.1\", \"toolArchiveSHA256\": \"${JE_TOOL_SHA}\", \"toolDigestAuthority\": \"local measurement; upstream digest unavailable\",\n"
    "  \"ISPCflags\": [\"-O2\", \"--target=sse2,sse4,avx,avx2\", \"--opt=fast-math\"],\n"
    "  \"sourcePatches\": false, \"historicalBinaryABI\": \"not asserted\", \"toolRedistributed\": false\n}\n")
set(JE_PACKAGE_STAGE "${JE_STAGE}")
set(JE_PACKAGE_NAME "ISPCTexComp-36b80aa-je-rev1-windows")
set(JE_PACKAGE_OUTPUT "${JE_ISPC_OUTPUT}/packages")
set(JE_PACKAGE_VERSION "36b80aa")
set(JE_PACKAGE_SOURCE_COMMIT "36b80aac50ea401a9adde44d86712c2241b2acfd")
set(JE_PACKAGE_LICENSE "MIT")
set(JE_PACKAGE_SOURCE_SHA256 "${JE_SOURCE_SHA}")
set(JE_PACKAGE_SOURCE_URL "https://codeload.github.com/GameTechDev/ISPCTextureCompressor/tar.gz/${JE_PACKAGE_SOURCE_COMMIT}")
include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
