# Package an explicitly staged local dependency. No acquisition or installation.
# Required -D arguments: JE_PACKAGE_STAGE, NAME, OUTPUT, VERSION, SOURCE_COMMIT,
# LICENSE, SOURCE_SHA256 and SOURCE_URL (each prefixed with JE_PACKAGE_).
cmake_minimum_required(VERSION 3.24)

foreach(JE_ARGUMENT IN ITEMS STAGE NAME OUTPUT VERSION SOURCE_COMMIT LICENSE SOURCE_SHA256 SOURCE_URL)
    if(NOT DEFINED JE_PACKAGE_${JE_ARGUMENT} OR "${JE_PACKAGE_${JE_ARGUMENT}}" STREQUAL "")
        message(FATAL_ERROR "JE local package: JE_PACKAGE_${JE_ARGUMENT} is required")
    endif()
endforeach()
if(NOT JE_PACKAGE_NAME MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*$")
    message(FATAL_ERROR "JE local package: invalid package name")
endif()
string(LENGTH "${JE_PACKAGE_SOURCE_SHA256}" JE_HASH_LENGTH)
string(LENGTH "${JE_PACKAGE_SOURCE_COMMIT}" JE_COMMIT_LENGTH)
if(NOT JE_HASH_LENGTH EQUAL 64 OR NOT JE_PACKAGE_SOURCE_SHA256 MATCHES "^[0-9A-Fa-f]+$"
    OR NOT JE_COMMIT_LENGTH EQUAL 40 OR NOT JE_PACKAGE_SOURCE_COMMIT MATCHES "^[0-9A-Fa-f]+$")
    message(FATAL_ERROR "JE local package: source commit and archive SHA256 must be explicit full hashes")
endif()

function(JE_require_local_package_directory JE_PATH JE_LABEL)
    file(TO_CMAKE_PATH "${JE_PATH}" JE_LOCAL_PATH)
    if(NOT IS_ABSOLUTE "${JE_LOCAL_PATH}" OR JE_LOCAL_PATH MATCHES "^//|://")
        message(FATAL_ERROR "JE local package: ${JE_LABEL} must be an absolute local directory")
    endif()
    # Check existing ancestors as well as the leaf; do not follow obvious links.
    set(JE_ANCESTOR "${JE_LOCAL_PATH}")
    while(NOT JE_ANCESTOR STREQUAL "")
        if(IS_SYMLINK "${JE_ANCESTOR}")
            message(FATAL_ERROR "JE local package: symlink path rejected for ${JE_LABEL}")
        endif()
        get_filename_component(JE_PARENT "${JE_ANCESTOR}" DIRECTORY)
        if(JE_PARENT STREQUAL JE_ANCESTOR)
            break()
        endif()
        set(JE_ANCESTOR "${JE_PARENT}")
    endwhile()
endfunction()

JE_require_local_package_directory("${JE_PACKAGE_STAGE}" "JE_PACKAGE_STAGE")
JE_require_local_package_directory("${JE_PACKAGE_OUTPUT}" "JE_PACKAGE_OUTPUT")
if(NOT IS_DIRECTORY "${JE_PACKAGE_STAGE}")
    message(FATAL_ERROR "JE local package: staged payload directory is missing")
endif()
if(EXISTS "${JE_PACKAGE_OUTPUT}" AND NOT IS_DIRECTORY "${JE_PACKAGE_OUTPUT}")
    message(FATAL_ERROR "JE local package: output is not a directory")
endif()
cmake_path(SET JE_STAGE_NORMAL NORMALIZE "${JE_PACKAGE_STAGE}")
cmake_path(IS_PREFIX JE_STAGE_NORMAL "${JE_PACKAGE_OUTPUT}" NORMALIZE JE_OUTPUT_IN_STAGE)
if(JE_OUTPUT_IN_STAGE)
    message(FATAL_ERROR "JE local package: output cannot be inside the staged payload")
endif()
foreach(JE_RESERVED IN ITEMS PackageInfo.json SHA256SUMS)
    if(EXISTS "${JE_PACKAGE_STAGE}/${JE_RESERVED}")
        message(FATAL_ERROR "JE local package: stage must contain only payload, not ${JE_RESERVED}")
    endif()
endforeach()

file(GLOB_RECURSE JE_STAGE_ENTRIES LIST_DIRECTORIES TRUE RELATIVE "${JE_PACKAGE_STAGE}" "${JE_PACKAGE_STAGE}/*")
if(NOT JE_STAGE_ENTRIES)
    message(FATAL_ERROR "JE local package: stage is empty")
endif()
foreach(JE_ENTRY IN LISTS JE_STAGE_ENTRIES)
    if(IS_SYMLINK "${JE_PACKAGE_STAGE}/${JE_ENTRY}")
        message(FATAL_ERROR "JE local package: staged symlink rejected: ${JE_ENTRY}")
    endif()
endforeach()

set(JE_PAYLOAD_ROOT "${JE_PACKAGE_OUTPUT}/${JE_PACKAGE_NAME}.contents")
set(JE_ARCHIVE "${JE_PACKAGE_OUTPUT}/${JE_PACKAGE_NAME}.tar.xz")
set(JE_ARCHIVE_HASH "${JE_ARCHIVE}.SHA256SUMS")
set(JE_ARCHIVE_FILE_LIST "${JE_PACKAGE_OUTPUT}/${JE_PACKAGE_NAME}.files")
foreach(JE_ARTIFACT IN ITEMS "${JE_PAYLOAD_ROOT}" "${JE_ARCHIVE}" "${JE_ARCHIVE_HASH}" "${JE_ARCHIVE_FILE_LIST}")
    if(EXISTS "${JE_ARTIFACT}" OR IS_SYMLINK "${JE_ARTIFACT}")
        message(FATAL_ERROR "JE local package: output already exists: ${JE_ARTIFACT}")
    endif()
endforeach()

function(JE_json_string JE_TEXT JE_OUTPUT)
    string(REPLACE "\\" "\\\\" JE_ESCAPED "${JE_TEXT}")
    string(REPLACE "\"" "\\\"" JE_ESCAPED "${JE_ESCAPED}")
    string(REPLACE "\n" "\\n" JE_ESCAPED "${JE_ESCAPED}")
    string(REPLACE "\r" "\\r" JE_ESCAPED "${JE_ESCAPED}")
    string(REPLACE "\t" "\\t" JE_ESCAPED "${JE_ESCAPED}")
    set(${JE_OUTPUT} "\"${JE_ESCAPED}\"" PARENT_SCOPE)
endfunction()

set(JE_INFO "{}")
string(JSON JE_INFO SET "${JE_INFO}" schemaVersion 1)
foreach(JE_FIELD IN ITEMS NAME VERSION LICENSE)
    string(TOLOWER "${JE_FIELD}" JE_KEY)
    JE_json_string("${JE_PACKAGE_${JE_FIELD}}" JE_VALUE)
    string(JSON JE_INFO SET "${JE_INFO}" "${JE_KEY}" "${JE_VALUE}")
endforeach()
set(JE_SOURCE_INFO "{}")
foreach(JE_FIELD IN ITEMS URL COMMIT SHA256)
    string(TOLOWER "${JE_FIELD}" JE_KEY)
    JE_json_string("${JE_PACKAGE_SOURCE_${JE_FIELD}}" JE_VALUE)
    string(JSON JE_SOURCE_INFO SET "${JE_SOURCE_INFO}" "${JE_KEY}" "${JE_VALUE}")
endforeach()
string(JSON JE_INFO SET "${JE_INFO}" source "${JE_SOURCE_INFO}")

file(MAKE_DIRECTORY "${JE_PAYLOAD_ROOT}")
file(COPY "${JE_PACKAGE_STAGE}/" DESTINATION "${JE_PAYLOAD_ROOT}")
file(WRITE "${JE_PAYLOAD_ROOT}/PackageInfo.json" "${JE_INFO}\n")
file(GLOB_RECURSE JE_PAYLOAD_FILES LIST_DIRECTORIES FALSE RELATIVE "${JE_PAYLOAD_ROOT}" "${JE_PAYLOAD_ROOT}/*")
list(SORT JE_PAYLOAD_FILES)
set(JE_CONTENT_HASHES "")
set(JE_ARCHIVE_FILES "")
foreach(JE_FILE IN LISTS JE_PAYLOAD_FILES)
    file(SHA256 "${JE_PAYLOAD_ROOT}/${JE_FILE}" JE_FILE_HASH)
    string(APPEND JE_CONTENT_HASHES "${JE_FILE_HASH} *${JE_FILE}\n")
    string(APPEND JE_ARCHIVE_FILES "--add-file=${JE_FILE}\n")
endforeach()
file(WRITE "${JE_PAYLOAD_ROOT}/SHA256SUMS" "${JE_CONTENT_HASHES}")
# A file list keeps large payloads below Windows' process argument length limit.
file(WRITE "${JE_ARCHIVE_FILE_LIST}" "${JE_ARCHIVE_FILES}SHA256SUMS\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cJf "${JE_ARCHIVE}" "--files-from=${JE_ARCHIVE_FILE_LIST}"
    WORKING_DIRECTORY "${JE_PAYLOAD_ROOT}" RESULT_VARIABLE JE_TAR_RESULT)
if(NOT JE_TAR_RESULT EQUAL 0)
    message(FATAL_ERROR "JE local package: archive creation failed (${JE_TAR_RESULT}); outputs retained")
endif()
file(SHA256 "${JE_ARCHIVE}" JE_ARCHIVE_SHA256)
file(WRITE "${JE_ARCHIVE_HASH}" "${JE_ARCHIVE_SHA256} *${JE_PACKAGE_NAME}.tar.xz\n")
message(STATUS "JE local package archive: ${JE_ARCHIVE}")
message(STATUS "JE local package SHA256: ${JE_ARCHIVE_SHA256}")
