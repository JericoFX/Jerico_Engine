# Local adaptation of package-system/libpng/FindPNG.cmake at 3p-package-source@70f0b7b5.
include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_PNG_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_PNG_LOCAL_ROOT)
if(NOT TARGET ZLIB::ZLIB)
    if(COMMAND ly_download_associated_package)
        ly_download_associated_package(ZLIB REQUIRED MODULE)
    else()
        JE_python_require_local_path(JE_ZLIB_PACKAGE_ROOT)
        if(NOT EXISTS "${JE_ZLIB_PACKAGE_ROOT}/FindZLIB.cmake")
            message(FATAL_ERROR "JE local PNG: explicit local JE_ZLIB_PACKAGE_ROOT is required")
        endif()
        list(PREPEND CMAKE_MODULE_PATH "${JE_ZLIB_PACKAGE_ROOT}")
    endif()
    find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
elseif(NOT DEFINED ZLIB_VERSION_STRING)
    find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
endif()
if(NOT TARGET ZLIB::ZLIB OR NOT ZLIB_VERSION_STRING VERSION_EQUAL "1.2.11")
    message(FATAL_ERROR "JE local PNG: zlib 1.2.11 target/version is required")
endif()
set(PNG_INCLUDE_DIRS "${JE_PNG_LOCAL_ROOT}/png/include")
set(PNG_INCLUDE_DIR "${PNG_INCLUDE_DIRS}")
set(PNG_LIB_DIRS "${JE_PNG_LOCAL_ROOT}/png/lib")
if(WIN32)
    set(PNG_LIBRARIES "${PNG_LIB_DIRS}/libpng16_static${CMAKE_STATIC_LIBRARY_SUFFIX}")
else()
    set(PNG_LIBRARIES "${PNG_LIB_DIRS}/${CMAKE_STATIC_LIBRARY_PREFIX}png16${CMAKE_STATIC_LIBRARY_SUFFIX}")
endif()
set(PNG_LIBRARY "${PNG_LIBRARIES}")
set(PNG_VERSION_STRING "1.6.37")
foreach(JE_PNG_HEADER IN ITEMS png.h pngconf.h pnglibconf.h)
    if(NOT EXISTS "${PNG_INCLUDE_DIR}/${JE_PNG_HEADER}")
        message(FATAL_ERROR "JE local PNG: staged header ${JE_PNG_HEADER} is missing")
    endif()
endforeach()
if(NOT EXISTS "${PNG_LIBRARY}")
    message(FATAL_ERROR "JE local PNG: staged static library is missing")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(PNG REQUIRED_VARS PNG_LIBRARY PNG_INCLUDE_DIR VERSION_VAR PNG_VERSION_STRING)
if(NOT TARGET PNG::PNG)
    add_library(PNG::PNG STATIC IMPORTED GLOBAL)
    set_target_properties(PNG::PNG PROPERTIES IMPORTED_LINK_INTERFACE_LANGUAGES "C" IMPORTED_LOCATION "${PNG_LIBRARY}")
    if(COMMAND ly_target_include_system_directories)
        ly_target_include_system_directories(TARGET PNG::PNG INTERFACE "${PNG_INCLUDE_DIRS}")
    else()
        target_include_directories(PNG::PNG SYSTEM INTERFACE "${PNG_INCLUDE_DIRS}")
    endif()
    # Same libm convention as the original Find module; Windows needs no libm.
    set(ADDITIONAL_SYSTEM_LIB_DEPENDENCIES "")
    if(NOT WIN32)
        include(CheckLibraryExists)
        set(CMAKE_REQUIRED_QUIET TRUE)
        check_library_exists(m pow "" JE_PNG_LIBM)
        if(JE_PNG_LIBM)
            set(ADDITIONAL_SYSTEM_LIB_DEPENDENCIES m)
        endif()
    endif()
    target_link_libraries(PNG::PNG INTERFACE ZLIB::ZLIB ${ADDITIONAL_SYSTEM_LIB_DEPENDENCIES})
endif()
if(NOT TARGET 3rdParty::PNG)
    add_library(3rdParty::PNG ALIAS PNG::PNG)
endif()
if(NOT LY_VERSION_ENGINE_NAME)
    message(STATUS "Using JE local PNG from ${JE_PNG_LOCAL_ROOT}")
endif()