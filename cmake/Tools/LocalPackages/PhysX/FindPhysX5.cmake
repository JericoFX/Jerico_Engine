if(TARGET 3rdParty::PhysX5)
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_PHYSX_PACKAGE_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_PHYSX_PACKAGE_ROOT)
set(JE_PHYSX_ROOT "${JE_PHYSX_PACKAGE_ROOT}/PhysX/physx")
if(NOT EXISTS "${JE_PHYSX_ROOT}/version.txt")
    message(FATAL_ERROR "JE PhysX5: package version.txt is missing")
endif()
file(READ "${JE_PHYSX_ROOT}/version.txt" JE_PHYSX_VERSION)
string(STRIP "${JE_PHYSX_VERSION}" JE_PHYSX_VERSION)
if(NOT JE_PHYSX_VERSION STREQUAL "5.1.1.32142945"
    OR (PhysX5_FIND_VERSION AND NOT PhysX5_FIND_VERSION VERSION_EQUAL "5.1.1"))
    message(FATAL_ERROR "JE PhysX5: the exact 5.1.1 CPU package is required")
endif()
set(PhysX5_VERSION "5.1.1")
set(PhysX5_INCLUDE_DIR "${JE_PHYSX_ROOT}/include" "${JE_PHYSX_ROOT}/include/foundation" "${JE_PHYSX_ROOT}/include/geometry")
foreach(JE_HEADER IN ITEMS PxPhysicsAPI.h PxConfig.h foundation/PxPhysicsVersion.h)
    if(NOT EXISTS "${JE_PHYSX_ROOT}/include/${JE_HEADER}")
        message(FATAL_ERROR "JE PhysX5: missing header ${JE_HEADER}")
    endif()
endforeach()
set(PhysX5_COMPILE_DEFINITIONS PX_PHYSX_STATIC_LIB)
set(LY_PHYSX_PROFILE_USE_CHECKED_LIBS OFF CACHE BOOL "When ON use PhysX checked libraries for the engine profile configuration")
if(LY_PHYSX_PROFILE_USE_CHECKED_LIBS)
    set(JE_PHYSX_PROFILE_CONFIG checked)
else()
    set(JE_PHYSX_PROFILE_CONFIG profile)
endif()
set(JE_PHYSX_MAIN_LIBS PhysX PhysXPvdSDK PhysXVehicle PhysXCharacterKinematic PhysXExtensions PhysXCooking PhysXCommon PhysXFoundation)
foreach(JE_CONFIG IN ITEMS debug profile checked release)
    foreach(JE_LIBRARY IN LISTS JE_PHYSX_MAIN_LIBS)
        set(JE_FILE "${JE_PHYSX_ROOT}/bin/static/${JE_CONFIG}/${JE_LIBRARY}_static_64.lib")
        JE_python_require_local_path(JE_FILE)
        if(NOT EXISTS "${JE_FILE}")
            message(FATAL_ERROR "JE PhysX5: missing ${JE_CONFIG} static archive ${JE_LIBRARY}")
        endif()
    endforeach()
endforeach()
# Preserve the O3DE imported target names and the original main-library order.
set(JE_PREVIOUS_LIBRARY "")
foreach(JE_LIBRARY IN LISTS JE_PHYSX_MAIN_LIBS)
    set(JE_TARGET "PhysX5${JE_LIBRARY}_static_64::imported")
    add_library(${JE_TARGET} STATIC IMPORTED GLOBAL)
    set_target_properties(${JE_TARGET} PROPERTIES
        IMPORTED_CONFIGURATIONS "DEBUG;PROFILE;CHECKED;RELEASE"
        IMPORTED_LOCATION_DEBUG "${JE_PHYSX_ROOT}/bin/static/debug/${JE_LIBRARY}_static_64.lib"
        IMPORTED_LOCATION_PROFILE "${JE_PHYSX_ROOT}/bin/static/${JE_PHYSX_PROFILE_CONFIG}/${JE_LIBRARY}_static_64.lib"
        IMPORTED_LOCATION_CHECKED "${JE_PHYSX_ROOT}/bin/static/checked/${JE_LIBRARY}_static_64.lib"
        IMPORTED_LOCATION_RELEASE "${JE_PHYSX_ROOT}/bin/static/release/${JE_LIBRARY}_static_64.lib")
    if(JE_PREVIOUS_LIBRARY)
        target_link_libraries(${JE_TARGET} INTERFACE ${JE_PREVIOUS_LIBRARY})
    endif()
    set(JE_PREVIOUS_LIBRARY ${JE_TARGET})
endforeach()
add_library(PhysX5_STATIC_LIBS::imported INTERFACE IMPORTED GLOBAL)
target_link_libraries(PhysX5_STATIC_LIBS::imported INTERFACE ${JE_PREVIOUS_LIBRARY})
add_library(3rdParty::PhysX5 INTERFACE IMPORTED GLOBAL)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::PhysX5 INTERFACE ${PhysX5_INCLUDE_DIR})
else()
    target_include_directories(3rdParty::PhysX5 SYSTEM INTERFACE ${PhysX5_INCLUDE_DIR})
endif()
target_link_libraries(3rdParty::PhysX5 INTERFACE PhysX5_STATIC_LIBS::imported)
target_compile_definitions(3rdParty::PhysX5 INTERFACE ${PhysX5_COMPILE_DEFINITIONS})
# The transition provider supplies CPU libraries only; no GPU DLL runtime claims.
set(PhysX5_FOUND TRUE)
