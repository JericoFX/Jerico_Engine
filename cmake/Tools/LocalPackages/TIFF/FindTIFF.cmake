# Local adaptation of package-system/tiff/FindTIFF.cmake at 3p-package-source@70f0b7b5.
include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_TIFF_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_TIFF_LOCAL_ROOT)
# Preserve the engine's associated-package hook and the standard zlib target.
if(NOT TARGET ZLIB::ZLIB)
    if(COMMAND ly_download_associated_package)
        ly_download_associated_package(ZLIB REQUIRED MODULE)
    else()
        JE_python_require_local_path(JE_ZLIB_PACKAGE_ROOT)
        if(NOT EXISTS "${JE_ZLIB_PACKAGE_ROOT}/FindZLIB.cmake")
            message(FATAL_ERROR "JE local TIFF: explicit local JE_ZLIB_PACKAGE_ROOT is required")
        endif()
        list(PREPEND CMAKE_MODULE_PATH "${JE_ZLIB_PACKAGE_ROOT}")
    endif()
    find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
elseif(NOT DEFINED ZLIB_VERSION_STRING)
    find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
endif()
if(NOT TARGET ZLIB::ZLIB OR NOT ZLIB_VERSION_STRING VERSION_EQUAL "1.2.11")
    message(FATAL_ERROR "JE local TIFF: zlib 1.2.11 target/version is required")
endif()
set(TIFF_INCLUDE_DIRS "${JE_TIFF_LOCAL_ROOT}/tiff/include")
set(TIFF_INCLUDE_DIR "${TIFF_INCLUDE_DIRS}")
set(TIFF_LIBRARY "${JE_TIFF_LOCAL_ROOT}/tiff/lib/${CMAKE_STATIC_LIBRARY_PREFIX}tiff${CMAKE_STATIC_LIBRARY_SUFFIX}")
set(TIFF_LIBRARIES "${TIFF_LIBRARY}")
set(TIFF_LIBRARY_RELEASE "${TIFF_LIBRARY}")
set(TIFF_LIBRARY_DEBUG "${TIFF_LIBRARY}")
# This is the original O3DE package identity; TIFFGetVersion remains upstream 4.2.0.
set(TIFF_VERSION_STRING "4.2.0.15")
set(TIFF_VERSION_MAJOR "4")
set(TIFF_VERSION_MINOR "2")
set(TIFF_VERSION_PATCH "0")
set(TIFF_MAJOR_VERSION "4")
set(TIFF_MINOR_VERSION "2")
set(TIFF_PATCH_VERSION "0")
set(TIFF_CXX_FOUND 0)
foreach(JE_TIFF_HEADER IN ITEMS tiff.h tiffconf.h tiffvers.h tiffio.h)
    if(NOT EXISTS "${TIFF_INCLUDE_DIR}/${JE_TIFF_HEADER}")
        message(FATAL_ERROR "JE local TIFF: staged header ${JE_TIFF_HEADER} is missing")
    endif()
endforeach()
if(NOT EXISTS "${TIFF_LIBRARY}")
    message(FATAL_ERROR "JE local TIFF: staged static library is missing")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(TIFF REQUIRED_VARS TIFF_LIBRARY TIFF_INCLUDE_DIR VERSION_VAR TIFF_VERSION_STRING)
if(NOT TARGET TIFF::TIFF)
    add_library(TIFF::TIFF STATIC IMPORTED GLOBAL)
    set_target_properties(TIFF::TIFF PROPERTIES IMPORTED_LOCATION "${TIFF_LIBRARY}")
    target_link_libraries(TIFF::TIFF INTERFACE ZLIB::ZLIB)
    if(COMMAND ly_target_include_system_directories)
        ly_target_include_system_directories(TARGET TIFF::TIFF INTERFACE "${TIFF_INCLUDE_DIRS}")
    else()
        target_include_directories(TIFF::TIFF SYSTEM INTERFACE "${TIFF_INCLUDE_DIRS}")
    endif()
endif()
if(NOT TARGET 3rdParty::TIFF)
    add_library(3rdParty::TIFF ALIAS TIFF::TIFF)
endif()
if(NOT LY_VERSION_ENGINE_NAME)
    message(STATUS "Using JE local TIFF from ${JE_TIFF_LOCAL_ROOT}")
endif()