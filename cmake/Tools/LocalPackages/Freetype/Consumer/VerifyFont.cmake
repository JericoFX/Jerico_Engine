if(JE_FONT_FILE MATCHES "://")
    message(FATAL_ERROR "JE_FONT_FILE must not be a URI")
endif()
file(TO_CMAKE_PATH "${JE_FONT_FILE}" je_local_font)
if(NOT IS_ABSOLUTE "${je_local_font}" OR je_local_font MATCHES "^//")
    message(FATAL_ERROR "JE_FONT_FILE must name an explicit absolute local font file")
endif()
cmake_path(NORMAL_PATH je_local_font)
set(JE_FONT_FILE "${je_local_font}")
set(je_font_ancestor "${JE_FONT_FILE}")
while(TRUE)
    if(IS_SYMLINK "${je_font_ancestor}")
        message(FATAL_ERROR "JE_FONT_FILE must not use symlinks or linked ancestors")
    endif()
    get_filename_component(je_font_parent "${je_font_ancestor}" DIRECTORY)
    if(je_font_parent STREQUAL je_font_ancestor)
        break()
    endif()
    set(je_font_ancestor "${je_font_parent}")
endwhile()
if(NOT EXISTS "${JE_FONT_FILE}" OR IS_DIRECTORY "${JE_FONT_FILE}")
    message(FATAL_ERROR "JE_FONT_FILE must name an existing absolute local font file")
endif()
string(LENGTH "${JE_FONT_SHA256}" je_font_hash_length)
if(NOT je_font_hash_length EQUAL 64 OR NOT JE_FONT_SHA256 MATCHES "^[a-fA-F0-9]+$")
    message(FATAL_ERROR "JE_FONT_SHA256 must be the audited 64-character SHA256")
endif()
file(SHA256 "${JE_FONT_FILE}" je_actual_font_hash)
string(TOLOWER "${JE_FONT_SHA256}" je_expected_font_hash)
if(NOT je_actual_font_hash STREQUAL je_expected_font_hash)
    message(FATAL_ERROR "Local font fixture SHA256 mismatch: ${JE_FONT_FILE}")
endif()
message(STATUS "Local font fixture SHA256: ${je_actual_font_hash}")
