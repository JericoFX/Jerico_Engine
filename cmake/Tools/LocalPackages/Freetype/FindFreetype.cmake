# This module resolves only the package payload beside it, preserving real consumer aliases.

set(Freetype_O3DE_TARGETNAME "3rdParty::Freetype")
set(Freetype_TARGETNAME "Freetype::Freetype")
set(FREETYPE_INCLUDE_DIR_ft2build "${CMAKE_CURRENT_LIST_DIR}/freetype/include/freetype2")
set(FREETYPE_INCLUDE_DIR_freetype2 "${FREETYPE_INCLUDE_DIR_ft2build}/freetype")
set(FREETYPE_INCLUDE_DIRS "${FREETYPE_INCLUDE_DIR_ft2build}" "${FREETYPE_INCLUDE_DIR_freetype2}")
set(FREETYPE_VERSION_STRING "2.11.1")
set(FREETYPE_VERSION "${FREETYPE_VERSION_STRING}")
set(FREETYPE_LIBRARY "${CMAKE_CURRENT_LIST_DIR}/freetype/lib/${CMAKE_STATIC_LIBRARY_PREFIX}freetype${CMAKE_STATIC_LIBRARY_SUFFIX}")
set(FREETYPE_LIBRARIES "${FREETYPE_LIBRARY}")
foreach(Freetype_FILE IN ITEMS "${FREETYPE_INCLUDE_DIR_ft2build}/ft2build.h"
    "${FREETYPE_INCLUDE_DIR_freetype2}/freetype.h" "${FREETYPE_LIBRARY}")
    if(NOT EXISTS "${Freetype_FILE}")
        message(FATAL_ERROR "The local Freetype 2.11.1 package payload is incomplete: ${Freetype_FILE}")
    endif()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(Freetype
    REQUIRED_VARS FREETYPE_LIBRARY FREETYPE_INCLUDE_DIR_ft2build FREETYPE_INCLUDE_DIR_freetype2
    VERSION_VAR FREETYPE_VERSION_STRING)
set(FREETYPE_FOUND "${Freetype_FOUND}")
if(NOT Freetype_FOUND)
    return()
endif()

if(NOT TARGET ZLIB::ZLIB)
    if(COMMAND ly_download_associated_package)
        # Engine resolver is the existing audited local-only provider; no second downloader.
        ly_download_associated_package(ZLIB)
        find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
    else()
        if(JE_ZLIB_PACKAGE_ROOT MATCHES "://")
            message(FATAL_ERROR "JE_ZLIB_PACKAGE_ROOT must not be a URI")
        endif()
        file(TO_CMAKE_PATH "${JE_ZLIB_PACKAGE_ROOT}" Freetype_ZLIB_ROOT)
        if(NOT IS_ABSOLUTE "${Freetype_ZLIB_ROOT}" OR Freetype_ZLIB_ROOT MATCHES "^//")
            message(FATAL_ERROR "Supply an explicit absolute local JE_ZLIB_PACKAGE_ROOT")
        endif()
        cmake_path(NORMAL_PATH Freetype_ZLIB_ROOT)
        set(Freetype_ZLIB_ANCESTOR "${Freetype_ZLIB_ROOT}")
        while(TRUE)
            if(IS_SYMLINK "${Freetype_ZLIB_ANCESTOR}")
                message(FATAL_ERROR "JE_ZLIB_PACKAGE_ROOT must not use symlinks or linked ancestors")
            endif()
            get_filename_component(Freetype_ZLIB_PARENT "${Freetype_ZLIB_ANCESTOR}" DIRECTORY)
            if(Freetype_ZLIB_PARENT STREQUAL Freetype_ZLIB_ANCESTOR)
                break()
            endif()
            set(Freetype_ZLIB_ANCESTOR "${Freetype_ZLIB_PARENT}")
        endwhile()
        if(NOT EXISTS "${Freetype_ZLIB_ROOT}/FindZLIB.cmake")
            message(FATAL_ERROR "Supply JE_ZLIB_PACKAGE_ROOT for the explicit local zlib 1.2.11 package")
        endif()
        set(Freetype_SAVED_MODULE_PATH "${CMAKE_MODULE_PATH}")
        list(PREPEND CMAKE_MODULE_PATH "${Freetype_ZLIB_ROOT}")
        find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
        set(CMAKE_MODULE_PATH "${Freetype_SAVED_MODULE_PATH}")
        unset(Freetype_SAVED_MODULE_PATH)
    endif()
endif()
if(NOT TARGET ZLIB::ZLIB OR NOT ZLIB_VERSION_STRING VERSION_EQUAL "1.2.11")
    message(FATAL_ERROR "Freetype requires the audited ZLIB::ZLIB 1.2.11 target and version")
endif()
if(NOT TARGET ${Freetype_TARGETNAME})
    add_library(${Freetype_TARGETNAME} STATIC IMPORTED GLOBAL)
    set_target_properties(${Freetype_TARGETNAME} PROPERTIES
        IMPORTED_LINK_INTERFACE_LANGUAGES C IMPORTED_LOCATION "${FREETYPE_LIBRARY}")
    target_link_libraries(${Freetype_TARGETNAME} INTERFACE ZLIB::ZLIB)
    if(COMMAND ly_target_include_system_directories)
        ly_target_include_system_directories(TARGET ${Freetype_TARGETNAME} INTERFACE ${FREETYPE_INCLUDE_DIRS})
    else()
        target_include_directories(${Freetype_TARGETNAME} SYSTEM INTERFACE ${FREETYPE_INCLUDE_DIRS})
    endif()
endif()
if(NOT TARGET ${Freetype_O3DE_TARGETNAME})
    add_library(${Freetype_O3DE_TARGETNAME} ALIAS ${Freetype_TARGETNAME})
endif()
if(NOT LY_VERSION_ENGINE_NAME)
    message(STATUS "Using local JE Freetype (${FREETYPE_VERSION_STRING}) from ${CMAKE_CURRENT_LIST_DIR}")
endif()
