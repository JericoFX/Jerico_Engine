# Child-project-only hook. Compiler selection is already initialized; package
# discovery now uses explicit local modules/configs, without ambient prefixes.
if(NOT PROJECT_NAME STREQUAL "OpenImageIO" AND NOT PROJECT_NAME STREQUAL "OpenColorIO")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/SourcePins.cmake")
JE_python_verify_file("${JE_OIIO_INPUTS}" "${JE_OIIO_INPUTS_SHA256}" "pinned OIIO child witness")
include("${JE_OIIO_INPUTS}")
set(CMAKE_FIND_USE_SYSTEM_ENVIRONMENT_PATH OFF)
set(CMAKE_FIND_USE_CMAKE_SYSTEM_PATH OFF)
set(CMAKE_PREFIX_PATH "${JE_OIIO_PRIVATE_PREFIX}/Boost" "${JE_OIIO_PRIVATE_PREFIX}/JPEG")
foreach(JE_DEP IN ITEMS ZLIB PNG TIFF Freetype expat)
    JE_python_require_local_path(JE_DEP_${JE_DEP}_ROOT)
    list(PREPEND CMAKE_MODULE_PATH "${JE_DEP_${JE_DEP}_ROOT}")
endforeach()
set(JE_ZLIB_PACKAGE_ROOT "${JE_DEP_ZLIB_ROOT}")
find_package(ZLIB 1.2.11 EXACT REQUIRED MODULE)
find_package(PNG 1.6.37 EXACT REQUIRED MODULE)
find_package(TIFF 4.2.0.15 EXACT REQUIRED MODULE)
find_package(Freetype 2.11.1 EXACT REQUIRED MODULE)
find_package(expat 2.4.2 EXACT REQUIRED MODULE)
find_package(Imath 3.1.3 EXACT REQUIRED CONFIG PATHS "${JE_DEP_OpenEXR_ROOT}/OpenEXR/lib/cmake/Imath" NO_DEFAULT_PATH)
find_package(OpenEXR 3.1.3 EXACT REQUIRED CONFIG PATHS "${JE_DEP_OpenEXR_ROOT}/OpenEXR/lib/cmake/OpenEXR" NO_DEFAULT_PATH)
set(OPENEXR_FOUND TRUE)
set(OPENEXR_VERSION "3.1.3")
set(OPENEXR_INCLUDES "${JE_DEP_OpenEXR_ROOT}/OpenEXR/include")
set(IMATH_INCLUDES "${JE_DEP_OpenEXR_ROOT}/OpenEXR/include")
set(ILMBASE_INCLUDES "${IMATH_INCLUDES}")
set(OPENEXR_LIBRARIES OpenEXR::OpenEXR)
# YAML 0.6.3 installs Windows configs in CMake/, with separate MD and MDd
# imported locations. Keep that multi-config target, never a Release-only path.
find_package(yaml-cpp 0.6.3 EXACT REQUIRED CONFIG PATHS "${JE_OIIO_PRIVATE_PREFIX}/yaml_cpp/CMake" NO_DEFAULT_PATH)
foreach(JE_CONFIG IN ITEMS DEBUG RELEASE)
    get_target_property(JE_YAML_LOCATION yaml-cpp IMPORTED_LOCATION_${JE_CONFIG})
    if(JE_CONFIG STREQUAL "DEBUG")
        set(JE_YAML_EXPECTED "${JE_OIIO_PRIVATE_PREFIX}/yaml_cpp/lib/libyaml-cppmdd.lib")
    else()
        set(JE_YAML_EXPECTED "${JE_OIIO_PRIVATE_PREFIX}/yaml_cpp/lib/libyaml-cppmd.lib")
    endif()
    if(NOT JE_YAML_LOCATION STREQUAL JE_YAML_EXPECTED OR NOT EXISTS "${JE_YAML_LOCATION}")
        message(FATAL_ERROR "JE local OIIO: yaml-cpp ${JE_CONFIG} imported location must be the private MD/MDd archive")
    endif()
endforeach()
foreach(JE_STATIC IN ITEMS pystring lcms2)
    set(JE_INCLUDE_SUBDIR "include/${JE_STATIC}")
    if(JE_STATIC STREQUAL "pystring")
        set(JE_SUBDIR pystring)
        set(JE_INCLUDE_SUBDIR include)
        set(JE_VERSION "1.1.3")
    else()
        set(JE_SUBDIR Little_CMS)
        set(JE_VERSION "2.2")
    endif()
    set(${JE_STATIC}_INCLUDE_DIR "${JE_OIIO_PRIVATE_PREFIX}/${JE_SUBDIR}/${JE_INCLUDE_SUBDIR}" CACHE PATH "Local native include" FORCE)
    set(${JE_STATIC}_LIBRARY "${JE_OIIO_PRIVATE_PREFIX}/${JE_SUBDIR}/lib/${JE_STATIC}.lib" CACHE FILEPATH "Local native archive" FORCE)
    set(${JE_STATIC}_VERSION "${JE_VERSION}")
    set(${JE_STATIC}_FOUND TRUE)
    if(NOT TARGET ${JE_STATIC}::${JE_STATIC})
        add_library(${JE_STATIC}::${JE_STATIC} STATIC IMPORTED GLOBAL)
        set_target_properties(${JE_STATIC}::${JE_STATIC} PROPERTIES
            IMPORTED_LOCATION "${${JE_STATIC}_LIBRARY}"
            IMPORTED_LOCATION_DEBUG "${JE_OIIO_PRIVATE_PREFIX}/${JE_SUBDIR}/lib/${JE_STATIC}d.lib"
            INTERFACE_INCLUDE_DIRECTORIES "${${JE_STATIC}_INCLUDE_DIR}")
    endif()
endforeach()
set(lcms2_STATIC_LIBRARY TRUE)
set(expat_STATIC_LIBRARY TRUE)
set(JPEG_INCLUDE_DIR "${JE_OIIO_PRIVATE_PREFIX}/JPEG/include" CACHE PATH "Local JPEG headers" FORCE)
set(JPEG_LIBRARY "${JE_OIIO_PRIVATE_PREFIX}/JPEG/lib/jpeg-static.lib" CACHE FILEPATH "Local JPEG archive" FORCE)
set(JPEG_INCLUDE_DIRS "${JPEG_INCLUDE_DIR}")
set(JPEG_LIBRARIES "${JPEG_LIBRARY}")
set(JPEG_FOUND TRUE)
set(JPEGTURBO_FOUND TRUE)
set(JPEG_VERSION 62)
set(FMT_INCLUDE_DIR "${CMAKE_SOURCE_DIR}/../fmt/include" CACHE PATH "Local fmt headers" FORCE)
set(FMT_INCLUDES "${FMT_INCLUDE_DIR}")
set(FMT_FOUND TRUE)
set(FMT_VERSION 80000)
set(ROBINMAP_INCLUDE_DIR "${CMAKE_SOURCE_DIR}/../robin_map/include" CACHE PATH "Local robin-map headers" FORCE)
set(ROBINMAP_INCLUDES "${ROBINMAP_INCLUDE_DIR}")
set(ROBINMAP_FOUND TRUE)
if(PROJECT_NAME STREQUAL "OpenImageIO")
    find_package(OpenColorIO 2.1.1 EXACT REQUIRED CONFIG PATHS "${JE_OIIO_PRIVATE_PREFIX}/OpenColorIO/lib/cmake/OpenColorIO" NO_DEFAULT_PATH)
    set(OPENCOLORIO_FOUND TRUE)
    set(OpenColorIO_FOUND TRUE)
    set(OPENCOLORIO_INCLUDE_DIR "${JE_OIIO_PRIVATE_PREFIX}/OpenColorIO/include")
    set(OPENCOLORIO_INCLUDES "${OPENCOLORIO_INCLUDE_DIR}")
    set(OPENCOLORIO_LIBRARIES OpenColorIO::OpenColorIO)
    set(REQUIRED_DEPS PNG Freetype OpenColorIO)
elseif(NOT CMAKE_DISABLE_FIND_PACKAGE_OpenImageIO)
    # Upstream later uses a basic find_package call; retain the private config.
    set(CMAKE_FIND_PACKAGE_PREFER_CONFIG TRUE)
    find_package(OpenImageIO 2.3.17.0 EXACT REQUIRED CONFIG PATHS "${JE_OIIO_PRIVATE_PREFIX}/OpenImageIO/lib/cmake/OpenImageIO" NO_DEFAULT_PATH)
endif()
