include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
# The engine's associated-package resolver is already local-only. Standalone
# consumers instead supply explicit, guarded package roots; no ambient search.
function(JE_oiio_dependency JE_NAME JE_VERSION JE_TARGET)
    if(TARGET ${JE_TARGET})
        return()
    endif()
    if(COMMAND ly_download_associated_package)
        ly_download_associated_package(${JE_NAME} REQUIRED MODULE)
        find_package(${JE_NAME} ${JE_VERSION} EXACT REQUIRED MODULE)
    else()
        set(JE_ZLIB_PACKAGE_ROOT "${JE_DEP_ZLIB_ROOT}")
        JE_python_require_local_path(JE_ZLIB_PACKAGE_ROOT)
        list(PREPEND CMAKE_MODULE_PATH "${JE_ZLIB_PACKAGE_ROOT}")
        if(JE_NAME STREQUAL "Imath" OR JE_NAME STREQUAL "OpenEXR")
            set(JE_ROOT "${JE_DEP_OpenEXR_ROOT}")
            JE_python_require_local_path(JE_ROOT)
            find_package(${JE_NAME} ${JE_VERSION} EXACT REQUIRED CONFIG
                PATHS "${JE_ROOT}/OpenEXR/lib/cmake/${JE_NAME}" NO_DEFAULT_PATH)
        else()
            set(JE_ROOT "${JE_DEP_${JE_NAME}_ROOT}")
            JE_python_require_local_path(JE_ROOT)
            if(NOT EXISTS "${JE_ROOT}/Find${JE_NAME}.cmake")
                message(FATAL_ERROR "JE local OIIO: explicit local ${JE_NAME} Find module is missing")
            endif()
            list(PREPEND CMAKE_MODULE_PATH "${JE_ROOT}")
            find_package(${JE_NAME} ${JE_VERSION} EXACT REQUIRED MODULE)
        endif()
    endif()
    if(NOT TARGET ${JE_TARGET})
        message(FATAL_ERROR "JE local OIIO: required native target ${JE_TARGET} is missing")
    endif()
    if(JE_NAME STREQUAL "ZLIB")
        set(ZLIB_VERSION_STRING "${ZLIB_VERSION_STRING}" PARENT_SCOPE)
    endif()
endfunction()
function(JE_oiio_package_file JE_PATH)
    JE_python_require_local_path(JE_PATH)
    if(NOT EXISTS "${JE_PATH}" OR IS_DIRECTORY "${JE_PATH}")
        message(FATAL_ERROR "JE local OIIO: package file is missing: ${JE_PATH}")
    endif()
endfunction()
