# Fresh, selective native payload. Private static deps remain implementation
# details; their complete license texts/notices are retained below.
function(JE_oiio_stage_file JE_SOURCE JE_RELATIVE)
    JE_python_require_local_path(JE_SOURCE)
    if(NOT EXISTS "${JE_SOURCE}" OR IS_DIRECTORY "${JE_SOURCE}")
        message(FATAL_ERROR "JE local OIIO: required staged file is missing: ${JE_SOURCE}")
    endif()
    configure_file("${JE_SOURCE}" "${JE_STAGE}/${JE_RELATIVE}" COPYONLY)
endfunction()
foreach(JE_ID IN ITEMS OpenImageIO OpenColorIO)
    file(GLOB_RECURSE JE_HEADERS LIST_DIRECTORIES FALSE RELATIVE "${JE_PREFIX}/${JE_ID}/include" "${JE_PREFIX}/${JE_ID}/include/*")
    if(NOT JE_HEADERS)
        message(FATAL_ERROR "JE local OIIO: installed ${JE_ID} headers are missing")
    endif()
    foreach(JE_HEADER IN LISTS JE_HEADERS)
        JE_oiio_stage_file("${JE_PREFIX}/${JE_ID}/include/${JE_HEADER}" "${JE_ID}/include/${JE_HEADER}")
    endforeach()
endforeach()
foreach(JE_BASE IN ITEMS OpenImageIO OpenImageIO_Util)
    foreach(JE_SUFFIX IN ITEMS "" _d)
        JE_oiio_stage_file("${JE_PREFIX}/OpenImageIO/bin/${JE_BASE}${JE_SUFFIX}.dll" "OpenImageIO/bin/${JE_BASE}${JE_SUFFIX}.dll")
        JE_oiio_stage_file("${JE_PREFIX}/OpenImageIO/lib/${JE_BASE}${JE_SUFFIX}.lib" "OpenImageIO/lib/${JE_BASE}${JE_SUFFIX}.lib")
    endforeach()
endforeach()
foreach(JE_SUFFIX IN ITEMS "" d)
    JE_oiio_stage_file("${JE_PREFIX}/OpenColorIO/bin/OpenColorIO${JE_SUFFIX}_2_1.dll" "OpenColorIO/bin/OpenColorIO${JE_SUFFIX}_2_1.dll")
    JE_oiio_stage_file("${JE_PREFIX}/OpenColorIO/lib/OpenColorIO${JE_SUFFIX}.lib" "OpenColorIO/lib/OpenColorIO${JE_SUFFIX}.lib")
endforeach()
foreach(JE_TOOL IN ITEMS iconvert idiff igrep iinfo maketx oiiotool)
    JE_oiio_stage_file("${JE_PREFIX}/OpenImageIO/bin/${JE_TOOL}.exe" "OpenImageIO/bin/${JE_TOOL}.exe")
endforeach()
foreach(JE_TOOL IN ITEMS ociobakelut ociocheck ociochecklut ocioconvert ociolutimage ociomakeclf ocioperf ociowrite)
    JE_oiio_stage_file("${JE_PREFIX}/OpenColorIO/bin/${JE_TOOL}.exe" "OpenColorIO/bin/${JE_TOOL}.exe")
endforeach()
foreach(JE_FILE IN ITEMS FindOpenImageIO.cmake FindOpenColorIO.cmake FindNativeDependencies.cmake NOTICE.txt JERecipe.json)
    JE_oiio_stage_file("${CMAKE_CURRENT_LIST_DIR}/${JE_FILE}" "${JE_FILE}")
endforeach()
JE_oiio_stage_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" JERequireLocalPath.cmake)
JE_oiio_stage_file("${JE_SRC_OpenImageIO_ROOT}/LICENSE.md" LICENSES/OpenImageIO/LICENSE.md)
JE_oiio_stage_file("${JE_SRC_OpenImageIO_ROOT}/THIRD-PARTY.md" LICENSES/OpenImageIO/THIRD-PARTY.md)
JE_oiio_stage_file("${JE_SRC_OpenColorIO_ROOT}/LICENSE" LICENSES/OpenColorIO/LICENSE)
JE_oiio_stage_file("${JE_SRC_OpenColorIO_ROOT}/THIRD-PARTY.md" LICENSES/OpenColorIO/THIRD-PARTY.md)
JE_oiio_stage_file("${JE_SRC_Boost_ROOT}/LICENSE_1_0.txt" LICENSES/Boost/LICENSE_1_0.txt)
foreach(JE_MODULE IN ITEMS atomic chrono date_time filesystem system thread)
    file(GLOB_RECURSE JE_NOTICES LIST_DIRECTORIES FALSE RELATIVE "${JE_SRC_Boost_ROOT}" "${JE_SRC_Boost_ROOT}/libs/${JE_MODULE}/src/*")
    foreach(JE_NOTICE IN LISTS JE_NOTICES)
        JE_oiio_stage_file("${JE_SRC_Boost_ROOT}/${JE_NOTICE}" "LICENSES/Boost/source-notices/${JE_NOTICE}")
    endforeach()
endforeach()
foreach(JE_FILE IN ITEMS LICENSE.md README.ijg)
    JE_oiio_stage_file("${JE_SRC_libjpeg_turbo_ROOT}/${JE_FILE}" "LICENSES/libjpeg-turbo/${JE_FILE}")
endforeach()
foreach(JE_ID IN ITEMS pystring yaml_cpp robin_map)
    JE_oiio_stage_file("${JE_SRC_${JE_ID}_ROOT}/LICENSE" "LICENSES/${JE_ID}/LICENSE")
endforeach()
JE_oiio_stage_file("${JE_SRC_fmt_ROOT}/LICENSE.rst" LICENSES/fmt/LICENSE.rst)
JE_oiio_stage_file("${JE_SRC_Little_CMS_ROOT}/COPYING" LICENSES/Little-CMS/COPYING)
# Existing native packages provide the notices for statically embedded codecs
# and OpenEXR/Imath. No binaries or Find modules are recursively copied here.
foreach(JE_DEP IN ITEMS ZLIB PNG TIFF Freetype expat OpenEXR)
    file(GLOB_RECURSE JE_NOTICES LIST_DIRECTORIES FALSE RELATIVE "${JE_DEP_${JE_DEP}_ROOT}" "${JE_DEP_${JE_DEP}_ROOT}/LICENSES/*")
    file(GLOB JE_ROOT_NOTICES LIST_DIRECTORIES FALSE RELATIVE "${JE_DEP_${JE_DEP}_ROOT}"
        "${JE_DEP_${JE_DEP}_ROOT}/LICENSE*" "${JE_DEP_${JE_DEP}_ROOT}/NOTICE*")
    list(APPEND JE_NOTICES ${JE_ROOT_NOTICES})
    if(NOT JE_NOTICES)
        message(FATAL_ERROR "JE local OIIO: ${JE_DEP} license/notice payload is missing")
    endif()
    foreach(JE_NOTICE IN LISTS JE_NOTICES)
        JE_oiio_stage_file("${JE_DEP_${JE_DEP}_ROOT}/${JE_NOTICE}" "LICENSES/LocalDependencies/${JE_DEP}/${JE_NOTICE}")
    endforeach()
endforeach()
JE_oiio_stage_file("${JE_DEP_ZLIB_ROOT}/zlib/LICENSE" LICENSES/LocalDependencies/ZLIB/zlib/LICENSE)
JE_oiio_stage_file("${JE_SRC_Boost_ROOT}/README.md" LICENSES/Boost/README.md)
