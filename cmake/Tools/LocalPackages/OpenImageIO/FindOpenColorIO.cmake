# Native Windows contract adapted from the original O3DE Windows rev4 module.
include("${CMAKE_CURRENT_LIST_DIR}/FindNativeDependencies.cmake")
set(JE_OCIO_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_OCIO_ROOT)
if(NOT WIN32 OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
    message(FATAL_ERROR "JE local OIIO/OCIO requires Windows x64")
endif()
set(OpenColorIO_VERSION "2.1.1")
set(OpenColorIO_INCLUDE_DIR "${JE_OCIO_ROOT}/OpenColorIO/include")
set(OpenColorIO_LIB_DIR "${JE_OCIO_ROOT}/OpenColorIO/lib")
set(OpenColorIO_BIN_DIR "${JE_OCIO_ROOT}/OpenColorIO/bin")
foreach(JE_FILE IN ITEMS include/OpenColorIO/OpenColorIO.h include/OpenColorIO/OpenColorABI.h
    lib/OpenColorIO.lib lib/OpenColorIOd.lib bin/OpenColorIO_2_1.dll bin/OpenColorIOd_2_1.dll)
    JE_oiio_package_file("${JE_OCIO_ROOT}/OpenColorIO/${JE_FILE}")
endforeach()
file(READ "${OpenColorIO_INCLUDE_DIR}/OpenColorIO/OpenColorABI.h" JE_ABI)
if(NOT JE_ABI MATCHES "#define[ \t]+OCIO_VERSION_STR[ \t]+\"2[.]1[.]1\"")
    message(FATAL_ERROR "JE local OIIO: OCIO headers must be exactly 2.1.1")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(OpenColorIO REQUIRED_VARS OpenColorIO_INCLUDE_DIR OpenColorIO_LIB_DIR VERSION_VAR OpenColorIO_VERSION)
if(TARGET 3rdParty::OpenColorIO)
    return()
endif()
JE_oiio_dependency(ZLIB 1.2.11 ZLIB::ZLIB)
JE_oiio_dependency(Imath 3.1.3 Imath::Imath)
JE_oiio_dependency(expat 2.4.2 expat::expat)
add_library(OpenColorIO::OpenColorIO SHARED IMPORTED GLOBAL)
set_target_properties(OpenColorIO::OpenColorIO PROPERTIES
    IMPORTED_LOCATION "${OpenColorIO_BIN_DIR}/OpenColorIO_2_1.dll"
    IMPORTED_IMPLIB "${OpenColorIO_LIB_DIR}/OpenColorIO.lib"
    IMPORTED_LOCATION_DEBUG "${OpenColorIO_BIN_DIR}/OpenColorIOd_2_1.dll"
    IMPORTED_IMPLIB_DEBUG "${OpenColorIO_LIB_DIR}/OpenColorIOd.lib")
target_link_libraries(OpenColorIO::OpenColorIO INTERFACE Imath::Imath)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET OpenColorIO::OpenColorIO INTERFACE "${OpenColorIO_INCLUDE_DIR}")
else()
    target_include_directories(OpenColorIO::OpenColorIO SYSTEM INTERFACE "${OpenColorIO_INCLUDE_DIR}")
endif()
add_library(OpenColorIO::OpenColorIO::ReleaseSharedLibraries SHARED IMPORTED GLOBAL)
set_target_properties(OpenColorIO::OpenColorIO::ReleaseSharedLibraries PROPERTIES IMPORTED_LOCATION "${OpenColorIO_BIN_DIR}/OpenColorIO_2_1.dll")
add_library(OpenColorIO::OpenColorIO::Runtime INTERFACE IMPORTED GLOBAL)
target_link_libraries(OpenColorIO::OpenColorIO::Runtime INTERFACE OpenColorIO::OpenColorIO OpenColorIO::OpenColorIO::ReleaseSharedLibraries)
set(OpenColorIO_TOOLS_BINARIES)
foreach(JE_TOOL IN ITEMS ociobakelut ociocheck ociochecklut ocioconvert ociolutimage ociomakeclf ocioperf ociowrite)
    set(JE_FILE "${OpenColorIO_BIN_DIR}/${JE_TOOL}.exe")
    JE_oiio_package_file("${JE_FILE}")
    list(APPEND OpenColorIO_TOOLS_BINARIES "${JE_FILE}")
endforeach()
add_library(OpenColorIO::OpenColorIO::Tools::Binaries INTERFACE IMPORTED GLOBAL)
target_link_libraries(OpenColorIO::OpenColorIO::Tools::Binaries INTERFACE OpenColorIO::OpenColorIO::Runtime)
if(COMMAND ly_add_target_files)
    ly_add_target_files(TARGETS OpenColorIO::OpenColorIO::Tools::Binaries FILES ${OpenColorIO_TOOLS_BINARIES})
endif()
add_library(3rdParty::OpenColorIO ALIAS OpenColorIO::OpenColorIO)
add_library(3rdParty::OpenColorIO::Runtime ALIAS OpenColorIO::OpenColorIO::Runtime)
add_library(3rdParty::OpenColorIO::Tools::Binaries ALIAS OpenColorIO::OpenColorIO::Tools::Binaries)
