# Native Windows contract adapted from the original O3DE Windows rev4 module.
include("${CMAKE_CURRENT_LIST_DIR}/FindNativeDependencies.cmake")
set(JE_OIIO_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_OIIO_ROOT)
if(NOT WIN32 OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
    message(FATAL_ERROR "JE local OIIO/OCIO requires Windows x64")
endif()
set(OpenImageIO_VERSION "2.3.17.0")
set(OpenImageIO_INCLUDE_DIR "${JE_OIIO_ROOT}/OpenImageIO/include")
set(OpenImageIO_LIB_DIR "${JE_OIIO_ROOT}/OpenImageIO/lib")
set(OpenImageIO_BIN_DIR "${JE_OIIO_ROOT}/OpenImageIO/bin")
JE_oiio_package_file("${OpenImageIO_INCLUDE_DIR}/OpenImageIO/imageio.h")
JE_oiio_package_file("${OpenImageIO_INCLUDE_DIR}/OpenImageIO/oiioversion.h")
file(READ "${OpenImageIO_INCLUDE_DIR}/OpenImageIO/oiioversion.h" JE_VERSION_HEADER)
foreach(JE_PAIR IN ITEMS "MAJOR;2" "MINOR;3" "PATCH;17")
    list(GET JE_PAIR 0 JE_KEY)
    list(GET JE_PAIR 1 JE_VALUE)
    if(NOT JE_VERSION_HEADER MATCHES "#define[ \t]+OIIO_VERSION_${JE_KEY}[ \t]+${JE_VALUE}([ \t\r\n]|$)")
        message(FATAL_ERROR "JE local OIIO: headers must be exactly 2.3.17")
    endif()
endforeach()
foreach(JE_BASE IN ITEMS OpenImageIO OpenImageIO_Util)
    foreach(JE_SUFFIX IN ITEMS "" _d)
        JE_oiio_package_file("${OpenImageIO_BIN_DIR}/${JE_BASE}${JE_SUFFIX}.dll")
        JE_oiio_package_file("${OpenImageIO_LIB_DIR}/${JE_BASE}${JE_SUFFIX}.lib")
    endforeach()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(OpenImageIO REQUIRED_VARS OpenImageIO_INCLUDE_DIR OpenImageIO_LIB_DIR VERSION_VAR OpenImageIO_VERSION)
if(TARGET 3rdParty::OpenImageIO)
    return()
endif()
JE_oiio_dependency(ZLIB 1.2.11 ZLIB::ZLIB)
JE_oiio_dependency(PNG 1.6.37 PNG::PNG)
JE_oiio_dependency(Imath 3.1.3 Imath::Imath)
JE_oiio_dependency(Freetype 2.11.1 Freetype::Freetype)
JE_oiio_dependency(OpenEXR 3.1.3 OpenEXR::OpenEXR)
JE_oiio_dependency(TIFF 4.2.0.15 TIFF::TIFF)
JE_oiio_dependency(expat 2.4.2 expat::expat)
include("${CMAKE_CURRENT_LIST_DIR}/FindOpenColorIO.cmake")
foreach(JE_BASE IN ITEMS OpenImageIO OpenImageIO_Util)
    add_library(OpenImageIO::${JE_BASE} SHARED IMPORTED GLOBAL)
    set_target_properties(OpenImageIO::${JE_BASE} PROPERTIES
        IMPORTED_LOCATION "${OpenImageIO_BIN_DIR}/${JE_BASE}.dll"
        IMPORTED_IMPLIB "${OpenImageIO_LIB_DIR}/${JE_BASE}.lib"
        IMPORTED_LOCATION_DEBUG "${OpenImageIO_BIN_DIR}/${JE_BASE}_d.dll"
        IMPORTED_IMPLIB_DEBUG "${OpenImageIO_LIB_DIR}/${JE_BASE}_d.lib")
    add_library(OpenImageIO::${JE_BASE}::ReleaseSharedLibraries SHARED IMPORTED GLOBAL)
    set_target_properties(OpenImageIO::${JE_BASE}::ReleaseSharedLibraries PROPERTIES IMPORTED_LOCATION "${OpenImageIO_BIN_DIR}/${JE_BASE}.dll")
    add_library(3rdParty::${JE_BASE} ALIAS OpenImageIO::${JE_BASE})
endforeach()
target_link_libraries(OpenImageIO::OpenImageIO INTERFACE OpenImageIO::OpenImageIO_Util OpenColorIO::OpenColorIO)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET OpenImageIO::OpenImageIO INTERFACE "${OpenImageIO_INCLUDE_DIR}")
else()
    target_include_directories(OpenImageIO::OpenImageIO SYSTEM INTERFACE "${OpenImageIO_INCLUDE_DIR}")
endif()
set(OpenImageIO_TOOLS_BINARIES)
foreach(JE_TOOL IN ITEMS iconvert idiff igrep iinfo maketx oiiotool)
    set(JE_FILE "${OpenImageIO_BIN_DIR}/${JE_TOOL}.exe")
    JE_oiio_package_file("${JE_FILE}")
    list(APPEND OpenImageIO_TOOLS_BINARIES "${JE_FILE}")
endforeach()
add_library(OpenImageIO::OpenImageIO::Tools::Binaries INTERFACE IMPORTED GLOBAL)
target_link_libraries(OpenImageIO::OpenImageIO::Tools::Binaries INTERFACE OpenColorIO::OpenColorIO::Runtime
    OpenImageIO::OpenImageIO::ReleaseSharedLibraries OpenImageIO::OpenImageIO_Util::ReleaseSharedLibraries)
if(COMMAND ly_add_target_files)
    ly_add_target_files(TARGETS OpenImageIO::OpenImageIO::Tools::Binaries FILES ${OpenImageIO_TOOLS_BINARIES})
endif()
add_library(3rdParty::OpenImageIO::Tools::Binaries ALIAS OpenImageIO::OpenImageIO::Tools::Binaries)
