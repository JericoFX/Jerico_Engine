# New JE Windows package; the Mac-only upstream package recipe is not a Windows ABI/layout contract.

include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_ZSTD_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_ZSTD_LOCAL_ROOT)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local zstd package requires Windows x64")
endif()
set(zstd_INCLUDE_DIR "${JE_ZSTD_LOCAL_ROOT}/zstd/include")
set(zstd_LIBS_DIR "${JE_ZSTD_LOCAL_ROOT}/zstd/lib")
set(zstd_LIBRARY "${zstd_LIBS_DIR}/release/zstd_static.lib")
set(zstd_VERSION "1.3.5")
foreach(JE_HEADER IN ITEMS zstd.h zstd_errors.h zbuff.h zdict.h)
    if(NOT EXISTS "${zstd_INCLUDE_DIR}/${JE_HEADER}")
        set(zstd_INCLUDE_DIR zstd_INCLUDE_DIR-NOTFOUND)
        break()
    endif()
endforeach()
if(NOT EXISTS "${zstd_LIBRARY}")
    set(zstd_LIBRARY zstd_LIBRARY-NOTFOUND)
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(zstd REQUIRED_VARS zstd_LIBRARY zstd_INCLUDE_DIR VERSION_VAR zstd_VERSION)
if(NOT zstd_FOUND)
    return()
endif()
set(JE_HEADER_PATH "${zstd_INCLUDE_DIR}/zstd.h")
JE_python_require_local_path(JE_HEADER_PATH)
JE_python_require_local_path(zstd_LIBRARY)
file(READ "${JE_HEADER_PATH}" JE_HEADER)
if(NOT JE_HEADER MATCHES "#define[ \t]+ZSTD_VERSION_MAJOR[ \t]+1([\r\n]|$)"
    OR NOT JE_HEADER MATCHES "#define[ \t]+ZSTD_VERSION_MINOR[ \t]+3([\r\n]|$)"
    OR NOT JE_HEADER MATCHES "#define[ \t]+ZSTD_VERSION_RELEASE[ \t]+5([\r\n]|$)")
    message(FATAL_ERROR "JE local zstd package header is not version 1.3.5")
endif()
set(zstd_INCLUDE_DIRS "${zstd_INCLUDE_DIR}")
set(zstd_LIBRARIES "${zstd_LIBRARY}")
if(TARGET 3rdParty::zstd)
    get_target_property(JE_EXISTING_LIBRARY 3rdParty::zstd IMPORTED_LOCATION)
    if(NOT "${JE_EXISTING_LIBRARY}" STREQUAL "${zstd_LIBRARY}")
        message(FATAL_ERROR "JE local zstd refuses to replace an existing provider")
    endif()
    return()
endif()
add_library(3rdParty::zstd STATIC IMPORTED GLOBAL)
set_target_properties(3rdParty::zstd PROPERTIES IMPORTED_LOCATION "${zstd_LIBRARY}")
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::zstd INTERFACE "${zstd_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::zstd SYSTEM INTERFACE "${zstd_INCLUDE_DIR}")
endif()
