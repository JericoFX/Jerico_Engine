function(JE_python_require_local_path JE_VARIABLE)
    if(NOT DEFINED ${JE_VARIABLE} OR "${${JE_VARIABLE}}" STREQUAL "")
        message(FATAL_ERROR "JE local Python: ${JE_VARIABLE} is required")
    endif()
    if("${${JE_VARIABLE}}" MATCHES "://")
        message(FATAL_ERROR "JE local Python: ${JE_VARIABLE} must not be a URI")
    endif()
    file(TO_CMAKE_PATH "${${JE_VARIABLE}}" JE_LOCAL_PATH)
    if(NOT IS_ABSOLUTE "${JE_LOCAL_PATH}" OR JE_LOCAL_PATH MATCHES "^//")
        message(FATAL_ERROR "JE local Python: ${JE_VARIABLE} must be an absolute local path")
    endif()
    cmake_path(NORMAL_PATH JE_LOCAL_PATH)
    set(JE_ANCESTOR "${JE_LOCAL_PATH}")
    while(NOT JE_ANCESTOR STREQUAL "")
        if(IS_SYMLINK "${JE_ANCESTOR}")
            message(FATAL_ERROR "JE local Python: ${JE_VARIABLE} must not use symlink paths")
        endif()
        get_filename_component(JE_PARENT "${JE_ANCESTOR}" DIRECTORY)
        if(JE_PARENT STREQUAL JE_ANCESTOR)
            break()
        endif()
        set(JE_ANCESTOR "${JE_PARENT}")
    endwhile()
    set(${JE_VARIABLE} "${JE_LOCAL_PATH}" PARENT_SCOPE)
endfunction()

function(JE_python_verify_file JE_PATH JE_HASH JE_LABEL)
    JE_python_require_local_path(JE_PATH)
    string(LENGTH "${JE_HASH}" JE_HASH_LENGTH)
    if(NOT JE_HASH_LENGTH EQUAL 64 OR NOT JE_HASH MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "JE local Python: ${JE_LABEL} requires an explicit full SHA256")
    endif()
    if(NOT EXISTS "${JE_PATH}" OR IS_DIRECTORY "${JE_PATH}")
        message(FATAL_ERROR "JE local Python: ${JE_LABEL} file is missing: ${JE_PATH}")
    endif()
    file(SHA256 "${JE_PATH}" JE_ACTUAL_HASH)
    string(TOLOWER "${JE_HASH}" JE_EXPECTED_HASH)
    if(NOT JE_ACTUAL_HASH STREQUAL JE_EXPECTED_HASH)
        message(FATAL_ERROR "JE local Python: ${JE_LABEL} SHA256 mismatch: ${JE_PATH}")
    endif()
endfunction()
