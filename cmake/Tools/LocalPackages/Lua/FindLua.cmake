# Adapted from o3de/3p-package-source@70f0b7b5257bf7cf935bf1cfd270e1b53ccead18,
# package-system/Lua/FindLua.cmake. Keep the original Release-only imported target.

include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_LUA_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_LUA_LOCAL_ROOT)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local Lua package supports Windows x64 only")
endif()
set(Lua_INCLUDE_DIR "${JE_LUA_LOCAL_ROOT}/Lua/include")
set(Lua_LIBS_DIR "${JE_LUA_LOCAL_ROOT}/Lua/lib")
set(Lua_LIBRARY "${Lua_LIBS_DIR}/release/lualib.lib")
set(Lua_VERSION "5.4.4")
set(LUA_VERSION_STRING "5.4.4")
if(NOT EXISTS "${Lua_LIBRARY}")
    set(Lua_LIBRARY Lua_LIBRARY-NOTFOUND)
endif()
foreach(JE_HEADER IN ITEMS lua.h luaconf.h lauxlib.h lualib.h)
    if(NOT EXISTS "${Lua_INCLUDE_DIR}/Lua/${JE_HEADER}")
        set(Lua_INCLUDE_DIR Lua_INCLUDE_DIR-NOTFOUND)
        break()
    endif()
endforeach()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(Lua REQUIRED_VARS Lua_LIBRARY Lua_INCLUDE_DIR VERSION_VAR Lua_VERSION)
if(NOT Lua_FOUND OR TARGET 3rdParty::Lua)
    return()
endif()
add_library(3rdParty::Lua STATIC IMPORTED GLOBAL)
set_target_properties(3rdParty::Lua PROPERTIES IMPORTED_LOCATION "${Lua_LIBRARY}")
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::Lua INTERFACE "${Lua_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::Lua SYSTEM INTERFACE "${Lua_INCLUDE_DIR}")
endif()
target_link_libraries(3rdParty::Lua INTERFACE ${CMAKE_DL_LIBS})
