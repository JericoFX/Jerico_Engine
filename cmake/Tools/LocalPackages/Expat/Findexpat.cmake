# package-system/expat/Findexpat.cmake. Release C archive serves all configurations.

include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_EXPAT_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_EXPAT_ROOT)
if(NOT WIN32 OR (DEFINED CMAKE_SIZEOF_VOID_P AND NOT CMAKE_SIZEOF_VOID_P EQUAL 8))
    message(FATAL_ERROR "JE local Expat package requires Windows x64")
endif()
set(EXPAT_VERSION_STRING "2.4.2")
set(EXPAT_VERSION "2.4.2")
set(expat_VERSION "2.4.2")
set(EXPAT_LIBRARY "${JE_EXPAT_ROOT}/expat/lib/libexpatMD.lib")
set(EXPAT_INCLUDE_DIR "${JE_EXPAT_ROOT}/expat/include")
JE_python_require_local_path(EXPAT_LIBRARY)
JE_python_require_local_path(EXPAT_INCLUDE_DIR)
if(NOT EXISTS "${EXPAT_LIBRARY}")
    set(EXPAT_LIBRARY EXPAT_LIBRARY-NOTFOUND)
endif()
foreach(JE_HEADER IN ITEMS expat.h expat_external.h expat_config.h)
    set(JE_HEADER_PATH "${JE_EXPAT_ROOT}/expat/include/${JE_HEADER}")
    JE_python_require_local_path(JE_HEADER_PATH)
    if(NOT EXISTS "${JE_HEADER_PATH}")
        set(EXPAT_INCLUDE_DIR EXPAT_INCLUDE_DIR-NOTFOUND)
    endif()
endforeach()
if(EXPAT_INCLUDE_DIR)
    file(READ "${EXPAT_INCLUDE_DIR}/expat.h" JE_EXPAT_HEADER)
    if(NOT JE_EXPAT_HEADER MATCHES "#define[ \t]+XML_MAJOR_VERSION[ \t]+2([ \t\r\n]|$)"
        OR NOT JE_EXPAT_HEADER MATCHES "#define[ \t]+XML_MINOR_VERSION[ \t]+4([ \t\r\n]|$)"
        OR NOT JE_EXPAT_HEADER MATCHES "#define[ \t]+XML_MICRO_VERSION[ \t]+2([ \t\r\n]|$)")
        message(FATAL_ERROR "JE local Expat: headers must be exactly 2.4.2")
    endif()
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(expat REQUIRED_VARS EXPAT_LIBRARY EXPAT_INCLUDE_DIR VERSION_VAR expat_VERSION)
set(EXPAT_FOUND "${expat_FOUND}")
set(expat_LIBRARY "${EXPAT_LIBRARY}")
set(EXPAT_LIBRARIES "${EXPAT_LIBRARY}")
set(expat_INCLUDE_DIR "${EXPAT_INCLUDE_DIR}")
set(EXPAT_INCLUDE_DIRS "${EXPAT_INCLUDE_DIR}")
if(NOT expat_FOUND OR TARGET 3rdParty::expat)
    return()
endif()
add_library(expat::expat STATIC IMPORTED GLOBAL)
set_target_properties(expat::expat PROPERTIES IMPORTED_LINK_INTERFACE_LANGUAGES "C"
    IMPORTED_LOCATION "${EXPAT_LIBRARY}")
target_compile_definitions(expat::expat INTERFACE XML_STATIC)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET expat::expat INTERFACE "${EXPAT_INCLUDE_DIR}")
else()
    target_include_directories(expat::expat SYSTEM INTERFACE "${EXPAT_INCLUDE_DIR}")
endif()
add_library(3rdParty::expat ALIAS expat::expat)
add_library(EXPAT::EXPAT ALIAS expat::expat)
message(STATUS "Using JE local Expat 2.4.2 from ${JE_EXPAT_ROOT}")
