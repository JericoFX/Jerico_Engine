# Adapted from O3DE's package-system/lz4/Findlz4.cmake: same imported target and Release layout.

include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_LZ4_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_LZ4_LOCAL_ROOT)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local lz4 package requires Windows x64")
endif()
set(lz4_INCLUDE_DIR "${JE_LZ4_LOCAL_ROOT}/lz4/include")
set(lz4_LIBS_DIR "${JE_LZ4_LOCAL_ROOT}/lz4/lib")
set(lz4_LIBRARY_RELEASE "${lz4_LIBS_DIR}/lz4.lib")
set(lz4_LIBRARY_DEBUG "${lz4_LIBS_DIR}/../debug/lib/lz4d.lib")
set(lz4_VERSION "1.9.4")
JE_python_require_local_path(lz4_INCLUDE_DIR)
JE_python_require_local_path(lz4_LIBS_DIR)
JE_python_require_local_path(lz4_LIBRARY_RELEASE)
foreach(JE_HEADER IN ITEMS lz4.h lz4hc.h lz4frame.h)
    set(JE_HEADER_PATH "${lz4_INCLUDE_DIR}/${JE_HEADER}")
    JE_python_require_local_path(JE_HEADER_PATH)
    if(NOT EXISTS "${lz4_INCLUDE_DIR}/${JE_HEADER}")
        set(lz4_INCLUDE_DIR lz4_INCLUDE_DIR-NOTFOUND)
        break()
    endif()
endforeach()
if(NOT EXISTS "${lz4_LIBRARY_RELEASE}")
    set(lz4_LIBRARY_RELEASE lz4_LIBRARY_RELEASE-NOTFOUND)
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(lz4 REQUIRED_VARS lz4_LIBRARY_RELEASE lz4_INCLUDE_DIR VERSION_VAR lz4_VERSION)
if(NOT lz4_FOUND)
    return()
endif()
file(READ "${lz4_INCLUDE_DIR}/lz4.h" JE_HEADER)
if(NOT JE_HEADER MATCHES "#define[ \t]+LZ4_VERSION_MAJOR[ \t]+1([ \t\r\n]|$)"
    OR NOT JE_HEADER MATCHES "#define[ \t]+LZ4_VERSION_MINOR[ \t]+9([ \t\r\n]|$)"
    OR NOT JE_HEADER MATCHES "#define[ \t]+LZ4_VERSION_RELEASE[ \t]+4([ \t\r\n]|$)")
    message(FATAL_ERROR "JE local lz4 package header is not version 1.9.4")
endif()
set(lz4_INCLUDE_DIRS "${lz4_INCLUDE_DIR}")
set(lz4_LIBRARIES "${lz4_LIBRARY_RELEASE}")
if(TARGET 3rdParty::lz4)
    get_target_property(JE_EXISTING_LIBRARY 3rdParty::lz4 IMPORTED_LOCATION)
    if(NOT "${JE_EXISTING_LIBRARY}" STREQUAL "${lz4_LIBRARY_RELEASE}")
        message(FATAL_ERROR "JE local lz4 refuses to replace an existing provider")
    endif()
    return()
endif()
add_library(3rdParty::lz4 STATIC IMPORTED GLOBAL)
# Historical Windows Find uses this Release archive for all consumer configurations.
set_target_properties(3rdParty::lz4 PROPERTIES IMPORTED_LOCATION "${lz4_LIBRARY_RELEASE}")
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::lz4 INTERFACE "${lz4_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::lz4 SYSTEM INTERFACE "${lz4_INCLUDE_DIR}")
endif()
