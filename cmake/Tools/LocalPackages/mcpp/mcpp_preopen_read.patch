+static int  overlong_candidate_is_missing(
+    const char *    dir,
+    const char *    filename
+)
+/*
+ * PATHMAX is unchanged. A representable missing directory prefix proves
+ * this candidate cannot reach a regular header; otherwise retain the fatal.
+ * Only ordinary absolute DOS paths are probed. Dot traversal, ambiguous
+ * trailing characters, non-ASCII names and other namespaces remain rejected.
+ */
+{
+    char    prefix[ PATHMAX];
+    const char *    p;
+    const char *    component;
+    size_t  dir_len = strlen( dir);
+    size_t  length;
+    int     status;
+    int     saved_errno;
+    int     probe_errno;
+    struct _stat    info;
+
+    if (dir_len < 3 || dir_len >= PATHMAX || dir[ 1] != ':'
+            || (dir[ 2] != '/' && dir[ 2] != '\\')
+            || (dir[ dir_len - 1] != '/' && dir[ dir_len - 1] != '\\')
+            || *filename == '/' || *filename == '\\')
+        return  FALSE;
+    for (p = dir; *p; p++)
+        if ((unsigned char) *p >= 0x80)
+            return  FALSE;
+    for (p = component = filename; ; p++) {
+        if ((unsigned char) *p >= 0x80 || *p == ':')
+            return  FALSE;
+        if (*p == '/' || *p == '\\' || *p == EOS) {
+            length = (size_t) (p - component);
+            if ((length == 1 && component[ 0] == '.')
+                    || (length == 2 && component[ 0] == '.' && component[ 1] == '.')
+                    || (length && (component[ length - 1] == '.'
+                                                    || component[ length - 1] == ' ')))
+                return  FALSE;
+            if (*p == EOS)
+                break;
+            component = p + 1;
+        }
+    }
+    memcpy( prefix, dir, dir_len);
+    for (p = filename; *p; p++) {
+        if (*p != '/' && *p != '\\')
+            continue;
+        length = (size_t) (p - filename);
+        if (length >= PATHMAX - dir_len)
+            return  FALSE;
+        memcpy( prefix + dir_len, filename, length);
+        prefix[ dir_len + length] = EOS;
+        saved_errno = errno;
+        errno = 0;
+        status = stat( prefix, & info);
+        probe_errno = errno;
+        errno = saved_errno;
+        if (status != 0)
+            return  probe_errno == ENOENT;
+    }
+    return  FALSE;
+}
