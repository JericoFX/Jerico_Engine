# Layer two, after the immutable historical _az.2 patch. Reuse its exact decoder.
if(NOT COMMAND JE_mcpp_decode_hunk)
    message(FATAL_ERROR "JE mcpp pre-open extension requires the verified original patch layer")
endif()
JE_python_require_local_path(JE_MCPP_WORK)
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_MCPP_WORK}" NORMALIZE JE_PREOPEN_IN_BUILD)
if(NOT JE_PREOPEN_IN_BUILD OR JE_MCPP_WORK STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE mcpp extension work must stay beneath checkout/build")
endif()
JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/McppPreopenExtensionManifest.json" "0102D042875C0F02D7FB6EF578BE1B5827ADCF5DC5D5E3EF906BB9597E29D886" "pre-open extension manifest")
file(READ "${CMAKE_CURRENT_LIST_DIR}/McppPreopenExtensionManifest.json" JE_PREOPEN_MANIFEST)
string(JSON JE_PREOPEN_PATCH_HASH GET "${JE_PREOPEN_MANIFEST}" patchSHA256)
JE_python_verify_file("${CMAKE_CURRENT_LIST_DIR}/mcpp_preopen_read.patch" "${JE_PREOPEN_PATCH_HASH}" "pre-open extension patch")
file(READ "${CMAKE_CURRENT_LIST_DIR}/mcpp_preopen_read.patch" JE_PREOPEN_PATCH)
string(JSON JE_PREOPEN_COUNT LENGTH "${JE_PREOPEN_MANIFEST}" files)
if(NOT JE_PREOPEN_COUNT EQUAL 5)
    message(FATAL_ERROR "JE mcpp pre-open extension must contain exactly five files")
endif()
foreach(JE_PREOPEN_INDEX RANGE 0 4)
    string(JSON JE_PREOPEN_FILE GET "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} path)
    if(NOT JE_PREOPEN_FILE MATCHES "^src/[A-Za-z0-9_.]+$")
        message(FATAL_ERROR "JE mcpp pre-open extension path rejected")
    endif()
    string(JSON JE_PREOPEN_BEFORE GET "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} beforeSHA256)
    string(JSON JE_PREOPEN_AFTER GET "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} afterSHA256)
    JE_python_verify_file("${JE_MCPP_WORK}/${JE_PREOPEN_FILE}" "${JE_PREOPEN_BEFORE}" "pre-open before ${JE_PREOPEN_FILE}")
    file(READ "${JE_MCPP_WORK}/${JE_PREOPEN_FILE}" JE_PREOPEN_TEXT)
    string(JSON JE_PREOPEN_HUNKS LENGTH "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} hunks)
    math(EXPR JE_PREOPEN_HUNK "${JE_PREOPEN_HUNKS} - 1")
    while(JE_PREOPEN_HUNK GREATER_EQUAL 0)
        foreach(JE_FIELD IN ITEMS sourceOffset oldBytes patchOffset patchBytes)
            string(JSON JE_PREOPEN_${JE_FIELD} GET "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} hunks ${JE_PREOPEN_HUNK} ${JE_FIELD})
        endforeach()
        string(SUBSTRING "${JE_PREOPEN_PATCH}" ${JE_PREOPEN_patchOffset} ${JE_PREOPEN_patchBytes} JE_PREOPEN_BODY)
        JE_mcpp_decode_hunk("${JE_PREOPEN_BODY}" JE_PREOPEN_OLD JE_PREOPEN_NEW)
        string(SUBSTRING "${JE_PREOPEN_TEXT}" ${JE_PREOPEN_sourceOffset} ${JE_PREOPEN_oldBytes} JE_PREOPEN_ACTUAL)
        if(NOT JE_PREOPEN_ACTUAL STREQUAL JE_PREOPEN_OLD)
            message(FATAL_ERROR "JE mcpp pre-open exact context mismatch: ${JE_PREOPEN_FILE}")
        endif()
        string(SUBSTRING "${JE_PREOPEN_TEXT}" 0 ${JE_PREOPEN_sourceOffset} JE_PREOPEN_PREFIX)
        math(EXPR JE_PREOPEN_END "${JE_PREOPEN_sourceOffset} + ${JE_PREOPEN_oldBytes}")
        string(SUBSTRING "${JE_PREOPEN_TEXT}" ${JE_PREOPEN_END} -1 JE_PREOPEN_SUFFIX)
        set(JE_PREOPEN_TEXT "${JE_PREOPEN_PREFIX}${JE_PREOPEN_NEW}${JE_PREOPEN_SUFFIX}")
        math(EXPR JE_PREOPEN_HUNK "${JE_PREOPEN_HUNK} - 1")
    endwhile()
    string(SHA256 JE_PREOPEN_ACTUAL_HASH "${JE_PREOPEN_TEXT}")
    string(TOLOWER "${JE_PREOPEN_AFTER}" JE_PREOPEN_EXPECTED_HASH)
    if(NOT JE_PREOPEN_ACTUAL_HASH STREQUAL JE_PREOPEN_EXPECTED_HASH)
        message(FATAL_ERROR "JE mcpp pre-open postimage mismatch: ${JE_PREOPEN_FILE}")
    endif()
    set(JE_PREOPEN_PATH_${JE_PREOPEN_INDEX} "${JE_MCPP_WORK}/${JE_PREOPEN_FILE}")
    set(JE_PREOPEN_TEXT_${JE_PREOPEN_INDEX} "${JE_PREOPEN_TEXT}")
endforeach()
# Validate all five complete before/context/after pins before the first write.
foreach(JE_PREOPEN_INDEX RANGE 0 4)
    file(CONFIGURE OUTPUT "${JE_PREOPEN_PATH_${JE_PREOPEN_INDEX}}" CONTENT "${JE_PREOPEN_TEXT_${JE_PREOPEN_INDEX}}" @ONLY NEWLINE_STYLE UNIX)
    string(JSON JE_PREOPEN_AFTER GET "${JE_PREOPEN_MANIFEST}" files ${JE_PREOPEN_INDEX} afterSHA256)
    JE_python_verify_file("${JE_PREOPEN_PATH_${JE_PREOPEN_INDEX}}" "${JE_PREOPEN_AFTER}" "pre-open final")
endforeach()
