# Apply the original _az.2 unified-diff bodies at their exact source offsets.
# Manifest offsets/hashes were audited against the upstream archive and both
# Git blob prefixes in the original patch. No Git, patch tool or fuzzy matching.
JE_python_require_local_path(JE_MCPP_WORK)
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_MCPP_WORK}" NORMALIZE JE_PATCH_IN_BUILD)
if(NOT JE_PATCH_IN_BUILD OR JE_MCPP_WORK STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE local mcpp: patch work must be beneath this checkout/build")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/mcpp_2.7.2_az.patch" JE_PATCH)
file(READ "${CMAKE_CURRENT_LIST_DIR}/McppPatchManifest.json" JE_MANIFEST)

function(JE_mcpp_decode_hunk JE_BODY JE_OLD_OUTPUT JE_NEW_OUTPUT)
    set(JE_OLD "")
    set(JE_NEW "")
    while(NOT JE_BODY STREQUAL "")
        string(FIND "${JE_BODY}" "\n" JE_END)
        if(JE_END LESS 1)
            message(FATAL_ERROR "JE local mcpp: invalid original patch line")
        endif()
        string(SUBSTRING "${JE_BODY}" 0 1 JE_KIND)
        math(EXPR JE_TEXT_LENGTH "${JE_END} - 1")
        string(SUBSTRING "${JE_BODY}" 1 ${JE_TEXT_LENGTH} JE_TEXT)
        if(JE_KIND STREQUAL " " OR JE_KIND STREQUAL "-")
            string(APPEND JE_OLD "${JE_TEXT}\n")
        endif()
        if(JE_KIND STREQUAL " " OR JE_KIND STREQUAL "+")
            string(APPEND JE_NEW "${JE_TEXT}\n")
        endif()
        if(NOT JE_KIND STREQUAL " " AND NOT JE_KIND STREQUAL "-" AND NOT JE_KIND STREQUAL "+")
            message(FATAL_ERROR "JE local mcpp: unsupported original patch line")
        endif()
        math(EXPR JE_NEXT "${JE_END} + 1")
        string(SUBSTRING "${JE_BODY}" ${JE_NEXT} -1 JE_BODY)
    endwhile()
    set(${JE_OLD_OUTPUT} "${JE_OLD}" PARENT_SCOPE)
    set(${JE_NEW_OUTPUT} "${JE_NEW}" PARENT_SCOPE)
endfunction()

string(JSON JE_FILE_COUNT LENGTH "${JE_MANIFEST}" files)
math(EXPR JE_LAST_FILE "${JE_FILE_COUNT} - 1")
foreach(JE_INDEX RANGE ${JE_LAST_FILE})
    string(JSON JE_PATH GET "${JE_MANIFEST}" files ${JE_INDEX} path)
    string(JSON JE_ORIGINAL_HASH GET "${JE_MANIFEST}" files ${JE_INDEX} originalSHA256)
    string(JSON JE_PATCHED_HASH GET "${JE_MANIFEST}" files ${JE_INDEX} patchedSHA256)
    if(NOT JE_PATH MATCHES "^src/[A-Za-z0-9_.]+$")
        message(FATAL_ERROR "JE local mcpp: invalid pinned patch path")
    endif()
    set(JE_SOURCE "${JE_MCPP_WORK}/${JE_PATH}")
    JE_python_verify_file("${JE_SOURCE}" "${JE_ORIGINAL_HASH}" "unpatched ${JE_PATH}")
    file(READ "${JE_SOURCE}" JE_TEXT)
    string(JSON JE_HUNK_COUNT LENGTH "${JE_MANIFEST}" files ${JE_INDEX} hunks)
    math(EXPR JE_HUNK "${JE_HUNK_COUNT} - 1")
    # Reverse order preserves offsets into the original source bytes.
    while(JE_HUNK GREATER_EQUAL 0)
        foreach(JE_FIELD IN ITEMS sourceOffset oldBytes patchOffset patchBytes)
            string(JSON JE_${JE_FIELD} GET "${JE_MANIFEST}" files ${JE_INDEX} hunks ${JE_HUNK} ${JE_FIELD})
        endforeach()
        string(SUBSTRING "${JE_PATCH}" ${JE_patchOffset} ${JE_patchBytes} JE_BODY)
        JE_mcpp_decode_hunk("${JE_BODY}" JE_OLD JE_NEW)
        string(SUBSTRING "${JE_TEXT}" ${JE_sourceOffset} ${JE_oldBytes} JE_ACTUAL)
        if(NOT JE_ACTUAL STREQUAL JE_OLD)
            message(FATAL_ERROR "JE local mcpp: exact patch context mismatch: ${JE_PATH}/${JE_HUNK}")
        endif()
        string(SUBSTRING "${JE_TEXT}" 0 ${JE_sourceOffset} JE_PREFIX)
        math(EXPR JE_AFTER "${JE_sourceOffset} + ${JE_oldBytes}")
        string(SUBSTRING "${JE_TEXT}" ${JE_AFTER} -1 JE_SUFFIX)
        set(JE_TEXT "${JE_PREFIX}${JE_NEW}${JE_SUFFIX}")
        math(EXPR JE_HUNK "${JE_HUNK} - 1")
    endwhile()
    string(SHA256 JE_ACTUAL_HASH "${JE_TEXT}")
    if(NOT JE_ACTUAL_HASH STREQUAL JE_PATCHED_HASH)
        message(FATAL_ERROR "JE local mcpp: patched source SHA256 mismatch: ${JE_PATH}")
    endif()
    set(JE_PATCHED_PATH_${JE_INDEX} "${JE_SOURCE}")
    set(JE_PATCHED_TEXT_${JE_INDEX} "${JE_TEXT}")
endforeach()
# All source contexts and complete hashes must match before any work file changes.
foreach(JE_INDEX RANGE ${JE_LAST_FILE})
    # Windows file(WRITE) translates LF to CRLF; retain the audited patch bytes.
    file(CONFIGURE OUTPUT "${JE_PATCHED_PATH_${JE_INDEX}}"
        CONTENT "${JE_PATCHED_TEXT_${JE_INDEX}}" @ONLY NEWLINE_STYLE UNIX)
    string(JSON JE_EXPECTED_HASH GET "${JE_MANIFEST}" files ${JE_INDEX} patchedSHA256)
    JE_python_verify_file("${JE_PATCHED_PATH_${JE_INDEX}}" "${JE_EXPECTED_HASH}" "written patched source")
endforeach()
