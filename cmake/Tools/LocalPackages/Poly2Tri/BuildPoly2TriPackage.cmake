cmake_minimum_required(VERSION 3.24)
include("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake")
foreach(JE_ARGUMENT IN ITEMS SOURCE_ARCHIVE SOURCE_MANIFEST VS_INSTANCE OUTPUT)
    JE_python_require_local_path(JE_POLY2TRI_${JE_ARGUMENT})
endforeach()
get_filename_component(JE_ENGINE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../../.." ABSOLUTE)
set(JE_BUILD_ROOT "${JE_ENGINE_ROOT}/build")
cmake_path(IS_PREFIX JE_BUILD_ROOT "${JE_POLY2TRI_OUTPUT}" NORMALIZE JE_OUTPUT_IN_BUILD)
if(NOT JE_OUTPUT_IN_BUILD OR JE_POLY2TRI_OUTPUT STREQUAL JE_BUILD_ROOT)
    message(FATAL_ERROR "JE local poly2tri: output must be beneath this checkout/build")
endif()
if(EXISTS "${JE_POLY2TRI_OUTPUT}")
    message(FATAL_ERROR "JE local poly2tri: output must be new; existing outputs are preserved")
endif()
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
    message(FATAL_ERROR "JE local poly2tri requires Windows x64")
endif()
if(NOT EXISTS "${JE_POLY2TRI_VS_INSTANCE}/MSBuild/Current/Bin/MSBuild.exe")
    message(FATAL_ERROR "JE local poly2tri: explicit Visual Studio instance is missing")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/Recipe.json" JE_RECIPE)
string(JSON JE_SOURCE_COMMIT GET "${JE_RECIPE}" sourceCommit)
string(JSON JE_SOURCE_HASH GET "${JE_RECIPE}" sourceArchiveSHA256)
string(JSON JE_SOURCE_URL GET "${JE_RECIPE}" sourceArchiveURL)
string(JSON JE_MANIFEST_HASH GET "${JE_RECIPE}" sourceManifestSHA256)
JE_python_verify_file("${JE_POLY2TRI_SOURCE_ARCHIVE}" "${JE_SOURCE_HASH}" "poly2tri source archive")
JE_python_verify_file("${JE_POLY2TRI_SOURCE_MANIFEST}" "${JE_MANIFEST_HASH}" "poly2tri source manifest")
file(READ "${JE_POLY2TRI_SOURCE_MANIFEST}" JE_MANIFEST)
string(JSON JE_ROOT GET "${JE_MANIFEST}" root)
string(JSON JE_PIN GET "${JE_MANIFEST}" sourceCommit)
string(JSON JE_ARCHIVE_HASH GET "${JE_MANIFEST}" archiveSHA256)
string(JSON JE_COUNT LENGTH "${JE_MANIFEST}" entries)
JE_python_require_local_path(JE_ROOT)
if(NOT JE_PIN STREQUAL JE_SOURCE_COMMIT OR NOT JE_ARCHIVE_HASH STREQUAL JE_SOURCE_HASH OR NOT JE_COUNT EQUAL 50)
    message(FATAL_ERROR "JE local poly2tri: source manifest does not describe the exact audited pin")
endif()
file(GLOB_RECURSE JE_SOURCE_MEMBERS LIST_DIRECTORIES FALSE RELATIVE "${JE_ROOT}" "${JE_ROOT}/*")
list(LENGTH JE_SOURCE_MEMBERS JE_ACTUAL_COUNT)
if(NOT JE_ACTUAL_COUNT EQUAL JE_COUNT)
    message(FATAL_ERROR "JE local poly2tri: source snapshot membership differs")
endif()
math(EXPR JE_LAST "${JE_COUNT} - 1")
foreach(JE_INDEX RANGE 0 ${JE_LAST})
    string(JSON JE_RELATIVE GET "${JE_MANIFEST}" entries ${JE_INDEX} path)
    string(JSON JE_HASH GET "${JE_MANIFEST}" entries ${JE_INDEX} sha256)
    string(JSON JE_BYTES GET "${JE_MANIFEST}" entries ${JE_INDEX} bytes)
    if(JE_RELATIVE MATCHES "(^/|\\\\|:|(^|/)\\.\\.?(/|$)|//)" OR NOT JE_RELATIVE IN_LIST JE_SOURCE_MEMBERS)
        message(FATAL_ERROR "JE local poly2tri: unsafe or missing source manifest member")
    endif()
    JE_python_verify_file("${JE_ROOT}/${JE_RELATIVE}" "${JE_HASH}" "poly2tri source member")
    file(SIZE "${JE_ROOT}/${JE_RELATIVE}" JE_ACTUAL_BYTES)
    if(NOT JE_ACTUAL_BYTES EQUAL JE_BYTES)
        message(FATAL_ERROR "JE local poly2tri: source member size differs")
    endif()
endforeach()
# All source/archive/path checks finish before creating the private output.
set(JE_WORK "${JE_POLY2TRI_OUTPUT}/source-work")
set(JE_BUILD "${JE_POLY2TRI_OUTPUT}/build")
set(JE_STAGE "${JE_POLY2TRI_OUTPUT}/stage")
foreach(JE_INDEX RANGE 0 ${JE_LAST})
    string(JSON JE_RELATIVE GET "${JE_MANIFEST}" entries ${JE_INDEX} path)
    configure_file("${JE_ROOT}/${JE_RELATIVE}" "${JE_WORK}/${JE_RELATIVE}" COPYONLY)
endforeach()
file(MAKE_DIRECTORY "${JE_POLY2TRI_OUTPUT}/logs")
function(JE_poly2tri_native JE_PHASE)
    string(TIMESTAMP JE_START "%Y-%m-%dT%H:%M:%SZ" UTC)
    execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN}
        RESULT_VARIABLE JE_RESULT
        OUTPUT_FILE "${JE_POLY2TRI_OUTPUT}/logs/${JE_PHASE}.stdout.raw.log"
        ERROR_FILE "${JE_POLY2TRI_OUTPUT}/logs/${JE_PHASE}.stderr.raw.log")
    string(TIMESTAMP JE_END "%Y-%m-%dT%H:%M:%SZ" UTC)
    file(WRITE "${JE_POLY2TRI_OUTPUT}/logs/${JE_PHASE}.result.txt"
        "UTC start=${JE_START}\nUTC end=${JE_END}\nexit=${JE_RESULT}\nCMake=${CMAKE_COMMAND}\nargv=${ARGN}\nChild PID unavailable to execute_process\n")
    if(NOT JE_RESULT STREQUAL "0")
        message(FATAL_ERROR "JE local poly2tri ${JE_PHASE} failed (${JE_RESULT}); raw outputs retained")
    endif()
endfunction()
JE_poly2tri_native(configure -S "${CMAKE_CURRENT_LIST_DIR}" -B "${JE_BUILD}"
    -G "Visual Studio 17 2022" -A x64 -T v143
    "-DCMAKE_GENERATOR_INSTANCE:PATH=${JE_POLY2TRI_VS_INSTANCE}"
    "-DJE_POLY2TRI_WORK:PATH=${JE_WORK}"
    -DFETCHCONTENT_FULLY_DISCONNECTED:BOOL=ON
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY:BOOL=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY:BOOL=OFF)
foreach(JE_CONFIG IN ITEMS Debug Release)
    JE_poly2tri_native("build-${JE_CONFIG}" --build "${JE_BUILD}" --config "${JE_CONFIG}" --parallel 6 --target JEPoly2Tri)
    set(JE_LIBRARY "${JE_BUILD}/lib/${JE_CONFIG}/poly2tri.lib")
    if(NOT EXISTS "${JE_LIBRARY}")
        message(FATAL_ERROR "JE local poly2tri: ${JE_CONFIG} static archive is missing")
    endif()
    file(SIZE "${JE_LIBRARY}" JE_LIBRARY_BYTES)
    if(JE_LIBRARY_BYTES EQUAL 0)
        message(FATAL_ERROR "JE local poly2tri: ${JE_CONFIG} static archive is empty")
    endif()
endforeach()
set(JE_PAYLOAD "${JE_STAGE}/poly2tri/poly2tri")
file(MAKE_DIRECTORY "${JE_PAYLOAD}/lib" "${JE_PAYLOAD}/debug/lib")
configure_file("${JE_BUILD}/lib/Release/poly2tri.lib" "${JE_PAYLOAD}/lib/poly2tri.lib" COPYONLY)
configure_file("${JE_BUILD}/lib/Debug/poly2tri.lib" "${JE_PAYLOAD}/debug/lib/poly2tri.lib" COPYONLY)
foreach(JE_HEADER IN ITEMS poly2tri.h common/shapes.h common/utils.h sweep/advancing_front.h sweep/cdt.h sweep/sweep.h sweep/sweep_context.h)
    configure_file("${JE_WORK}/poly2tri/${JE_HEADER}" "${JE_PAYLOAD}/include/poly2tri/${JE_HEADER}" COPYONLY)
endforeach()
configure_file("${JE_ROOT}/LICENSE" "${JE_STAGE}/poly2tri/LICENSE" COPYONLY)
configure_file("${JE_ROOT}/README.md" "${JE_STAGE}/poly2tri/README.md" COPYONLY)
# Preserve notices in each compiled source and the original port's source recipe.
foreach(JE_CC IN ITEMS common/shapes.cc sweep/advancing_front.cc sweep/cdt.cc sweep/sweep.cc sweep/sweep_context.cc)
    configure_file("${JE_ROOT}/poly2tri/${JE_CC}" "${JE_STAGE}/LICENSES/Poly2Tri/compiled-source/${JE_CC}" COPYONLY)
endforeach()
configure_file("${JE_ROOT}/CMakeLists.txt" "${JE_STAGE}/LICENSES/Poly2Tri/upstream-CMakeLists.txt" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/Findpoly2tri.cmake" "${JE_STAGE}/Findpoly2tri.cmake" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/../Python/JERequireLocalPath.cmake" "${JE_STAGE}/JERequireLocalPath.cmake" COPYONLY)
file(COPY "${CMAKE_CURRENT_LIST_DIR}/NOTICE.txt" "${CMAKE_CURRENT_LIST_DIR}/Recipe.json" "${CMAKE_CURRENT_LIST_DIR}/README.md" DESTINATION "${JE_STAGE}")
file(COPY "${JE_ENGINE_ROOT}/LICENSE.txt" "${JE_ENGINE_ROOT}/LICENSE_APACHE2.TXT" "${JE_ENGINE_ROOT}/LICENSE_MIT.TXT" DESTINATION "${JE_STAGE}/LICENSES/O3DE")
set(JE_PACKAGE_STAGE "${JE_STAGE}")
set(JE_PACKAGE_NAME "poly2tri-7f0487a-je-rev1-windows")
set(JE_PACKAGE_OUTPUT "${JE_POLY2TRI_OUTPUT}/packages")
set(JE_PACKAGE_VERSION "2021-05-18")
set(JE_PACKAGE_SOURCE_COMMIT "${JE_SOURCE_COMMIT}")
set(JE_PACKAGE_LICENSE "BSD-3-Clause")
set(JE_PACKAGE_SOURCE_SHA256 "${JE_SOURCE_HASH}")
set(JE_PACKAGE_SOURCE_URL "${JE_SOURCE_URL}")
include("${CMAKE_CURRENT_LIST_DIR}/../JECreateLocalPackage.cmake")
