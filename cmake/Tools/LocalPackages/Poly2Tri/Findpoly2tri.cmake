# Adapted from O3DE 3p-package-source@70f0b7b5/package-system/poly2tri.
include("${CMAKE_CURRENT_LIST_DIR}/JERequireLocalPath.cmake")
set(JE_POLY2TRI_LOCAL_ROOT "${CMAKE_CURRENT_LIST_DIR}")
JE_python_require_local_path(JE_POLY2TRI_LOCAL_ROOT)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "Windows" OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "JE local poly2tri package requires Windows x64")
endif()
set(poly2tri_INCLUDE_DIR "${JE_POLY2TRI_LOCAL_ROOT}/poly2tri/poly2tri/include/poly2tri")
set(poly2tri_LIBS_DIR "${JE_POLY2TRI_LOCAL_ROOT}/poly2tri/poly2tri/lib")
set(poly2tri_LIBRARY_RELEASE "${poly2tri_LIBS_DIR}/poly2tri.lib")
set(poly2tri_LIBRARY_DEBUG "${poly2tri_LIBS_DIR}/../debug/lib/poly2tri.lib")
foreach(JE_PATH IN ITEMS poly2tri_INCLUDE_DIR poly2tri_LIBRARY_RELEASE poly2tri_LIBRARY_DEBUG)
    JE_python_require_local_path(${JE_PATH})
    if(NOT EXISTS "${${JE_PATH}}")
        message(FATAL_ERROR "JE local poly2tri: package member is missing: ${${JE_PATH}}")
    endif()
endforeach()
foreach(JE_HEADER IN ITEMS poly2tri.h common/shapes.h common/utils.h sweep/advancing_front.h sweep/cdt.h sweep/sweep.h sweep/sweep_context.h)
    set(JE_HEADER_PATH "${poly2tri_INCLUDE_DIR}/${JE_HEADER}")
    JE_python_require_local_path(JE_HEADER_PATH)
    if(NOT EXISTS "${JE_HEADER_PATH}")
        message(FATAL_ERROR "JE local poly2tri: package header is missing: ${JE_HEADER}")
    endif()
endforeach()
set(poly2tri_LIBRARY
    "$<$<CONFIG:profile>:${poly2tri_LIBRARY_RELEASE}>"
    "$<$<CONFIG:release>:${poly2tri_LIBRARY_RELEASE}>"
    "$<$<CONFIG:debug>:${poly2tri_LIBRARY_DEBUG}>")
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(poly2tri REQUIRED_VARS poly2tri_INCLUDE_DIR poly2tri_LIBRARY_RELEASE poly2tri_LIBRARY_DEBUG)
if(TARGET 3rdParty::poly2tri)
    get_target_property(JE_EXISTING_LIBRARIES 3rdParty::poly2tri INTERFACE_LINK_LIBRARIES)
    if(NOT "${JE_EXISTING_LIBRARIES}" STREQUAL "${poly2tri_LIBRARY}")
        message(FATAL_ERROR "JE local poly2tri refuses to replace an existing provider")
    endif()
    return()
endif()
add_library(3rdParty::poly2tri INTERFACE IMPORTED GLOBAL)
if(COMMAND ly_target_include_system_directories)
    ly_target_include_system_directories(TARGET 3rdParty::poly2tri INTERFACE "${poly2tri_INCLUDE_DIR}")
else()
    target_include_directories(3rdParty::poly2tri SYSTEM INTERFACE "${poly2tri_INCLUDE_DIR}")
endif()
target_link_libraries(3rdParty::poly2tri INTERFACE ${poly2tri_LIBRARY})
